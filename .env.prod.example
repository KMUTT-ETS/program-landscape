# Program Landscape — production environment template.
#
# Copy this file to /opt/program-landscape/.env.prod on the prod server,
# fill in the real values, chmod 600, chown root:root. NEVER commit the
# populated .env.prod — .gitignore already blocks it.
#
# The deploy script reads /opt/program-landscape/.env.prod and loads it
# into every app container via docker-compose's `env_file`. Secrets for
# Postgres + MinIO live in /opt/program-landscape/secrets/ (one secret
# per file) because docker-compose's `secrets:` reads from files.

# ─── Environment ────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ─── Public URLs (used by NextAuth redirects, link generation) ──────
NEXTAUTH_URL=https://program-landscape.kku.ac.th
AUTH_TRUST_HOST=true
APP_PUBLIC_URL=https://program-landscape.kku.ac.th
API_PUBLIC_URL=https://program-landscape.kku.ac.th/api
# Internal URL the web SSR uses to reach the api over the docker network.
# Without this, apiFetch defaults to http://localhost:4000 (wrong inside the
# web container) and every server-side api call silently fails. Verified 2026-05-10.
API_URL=http://api:4000
# Used by next.config.mjs CSP's connect-src — the browser talks to
# same-origin so this is usually the public URL (or empty).
PUBLIC_API_ORIGIN=https://program-landscape.kku.ac.th
# APP_PUBLIC_URL also backstops absolute links shown/shared to users
# (e.g. the /profile public-share URL + its QR code) — without it those
# pages fall back to reconstructing the origin from the request's
# X-Forwarded-Proto header, which only works if every hop between the
# browser and this container forwards it correctly.

# ─── Auth: NextAuth + KKU SSO ───────────────────────────────────────
# Generate with: openssl rand -hex 64
NEXTAUTH_SECRET=REPLACE_ME_64_HEX_CHARS
# Local credentials MUST be disabled in prod (assertLocalAuthSafe guards).
ENABLE_LOCAL_AUTH=false

# KKU SSO is SSONext (custom protocol — NOT standard OIDC).
# See docs/auth/kku-sso.md for the wire shape + claim mapping.
# Production WEB + API hosts differ from UAT-Stage — KKU IT will issue
# them. Likely shape: https://sso.kku.ac.th + https://api-sso.kku.ac.th.
KKU_SSO_WEB_BASE=https://sso.kku.ac.th             # production WEB host (login + logout) — confirm with KKU IT
KKU_SSO_API_BASE=https://api-sso.kku.ac.th         # production API host (token + profile) — confirm with KKU IT
# AppID + Client ID may share the same value at KKU's discretion;
# keep them as separate vars in case KKU issues distinct values per env.
KKU_SSO_APP_ID=REPLACE_ME_PROD_APP_ID
KKU_SSO_CLIENT_ID=REPLACE_ME_PROD_CLIENT_ID
KKU_SSO_CLIENT_SECRET=REPLACE_ME_PROD_CLIENT_SECRET
KKU_SSO_REDIRECT_URI=https://program-landscape.kku.ac.th/api/auth/callback/kku-sso
KKU_SSO_LOGOUT_REDIRECT_URI=https://program-landscape.kku.ac.th/signin?signout=1

# ─── Database ───────────────────────────────────────────────────────
# Credentials live in /opt/program-landscape/secrets/postgres_user
# + postgres_password (mounted via `secrets:` in docker-compose.prod.yml).
# DATABASE_URL points the apps at the postgres container on the bridge
# network. The user + password below are interpolated by the app from
# the secret files — but docker-compose's env_file doesn't expand ${},
# so we hardcode the URL here with the expectation that the secrets
# in /run/secrets/ match. The cleaner path: a startup entrypoint that
# reads the secrets and sets DATABASE_URL. For v1 we rely on fixed
# values below.
POSTGRES_USER=kku_prod
POSTGRES_PASSWORD=REPLACE_ME_in_secrets_file
POSTGRES_DB=program_landscape
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Connection pool sizing (Prisma reads `connection_limit` from the URL):
#   postgres max_connections = 100 (postgis image default)
#     api          : 10
#     ingestion    :  8 (BullMQ workers in flight)
#     web          :  5 (Next server actions)
#     migrations + ad-hoc psql (reserved): 5
#     headroom: ≥70
# Total ~28 — well within ceiling. Bump per-service cautiously and
# coordinate with `max_connections`. See docs/hardening/12-db.report.md.
DATABASE_URL=postgresql://kku_prod:REPLACE_ME_in_secrets_file@postgres:5432/program_landscape?schema=public&connection_limit=10

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ─── MinIO (object storage) ─────────────────────────────────────────
# Credentials in /opt/program-landscape/secrets/minio_user + minio_password.
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=REPLACE_ME_in_secrets_file
MINIO_SECRET_KEY=REPLACE_ME_in_secrets_file
MINIO_BUCKET_PDF_RAW=pdf-raw
MINIO_BUCKET_PDF_OUTPUT=pdf-output
MINIO_BUCKET_BACKUPS=db-backups
# Profile-page avatar uploads (auto-created by app on first upload).
MINIO_BUCKET_AVATARS=avatars
# External URL the browser uses for signed download URLs. Leave empty
# if only internal consumers fetch PDFs; set if the browser downloads
# directly (we route through the api today, so empty is fine).
MINIO_PUBLIC_ENDPOINT=

# ─── Gotenberg (PDF generation) ─────────────────────────────────────
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_PORT=3000
GOTENBERG_REQUEST_TIMEOUT_MS=60000
GOTENBERG_MAX_CONCURRENCY=3

# ─── markitdown (document → Markdown for trend-document ingest) ──────
MARKITDOWN_URL=http://markitdown:8000
MARKITDOWN_REQUEST_TIMEOUT_MS=60000

# ─── PDF governance ─────────────────────────────────────────────────
PDF_SIGNED_URL_TTL_SECONDS=900
PDF_GENERATE_LIMIT_PER_HOUR=120

# ─── AI providers ───────────────────────────────────────────────────
# Primary. google or anthropic are supported; openrouter/intelsphere
# are stubs.
AI_PROVIDER=google

# Configure BOTH so the transient-error fallback works
# (prompt-13 model fallback: primary → secondary on 429/5xx/timeout).
GOOGLE_AI_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=REPLACE_ME

# Model overrides — optional. The code default is gemini-3.5-flash for
# every Gemini call; leave these at the default unless pinning a model.
# NOTE: requires @google/genai 2.x. The embedding model must be one the
# v1beta API exposes — text-embedding-004 was retired (404s on embedContent),
# so use gemini-embedding-001 (or leave unset to take the code default).
AI_GOOGLE_COMPLETION_MODEL=gemini-3.5-flash
AI_GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
AI_CURRICULUM_MODEL=gemini-3.5-flash

# KKU internal AI gateway (stubbed today — prompt 14 wires the real one).
# KKU_INTELSPHERE_URL=
# KKU_INTELSPHERE_API_KEY=

# ─── AI governance ──────────────────────────────────────────────────
AI_AUTO_APPROVE_THRESHOLD=0.85
AI_QUOTA_DEFAULT_USD=1
AI_QUOTA_EXECUTIVE_USD=3
AI_QUOTA_ANALYST_USD=10
AI_QUOTA_ADMIN_USD=10

# ─── Ingestion + pdf-intake workers ─────────────────────────────────
PDF_INTAKE_CONCURRENCY=2
PDF_INTAKE_MAX_ATTEMPTS=2
PDF_INTAKE_BACKOFF_BASE_MS=10000
PDF_INTAKE_CLASSIFIER_THRESHOLD=0.7
PDF_INTAKE_EXTRACTOR_THRESHOLD=0.8
AI_JOBS_CONCURRENCY=2
AI_JOBS_MAX_ATTEMPTS=2
AI_JOBS_BACKOFF_BASE_MS=15000

# ─── Observability ──────────────────────────────────────────────────
CACHE_KEY_PREFIX=kku:cache:

# ─── Profile-page external APIs (profile-page only — NOT bulk) ──────
# /profile reads Scopus + OpenAlex live for a single user at a time.
# Bulk modules (cockpit, gap, benchmarking) read from kkuscholar to
# stay under Scopus's 20k-req/week institutional limit. See
# docs/profile-page.md.
KKU_SCOPUS_API_KEY=REPLACE_ME            # Elsevier institutional key (KKU Library)
OPENALEX_MAILTO=REPLACE_ME               # a contact address enables the OpenAlex polite pool (10 req/s vs 1)

# ─── Connector mode flags ───────────────────────────────────────────
# Global default. Per-source override via CONNECTOR_<SLUG>_MODE=<real|mocked>.
# The env-key transformation is: slug → uppercased, non-alphanumeric → '_',
# prefixed CONNECTOR_, suffixed _MODE. So 'kku-tcas-funnel' becomes
# CONNECTOR_KKU_TCAS_FUNNEL_MODE (NOT CONNECTOR_TCAS_MODE — that's a
# separate slug for the mytcas.com public-data connector).
# Connectors flipped to real: kku-registry, kku-hr, kku-finance,
# kku-research, kmitl-skill-mapping, tcas (mytcas.com), kku-tcas-funnel
# (KKU internal POWERBI.ADMISSION_STAT_CURRID). The rest stay mocked
# until they clear the 30-day green-history gate (docs/readiness-checklist.md).
CONNECTOR_MODE=mocked
CONNECTOR_KKU_REGISTRY_MODE=real
CONNECTOR_KKU_HR_MODE=real
CONNECTOR_KKU_FINANCE_MODE=real
CONNECTOR_KKU_RESEARCH_MODE=real
CONNECTOR_KMITL_SKILL_MAPPING_MODE=real
CONNECTOR_TCAS_MODE=real
CONNECTOR_KKU_TCAS_FUNNEL_MODE=real
# External-signal connectors (Trends Radar) — live since 2026-06.
CONNECTOR_WORLD_BANK_MODE=real
CONNECTOR_MHESI_POLICY_MODE=real
CONNECTOR_NESDC_REPORTS_MODE=real
CONNECTOR_NXPO_REPORTS_MODE=real
CONNECTOR_BOI_SECTORAL_MODE=real
CONNECTOR_EECO_REPORTS_MODE=real
CONNECTOR_WEF_FUTURE_OF_JOBS_MODE=real
CONNECTOR_OECD_REPORTS_MODE=real
CONNECTOR_ADB_GMS_MODE=real

# ─── KKU internal data sources (read-only credentials) ──────────────
# Oracle warehouse — kku-registry + kku-finance tuition aggregate.
KKU_REGISTRY_DB_HOST=REPLACE_ME
KKU_REGISTRY_DB_PORT=1521
KKU_REGISTRY_DB_SERVICE=REPLACE_ME
KKU_REGISTRY_DB_USER=REPLACE_ME
KKU_REGISTRY_DB_PASSWORD=REPLACE_ME

# MS SQL — KKU HCM (HR) + ERPPowerBI (kku-finance budget).
KKU_HR_DB_HOST=REPLACE_ME
KKU_HR_DB_PORT=1433
KKU_HR_DB_USER=REPLACE_ME
KKU_HR_DB_PASSWORD=REPLACE_ME
KKU_HR_DB_DATABASE=REPLACE_ME
# encrypt=false because the on-network MSSQL isn't TLS-configured.
KKU_HR_DB_ENCRYPT=false

# Postgres — kkuscholar institutional research mirror.
KKU_PUBLICATIONS_DB_HOST=REPLACE_ME
KKU_PUBLICATIONS_DB_PORT=5432
KKU_PUBLICATIONS_DB_USER=REPLACE_ME
KKU_PUBLICATIONS_DB_PASSWORD=REPLACE_ME
KKU_PUBLICATIONS_DB_DATABASE=REPLACE_ME
# Year-window cutoff — controls both the connector and the
# FacultyMember backfill recency filter.
KKU_RESEARCH_YEAR_FROM=2015

# UNICON DS2001 / DS2003 / DS2004 (staff datasets — MySQL).
UNICON_DS2001_DB_HOST=REPLACE_ME
UNICON_DS2001_DB_PORT=3306
UNICON_DS2001_DB_USER=REPLACE_ME
UNICON_DS2001_DB_PASSWORD=REPLACE_ME
UNICON_DS2001_DB_DATABASE=REPLACE_ME

UNICON_DS2003_DB_HOST=REPLACE_ME
UNICON_DS2003_DB_PORT=3306
UNICON_DS2003_DB_USER=REPLACE_ME
UNICON_DS2003_DB_PASSWORD=REPLACE_ME
UNICON_DS2003_DB_DATABASE=REPLACE_ME

UNICON_DS2004_DB_HOST=REPLACE_ME
UNICON_DS2004_DB_PORT=3306
UNICON_DS2004_DB_USER=REPLACE_ME
UNICON_DS2004_DB_PASSWORD=REPLACE_ME
UNICON_DS2004_DB_DATABASE=REPLACE_ME

# ─── External partner APIs ──────────────────────────────────────────
# KMITL Skill Mapping — institutional partner; data is LinkedIn (subscribed
# by MHESI), KMITL only hosts the API. NEVER label as "KMITL data" in
# user-exposed surfaces.
KMITL_BASE_URL=https://skill.kmitl.ac.th/api/v1
KMITL_CLIENT_ID=REPLACE_ME
KMITL_SECRET_KEY=REPLACE_ME

# ─── Release marker — overwritten by deploy.sh ──────────────────────
# RELEASE_VERSION is injected via `export` in deploy.sh, not env_file.
# Left here as a breadcrumb.
#
# Do NOT set it here. Compose passes the host value through to the web
# container (see the `environment:` block on the web service), which is what
# renders the version in the sidebar footer. Setting it in this file would
# let the label drift away from the image tag it is supposed to describe.
# RELEASE_VERSION=0.0.0

# ─── KKU Employee API (admin user pre-provision lookup) ───
# Used by /admin/users to look up KKU employees before pre-provisioning.
# Credentials issued by KKU IT (api.kku.ac.th/docs/v3).
KKU_API_BASE_URL=https://api.kku.ac.th
KKU_API_CLIENT_ID=REPLACE_ME
KKU_API_CLIENT_SECRET=REPLACE_ME
KKU_API_TOKEN_PATH=/v3/auth/token
KKU_API_EMPLOYEE_PATH=/v3/hr/employee/filter/email

# ─── Additions for v1.1.0 (2026-05-12) ──────────────────────────────

# CORS allowlist — comma-separated origins permitted to call the NestJS
# API directly (browsers normally proxy through Next, but the analyst
# tool-use streaming endpoint hits the API origin from the client).
ALLOWED_ORIGINS=https://program-landscape.kku.ac.th

# Build version stamp — set by build-release.ts at bundle time and read
# by the /api/v1/ready probe + the /changelog page. Leave commented;
# deploy.sh exports this from VERSION at deploy time.
# APP_BUILD_VERSION=1.1.0

# Sign-in lockout — per-account brute-force cap on the local-credentials
# flow (dev only) AND the SSO callback's "wrong-account" path.
SIGNIN_LOCKOUT_THRESHOLD=5
SIGNIN_LOCKOUT_WINDOW_MIN=15
SIGNIN_LOCKOUT_COOLDOWN_MIN=30

# AI provider circuit breaker — opens after N consecutive failures
# per provider; closes after the cooldown window. Fail-open posture
# kicks in when the breaker is open AND no secondary provider is
# configured.
AI_BREAKER_THRESHOLD=5
AI_BREAKER_COOLDOWN_MS=30000

# Anthropic model override (paired with AI_GOOGLE_COMPLETION_MODEL).
# Configure BOTH so transient-error fallback (prompt 13) works.
AI_ANTHROPIC_COMPLETION_MODEL=claude-opus-4-7

# OpenRouter — set ONLY when AI_PROVIDER=openrouter. Stub today; the
# Anthropic + Google providers are the real-prod path for v1.1.0.
# OPENROUTER_API_KEY=

# Google Custom Search Engine — backs the Phase-5 External AI Search
# WEB_SEARCH source type. Create a CSE at programmablesearchengine.google.com
# limited to the trusted-source domain list in
# packages/shared/src/external-ai/seed.ts.
GOOGLE_CSE_API_KEY=REPLACE_ME
GOOGLE_CSE_CX=REPLACE_ME

# External-AI worker concurrency — caps how many seed sources can be
# fetched in parallel by the Phase-5 ingestion path. 2 is conservative;
# bump if upstream CDNs aren't rate-limiting.
EXTERNAL_AI_CONCURRENCY=2

# Bulk PDF loader admin token — required by scripts/bulk-pdf-load.ts to
# call /pdfs/bulk-upload. Generate with: openssl rand -hex 32. Rotate
# whenever an operator leaves the team.
PDF_BULK_LOAD_TOKEN=REPLACE_ME

# Scopus institutional token (X-ELS-Insttoken header) — required for
# Scopus author-search calls outside KKU's IP range. Issued alongside
# KKU_SCOPUS_API_KEY by KKU Library.
KKU_SCOPUS_INST_TOKEN=

# KKU's OpenAlex institution ID — defaults to I179193067 (KKU) when
# unset. Override only if KKU's OpenAlex record changes upstream.
# KKU_OPENALEX_INSTITUTION_ID=I179193067

# kkuscholar TLS — set to "true" if KKU Library enables TLS on the
# Postgres mirror at 10.130.2.151. Today it's plain TCP on the LAN.
KKU_PUBLICATIONS_DB_SSL=false

# Postgres query timeout for kkuscholar reads — connector tunes itself
# to the legacy 9.5 instance's analytical scan speed (240s default).
PG_QUERY_TIMEOUT_MS=240000

# MinIO avatar bucket — auto-created on first /profile avatar upload.
# Keep as "avatars" unless namespacing rules dictate otherwise.
MINIO_BUCKET_AVATARS=avatars

# KKU HR processed mirror (MySQL) — read-only credentials for the
# UNICON-derived "processed-HR" staff dashboards. Separate from
# DS2001/DS2003/DS2004 (the raw datasets); this is the curated mirror.
KKU_HR_PROCESSED_DB_HOST=REPLACE_ME
KKU_HR_PROCESSED_DB_PORT=3306
KKU_HR_PROCESSED_DB_USER=REPLACE_ME
KKU_HR_PROCESSED_DB_PASSWORD=REPLACE_ME
KKU_HR_PROCESSED_DB_DATABASE=REPLACE_ME

# Backup-verify state directory — where the weekly verify-backup.sh
# systemd timer writes its run history + integrity hash.
BACKUP_VERIFY_STATE_DIR=/var/lib/program-landscape

# AI-readiness gold-set labeller — name stamped onto rows in the
# gold-labelled training corpus. Leave blank in prod.
# GOLD_LABELLER=

# ── KKU Digital Intelligence (DQ) — student competency test results ──────
# Source for the /education/student-dq dashboard. The export endpoint
# returns one row per student with per-module scores:
#   GET {DQ_API_BASE_URL}/export/student-scores
#   Authorization: Bearer ${DQ_API_TOKEN}
# The token is issued by LTIC (ltic.psli@kku.ac.th). Treat it as a secret:
# the payload carries student names, so it must never reach the browser.
DQ_API_BASE_URL=https://dq.kku.ac.th/v3/api
DQ_API_TOKEN=
# Hard timeout for one export call. The full export is a single large
# response (all students), so allow generously more than a normal API call.
DQ_API_REQUEST_TIMEOUT_MS=120000

# ── Google Scholar via ScrapingBee (on-demand research fetch) ────────────
# Paid scraping proxy — fetches Google Scholar pages on our behalf so the
# request comes from ScrapingBee's IP pool, not KKU's. Metered per request.
#
# Deliberately EMPTY rather than a placeholder string: a truthy placeholder
# is what armed the /analyst tool-use bug on 2026-09-07, where
# ANTHROPIC_API_KEY=REPLACE_ME built a real secondary provider on any
# unedited deploy. Code treats "unset" and "not configured" as the same
# thing, so leave this blank until a real key is set.
SCRAPINGBEE_API_KEY=
SCRAPINGBEE_BASE_URL=https://app.scrapingbee.com/api/v1/
SCRAPINGBEE_TIMEOUT_MS=30000
# Hard cap on a single admin bulk fetch, enforced server-side in
# apps/api/src/scholar/scholar.service.ts (the admin console shows it too, but
# the console is not the guard). Counted AFTER duplicate user ids are
# collapsed, so it bounds people rather than list length. ScrapingBee bills
# ~15 credits per page, so this is what stops one careless "select all" from
# spending a month's plan. Unset or non-numeric falls back to 100.
SCHOLAR_BULK_MAX_TARGETS=100
# Binds allowed per person per rolling 24 hours. A bind fetches page 1 of the
# pasted Scholar profile (~15 credits) to verify the name BEFORE it can reject
# it, so a wrong URL is billed in full. Every attempt is recorded in
# scholar_bind_attempts with its real cost — refusals included, since those are
# the ones that spend without producing anything. SUPER_ADMIN is exempt, matching
# the fetch quota. Unset or non-numeric falls back to 5.
SCHOLAR_BIND_MAX_PER_DAY=5
