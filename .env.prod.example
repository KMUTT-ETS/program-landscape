# Program Landscape — production environment template.
#
# Copy this file to /opt/program-landscape/.env.prod on the prod server,
# fill in the real values, chmod 600, chown root:root. NEVER commit the
# populated .env.prod — .gitignore already blocks it.
#
# The deploy script reads /opt/program-landscape/.env.prod and loads it
# into every app container via docker-compose's `env_file`. Secrets for
# Postgres + MinIO live in /opt/program-landscape/secrets/ (one secret
# per file) because docker-compose's `secrets:` reads from files.

# ─── Environment ────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ─── Public URLs (used by NextAuth redirects, link generation) ──────
NEXTAUTH_URL=https://program-landscape.kku.ac.th
AUTH_TRUST_HOST=true
APP_PUBLIC_URL=https://program-landscape.kku.ac.th
API_PUBLIC_URL=https://program-landscape.kku.ac.th/api
# Used by next.config.mjs CSP's connect-src — the browser talks to
# same-origin so this is usually the public URL (or empty).
PUBLIC_API_ORIGIN=https://program-landscape.kku.ac.th

# ─── Auth: NextAuth + KKU SSO ───────────────────────────────────────
# Generate with: openssl rand -hex 64
NEXTAUTH_SECRET=REPLACE_ME_64_HEX_CHARS
# Local credentials MUST be disabled in prod (assertLocalAuthSafe guards).
ENABLE_LOCAL_AUTH=false

KKU_SSO_ISSUER=https://sso.kku.ac.th/realms/kku   # ask KKU IT
KKU_SSO_CLIENT_ID=program-landscape
KKU_SSO_CLIENT_SECRET=REPLACE_ME
KKU_SSO_REDIRECT_URI=https://program-landscape.kku.ac.th/api/auth/callback/kku-sso
KKU_SSO_SCOPES=openid email profile

# ─── Database ───────────────────────────────────────────────────────
# Credentials live in /opt/program-landscape/secrets/postgres_user
# + postgres_password (mounted via `secrets:` in docker-compose.prod.yml).
# DATABASE_URL points the apps at the postgres container on the bridge
# network. The user + password below are interpolated by the app from
# the secret files — but docker-compose's env_file doesn't expand ${},
# so we hardcode the URL here with the expectation that the secrets
# in /run/secrets/ match. The cleaner path: a startup entrypoint that
# reads the secrets and sets DATABASE_URL. For v1 we rely on fixed
# values below.
POSTGRES_USER=kku_prod
POSTGRES_PASSWORD=REPLACE_ME_in_secrets_file
POSTGRES_DB=program_landscape
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kku_prod:REPLACE_ME_in_secrets_file@postgres:5432/program_landscape?schema=public

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ─── MinIO (object storage) ─────────────────────────────────────────
# Credentials in /opt/program-landscape/secrets/minio_user + minio_password.
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=REPLACE_ME_in_secrets_file
MINIO_SECRET_KEY=REPLACE_ME_in_secrets_file
MINIO_BUCKET_PDF_RAW=pdf-raw
MINIO_BUCKET_PDF_OUTPUT=pdf-output
MINIO_BUCKET_BACKUPS=db-backups
# External URL the browser uses for signed download URLs. Leave empty
# if only internal consumers fetch PDFs; set if the browser downloads
# directly (we route through the api today, so empty is fine).
MINIO_PUBLIC_ENDPOINT=

# ─── Gotenberg (PDF generation) ─────────────────────────────────────
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_PORT=3000
GOTENBERG_REQUEST_TIMEOUT_MS=60000
GOTENBERG_MAX_CONCURRENCY=3

# ─── PDF governance ─────────────────────────────────────────────────
PDF_SIGNED_URL_TTL_SECONDS=900
PDF_GENERATE_LIMIT_PER_HOUR=120

# ─── AI providers ───────────────────────────────────────────────────
# Primary. google or anthropic are supported; openrouter/intelsphere
# are stubs.
AI_PROVIDER=google

# Configure BOTH so the transient-error fallback works
# (prompt-13 model fallback: primary → secondary on 429/5xx/timeout).
GOOGLE_AI_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=REPLACE_ME

# Model overrides. Defaults work in most cases.
AI_GOOGLE_COMPLETION_MODEL=gemini-3-flash-preview
AI_GOOGLE_EMBEDDING_MODEL=text-embedding-004
AI_CURRICULUM_MODEL=gemini-3-flash-preview

# KKU internal AI gateway (stubbed today — prompt 14 wires the real one).
# KKU_INTELSPHERE_URL=
# KKU_INTELSPHERE_API_KEY=

# ─── AI governance ──────────────────────────────────────────────────
AI_AUTO_APPROVE_THRESHOLD=0.85
AI_QUOTA_DEFAULT_USD=1
AI_QUOTA_EXECUTIVE_USD=3
AI_QUOTA_ANALYST_USD=10
AI_QUOTA_ADMIN_USD=10

# ─── Ingestion + pdf-intake workers ─────────────────────────────────
PDF_INTAKE_CONCURRENCY=2
PDF_INTAKE_MAX_ATTEMPTS=2
PDF_INTAKE_BACKOFF_BASE_MS=10000
PDF_INTAKE_CLASSIFIER_THRESHOLD=0.7
PDF_INTAKE_EXTRACTOR_THRESHOLD=0.8
AI_JOBS_CONCURRENCY=2
AI_JOBS_MAX_ATTEMPTS=2
AI_JOBS_BACKOFF_BASE_MS=15000

# ─── Observability ──────────────────────────────────────────────────
CACHE_KEY_PREFIX=kku:cache:

# ─── Release marker — overwritten by deploy.sh ──────────────────────
# RELEASE_VERSION is injected via `export` in deploy.sh, not env_file.
# Left here as a breadcrumb.
# RELEASE_VERSION=0.0.0
