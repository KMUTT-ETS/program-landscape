# syntax=docker/dockerfile:1.7
# apps/ingestion — production image for the standalone BullMQ worker
# + trend-monitors scheduler. No HTTP surface — runs until SIGTERM.
#
# Shape parallels apps/api/Dockerfile.prod; the only runtime differences
# are the entrypoint and the absence of an HTTP healthcheck.

ARG NODE_VERSION=20-alpine

# ── Stage 1: deps ────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl \
  && corepack enable \
  && corepack prepare pnpm@10.33.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY apps/ingestion/package.json ./apps/ingestion/
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/ui/package.json ./packages/ui/
COPY packages/design/package.json ./packages/design/
COPY packages/pdf-templates/package.json ./packages/pdf-templates/
# patches/ is referenced by package.json's pnpm.patchedDependencies — must
# exist before `pnpm fetch` or it fails with ERR_PNPM_PATCH_NOT_FOUND.
COPY patches ./patches
RUN pnpm fetch --prod=false

COPY . .
RUN pnpm install --frozen-lockfile --offline --prefer-offline

# ── Stage 2: build ───────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS build
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl \
  && corepack enable \
  && corepack prepare pnpm@10.33.1 --activate
COPY --from=deps /app /app

RUN pnpm --filter @kku/db exec prisma generate
RUN pnpm --filter ingestion build
# --legacy: pnpm v10 requires inject-workspace-packages=true to deploy
# without --legacy. Our workspace doesn't use injected deps, so opt into
# the v9 behaviour explicitly.
RUN pnpm deploy --filter ingestion --prod --legacy /tmp/ingestion \
  # Copy the generated Prisma client (ingestion's @kku/db imports
  # PrismaClient at boot; without `.prisma/client/` the runtime errors
  # with "@prisma/client did not initialize yet"). Same fix as the api
  # Dockerfile.
  && cp -r /app/node_modules/.pnpm/@prisma+client@* /tmp/ingestion/node_modules/.pnpm/ 2>/dev/null || true

# ── Stage 3: runner ──────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS runner
WORKDIR /app
RUN apk add --no-cache tini openssl \
  && addgroup -S app -g 1001 \
  && adduser -S app -G app -u 1001

ENV NODE_ENV=production

COPY --from=build --chown=app:app /tmp/ingestion/dist ./dist
COPY --from=build --chown=app:app /tmp/ingestion/node_modules ./node_modules
COPY --from=build --chown=app:app /app/packages/db/prisma ./packages/db/prisma
COPY --from=build --chown=app:app /app/packages/db/package.json ./packages/db/
COPY --from=build --chown=app:app /app/apps/ingestion/package.json ./

USER app

# No HTTP port — Docker healthcheck probes the process.
HEALTHCHECK --interval=60s --timeout=10s --retries=3 --start-period=30s \
  CMD pgrep -f 'dist/main.js' >/dev/null || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "--import", "tsx", "dist/main.js"]
