!.env.example
!.env.prod.example

# Secrets
secrets/
*.pem
*.key

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Prisma
prisma/.env

# Testing
coverage/
.nyc_output/

# Release artifacts
dist/releases/
dist/*.tar.gz
dist/*.sha256

# TypeScript incremental cache
*.tsbuildinfo

# Gotenberg fonts — TH Sarabun New is sourced locally per dev
# (see infra/gotenberg/README.md). Production images bake them in.
infra/gotenberg/fonts/*.ttf
infra/gotenberg/fonts/*.TTF

# pdfjs-dist worker copied into apps/web/public at prebuild time; the
# real source is node_modules/pdfjs-dist (see scripts/copy-pdf-worker.mjs).
apps/web/public/pdf.worker.*.mjs

# Claude Code per-session state (schedules, local overrides).
.claude/


# Ad-hoc operational SQL. One-off scripts written to patch production data
# (`*-prod.sql`, provenance backfills, bridge syncs) get dropped in the repo
# root while they are being run, then forgotten — where a single `git add .`
# commits them. They are not source-of-truth: schema changes belong in
# packages/db/prisma/migrations/, which this rule does not touch because it
# is anchored to the repo root.
#
# The pattern is ignored, not the five filenames that happened to exist when
# this rule was written. If you need to keep one, move it under
# packages/db/prisma/migrations/ or force-add it deliberately, having read it.
/*.sql
*-prod.sql

# Bulk-digest run logs (per-run artifacts, not source-of-truth)
logs/
.preflight/
gold-labels/
.superpowers/
