# ──────────────────────────────────────────────────────────────────────────
# KKU Curriculum Landscape — environment template
# Copy to .env (dev) or .env.prod (production) and fill in values.
# .env is gitignored; never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database (PostgreSQL 16 + postgis + pgvector + pg_trgm) ---
POSTGRES_USER=kku
POSTGRES_PASSWORD=kku_dev_password
POSTGRES_DB=program_landscape
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kku:kku_dev_password@localhost:5432/program_landscape?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minio_dev
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=ap-southeast-1
MINIO_BUCKET_PDF_RAW=pdf-raw
MINIO_BUCKET_PDF_OUTPUT=pdf-output

# --- Gotenberg (PDF generation) ---
GOTENBERG_URL=http://localhost:3001

# --- Auth (next-auth v5, KKU SSO via OIDC) ---
# In dev, local credentials are allowed; in prod, KKU SSO is required.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true
ALLOW_LOCAL_CREDENTIALS=true

KKU_SSO_ISSUER=
KKU_SSO_CLIENT_ID=
KKU_SSO_CLIENT_SECRET=
KKU_SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback/kku

# --- AI provider (filled in prompt 04) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Logging / telemetry ---
LOG_LEVEL=info
