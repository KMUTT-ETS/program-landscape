# ──────────────────────────────────────────────────────────────────────────
# KKU Curriculum Landscape — environment template
# Copy to .env (dev) or .env.prod (production) and fill in values.
# .env is gitignored; never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
# For KKU-SSO UAT on a dev box behind the KKU LAN, set both URLs to the
# dev box's LAN IP so the SSO server can reach the callback. localhost
# only works when the browser AND the dev server are on the same host.
APP_URL=http://10.101.111.233:3000
API_URL=http://10.101.111.233:4000

# --- Database (PostgreSQL 16 + postgis + pgvector + pg_trgm) ---
POSTGRES_USER=kku
POSTGRES_PASSWORD=kku_dev_password
POSTGRES_DB=program_landscape
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kku:kku_dev_password@localhost:5432/program_landscape?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minio_dev
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=ap-southeast-1
MINIO_BUCKET_PDF_RAW=pdf-raw
MINIO_BUCKET_PDF_OUTPUT=pdf-output
# S3 credentials used by the app services to write/read generated PDFs.
# In dev these match MINIO_ROOT_*; in prod, create a scoped IAM user.
MINIO_ACCESS_KEY=minio_dev
MINIO_SECRET_KEY=minio_dev_password
# Host used in signed URLs returned to the browser. Leave blank to use
# MINIO_ENDPOINT; set this to the public-facing host when behind a proxy.
MINIO_PUBLIC_ENDPOINT=

# --- Gotenberg (PDF generation) ---
# URL is host:port outside Docker (dev), or http://gotenberg:3000 on the
# compose network. Override when running app services inside compose.
GOTENBERG_URL=http://localhost:3001
GOTENBERG_PORT=3001
# Hard timeout for a single Gotenberg HTTP call. Must be strictly less
# than Gotenberg's --api-timeout (set in docker-compose.yml).
GOTENBERG_REQUEST_TIMEOUT_MS=55000
# Max concurrent Gotenberg conversions from this app. Gotenberg itself
# has no backpressure, so we bound it upstream.
GOTENBERG_MAX_CONCURRENCY=4
# Seconds a signed URL for a generated PDF stays valid.
PDF_SIGNED_URL_TTL_SECONDS=900
# Per-user rate limit for PDF generation (req/hour). Honoured by the
# NestJS PdfController throttler override.
PDF_GENERATE_LIMIT_PER_HOUR=60

# --- Auth (next-auth v5, KKU SSO via OIDC) ---
# In dev, local credentials are allowed; in prod, KKU SSO is required.
NEXTAUTH_URL=http://10.101.111.233:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true
# Enables the dev-only Credentials provider. REFUSES to load if
# NODE_ENV=production. In prod, KKU SSO is the only path.
ENABLE_LOCAL_AUTH=true
# Shared dev password accepted by Credentials provider for any user
# whose `users.password_hash` is NULL. Users with a per-user password
# (set during pre-provisioning at /admin/users) bypass this and accept
# only their own. Never used in prod.
DEV_AUTH_PASSWORD=kku-dev

KKU_SSO_ISSUER=
KKU_SSO_CLIENT_ID=
KKU_SSO_CLIENT_SECRET=
KKU_SSO_REDIRECT_URI=http://10.101.111.233:3000/api/auth/callback/kku-sso
KKU_SSO_SCOPES=openid profile email

# --- KKU Employee API (api.kku.ac.th/docs/v3) ---
# Used by /admin/users to look up KKU staff by email when pre-provisioning
# user accounts before their first SSO login. Token endpoint is
# {KKU_API_BASE_URL}/v3/token; employee lookup is
# {KKU_API_BASE_URL}/v3/employee-by-email?email={email}.
# Tokens are cached in-memory until expiry (typical 1h TTL per the spec).
KKU_API_BASE_URL=https://api.kku.ac.th
KKU_API_CLIENT_ID=
KKU_API_CLIENT_SECRET=

# --- AI provider (filled in prompt 04) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Logging / telemetry ---
LOG_LEVEL=info

# --- Connector: KKU Registrar (Oracle, prompt 14) ---
# Read-only access to the KKU Registry's POWERBI schema via Oracle 11g+.
# Connection details supplied by the Registrar's office; password lives
# only in this .env (or a docker secret in prod) and is NEVER committed.
# Used by the kku-registry connector to populate EnrollmentMetric +
# StudentDemographic. PII never leaves the SELECT — all aggregation
# happens server-side via GROUP BY. See docs/data-sources/kku-registry.md.
KKU_REGISTRY_DB_HOST=regora19scan.kku.ac.th
KKU_REGISTRY_DB_PORT=1521
KKU_REGISTRY_DB_SERVICE=kku_svc
KKU_REGISTRY_DB_USER=powerbi
KKU_REGISTRY_DB_PASSWORD=

# --- Connector: KKU HR (Microsoft SQL Server, prompt 14) ---
# Read-only access to the HCMEmployee.dbo schema. Per the 2026-04-27
# session, the SQL Server at 10.101.104.192 does NOT do TLS on the
# connection — encrypt=false. Use a dedicated read-only login (NOT sa);
# `sa` access was offered initially but flagged as too privileged.
# Used by the kku-hr connector to populate FacultyMember (per-person,
# role-gated; PII columns never in the SELECT projection) and
# FacultyCompensation (aggregate-at-source, no per-person salary).
# See docs/data-sources/kku-hr.md.
KKU_HR_DB_HOST=10.101.104.192
KKU_HR_DB_PORT=1433
KKU_HR_DB_DATABASE=HCMEmployee
KKU_HR_DB_USER=
KKU_HR_DB_PASSWORD=
KKU_HR_DB_ENCRYPT=false
KKU_HR_DB_TRUST_SERVER_CERT=true

# --- Processed HR Data (MySQL) ---
# Pre-aggregated / ETL'd HR mart maintained by KKU. Used by the Staff
# dashboard for cube refreshes; complement to the raw HCMEmployee feed
# above. Read-only login; treat the password as production-grade secret.
KKU_HR_PROCESSED_DB_HOST=202.28.117.84
KKU_HR_PROCESSED_DB_PORT=3306
KKU_HR_PROCESSED_DB_DATABASE=
KKU_HR_PROCESSED_DB_USER=
KKU_HR_PROCESSED_DB_PASSWORD=
KKU_HR_PROCESSED_DB_SSL=false

# --- UNICON DS2003 (MySQL) — Education qualifications of all employees ---
# KKU's submission to the MHESI-UniCON system; covers degree level,
# major, institute, country, graduation year per staff member. The view
# `DS2003` is the canonical read surface. Server-to-server only.
UNICON_DS2003_DB_HOST=10.101.106.44
UNICON_DS2003_DB_PORT=3310
UNICON_DS2003_DB_DATABASE=UNICON_STAFF_KKU
UNICON_DS2003_DB_USER=
UNICON_DS2003_DB_PASSWORD=
UNICON_DS2003_DB_SSL=false

# --- UNICON DS2004 (MySQL) — Academic staff per program (curriculum) ---
# DS2004 lists every academic-staff appointment to each MHESI-registered
# curriculum. CURR_ID = MHESI curriculum ID (joins our Program.mhesiCode).
# CITIZEN_ID joins the processed-HR mart via SHA-256(citizen_id).
# View name carries an academic-year suffix (`_682` = BE 2568); the
# connector resolves the latest view at runtime.
UNICON_DS2004_DB_HOST=10.130.2.156
UNICON_DS2004_DB_PORT=3306
UNICON_DS2004_DB_DATABASE=reg_unicon
UNICON_DS2004_DB_USER=
UNICON_DS2004_DB_PASSWORD=
UNICON_DS2004_DB_SSL=false

# --- Connector: KKU Research (was OpenAlex + Scopus; pivoted 2026-05-07) ---
# v2 sources research output from the internal kku-publications mirror
# (see KKU_PUBLICATIONS_DB_* below) — see catalog.ts for the migration
# notes. The OpenAlex / Scopus public-API env keys below are RETAINED
# as the rollback path: connector.openalex.ts is preserved in tree for
# the 30-day green-history evaluation window. After 2026-06-06 they
# can be removed if v2 has been stable.
OPENALEX_MAILTO=
KKU_OPENALEX_INSTITUTION_ID=I179193067
# Lower bound for publication_year filter. Default 2015 = 10 years.
# Honoured by v2 (kku-publications mirror) too.
KKU_RESEARCH_YEAR_FROM=2015
KKU_SCOPUS_API_KEY=
KKU_SCOPUS_INST_TOKEN=

# --- Connector: KKU Publications (PostgreSQL — kku-research v2) ---
# Internal KKU mirror at 10.130.2.151, curated by KKU Library / Research
# Office. NOT just a Scopus mirror — it's a full institutional research
# warehouse with 5 sources (Scopus, PubMed, ISI/Web of Science, TCI Thai
# Citation Index, NRIIS) AND a curator-grade KKU author/faculty/department
# graph. As of 2026-05-07 this connection is what powers the kku-research
# slug; see catalog.ts. v1 of the kku-research connector pivoted to wire
# Scopus + PubMed (both fresh as of May 2026); ISI + TCI deferred since
# upstream is stale (last updated 2022 / 2019).
# PII posture: aggregate publication metadata only. Author display names
# + ORCIDs are public per the data subject's act of publishing.
# `people.pid` (sparse 13-digit Thai citizen IDs in some rows) is
# DELIBERATELY NOT read by the connector; the discovery probe's PII
# guard refuses to sample any table whose column name matches `pid` too.
KKU_PUBLICATIONS_DB_HOST=10.130.2.151
KKU_PUBLICATIONS_DB_PORT=5432
KKU_PUBLICATIONS_DB_DATABASE=
KKU_PUBLICATIONS_DB_USER=
KKU_PUBLICATIONS_DB_PASSWORD=
# Set to true only if the mirror runs TLS. Internal-network Postgres
# typically does not. Keep false unless KKU Library says otherwise.
KKU_PUBLICATIONS_DB_SSL=false
# Set to true to skip cert verification when SSL is enabled (self-signed).
KKU_PUBLICATIONS_DB_SSL_REJECT_UNAUTHORIZED=false

# --- Connector: KMITL Skill Mapping (prompt 14, replaces jobthai + jobsdb) ---
# KMITL exposes aggregated skill-demand intelligence (LinkedIn profiles +
# job postings + grad data, processed by KMITL) via the Skill Mapping API.
# Server-to-server only — Method 1 token = base64(CLIENT_ID:SECRET_KEY).
# CLIENT_ID + SECRET_KEY are issued by KMITL to authorized partners; treat
# the SECRET_KEY as production-grade secret material (never log, never
# commit, never expose to client-side bundles). See
# docs/data-sources/kmitl-skill-mapping.md.
KMITL_SKILL_MAPPING_BASE_URL=https://skill.kmitl.ac.th/api/v1
KMITL_SKILL_MAPPING_CLIENT_ID=
KMITL_SKILL_MAPPING_SECRET_KEY=

# --- Connector mode (prompt 14: real-data integration) ---
# Global fallback. Until every connector has a real implementation,
# leave this on `mocked` and flip per-slug below as you wire each.
CONNECTOR_MODE=mocked
# Per-connector override examples — uncomment when a real implementation
# ships. Slug → env key = CONNECTOR_<SLUG>_MODE (upper, - → _).
#
# CONNECTOR_KKU_REGISTRY_MODE=real       # prompt 14 — KKU Registry (live since 2026-04-27)
# CONNECTOR_KKU_FINANCE_MODE=real        # prompt 14 — KKU Finance (live since 2026-04-28; populates raw inputs only — cost-allocation methodology v1.0 still blocked)
# CONNECTOR_KKU_HR_MODE=real             # prompt 14 — KKU HR (live since 2026-04-28; PDPA-sensitive)
# CONNECTOR_KKU_ALUMNI_MODE=real
# CONNECTOR_KKU_RESEARCH_MODE=real       # prompt 14 — KKU Research (live since 2026-04-28; OpenAlex primary, Scopus enrichment when key present)
# CONNECTOR_KKU_PUBLICATIONS_MODE=real   # prompt 14 — KKU Publications (internal Scopus mirror, under evaluation as replacement for kku-research)
# CONNECTOR_DIGITAL_TRANSCRIPT_MODE=real
# CONNECTOR_MHESI_CISA_MODE=real
# CONNECTOR_KMITL_SKILL_MAPPING_MODE=real  # prompt 14 — KMITL Skill Mapping (replaces jobthai + jobsdb)
# CONNECTOR_JOBTHAI_MODE=real            # SUPERSEDED — see kmitl-skill-mapping
# CONNECTOR_JOBSDB_MODE=real             # SUPERSEDED — see kmitl-skill-mapping
# CONNECTOR_NSO_LABOR_FORCE_MODE=real    # PDF pipeline
# CONNECTOR_TCAS_MODE=real               # PDF + XLSX
# CONNECTOR_TPQI_MODE=real               # PDF + API mix
# CONNECTOR_MHESI_POLICY_MODE=real
# CONNECTOR_NESDC_REPORTS_MODE=real
# CONNECTOR_NXPO_REPORTS_MODE=real
# CONNECTOR_BOI_SECTORAL_MODE=real
# CONNECTOR_EECO_REPORTS_MODE=real
# CONNECTOR_WEF_FUTURE_OF_JOBS_MODE=real
# CONNECTOR_OECD_REPORTS_MODE=real
# CONNECTOR_WORLD_BANK_MODE=real
# CONNECTOR_ADB_GMS_MODE=real
# CONNECTOR_SCOPUS_MODE=real             # paid subscription
# CONNECTOR_OPENALEX_MODE=real           # free; priority target
# CONNECTOR_PEER_PROGRAMS_SCRAPER_MODE=real
