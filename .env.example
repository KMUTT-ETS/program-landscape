# ──────────────────────────────────────────────────────────────────────────
# KKU Curriculum Landscape — environment template
# Copy to .env (dev) or .env.prod (production) and fill in values.
# .env is gitignored; never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database (PostgreSQL 16 + postgis + pgvector + pg_trgm) ---
POSTGRES_USER=kku
POSTGRES_PASSWORD=kku_dev_password
POSTGRES_DB=program_landscape
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kku:kku_dev_password@localhost:5432/program_landscape?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minio_dev
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=ap-southeast-1
MINIO_BUCKET_PDF_RAW=pdf-raw
MINIO_BUCKET_PDF_OUTPUT=pdf-output
# S3 credentials used by the app services to write/read generated PDFs.
# In dev these match MINIO_ROOT_*; in prod, create a scoped IAM user.
MINIO_ACCESS_KEY=minio_dev
MINIO_SECRET_KEY=minio_dev_password
# Host used in signed URLs returned to the browser. Leave blank to use
# MINIO_ENDPOINT; set this to the public-facing host when behind a proxy.
MINIO_PUBLIC_ENDPOINT=

# --- Gotenberg (PDF generation) ---
# URL is host:port outside Docker (dev), or http://gotenberg:3000 on the
# compose network. Override when running app services inside compose.
GOTENBERG_URL=http://localhost:3001
GOTENBERG_PORT=3001
# Hard timeout for a single Gotenberg HTTP call. Must be strictly less
# than Gotenberg's --api-timeout (set in docker-compose.yml).
GOTENBERG_REQUEST_TIMEOUT_MS=55000
# Max concurrent Gotenberg conversions from this app. Gotenberg itself
# has no backpressure, so we bound it upstream.
GOTENBERG_MAX_CONCURRENCY=4
# Seconds a signed URL for a generated PDF stays valid.
PDF_SIGNED_URL_TTL_SECONDS=900
# Per-user rate limit for PDF generation (req/hour). Honoured by the
# NestJS PdfController throttler override.
PDF_GENERATE_LIMIT_PER_HOUR=60

# --- Auth (next-auth v5, KKU SSO via OIDC) ---
# In dev, local credentials are allowed; in prod, KKU SSO is required.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true
# Enables the dev-only Credentials provider. REFUSES to load if
# NODE_ENV=production. In prod, KKU SSO is the only path.
ENABLE_LOCAL_AUTH=true
# Shared dev password accepted by Credentials provider for any seeded user.
# Never used in prod.
DEV_AUTH_PASSWORD=kku-dev

KKU_SSO_ISSUER=
KKU_SSO_CLIENT_ID=
KKU_SSO_CLIENT_SECRET=
KKU_SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback/kku-sso
KKU_SSO_SCOPES=openid profile email

# --- AI provider (filled in prompt 04) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Logging / telemetry ---
LOG_LEVEL=info
