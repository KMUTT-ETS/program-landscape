[Unit]
Description=Program Landscape weekly full backup (pg_dump + MinIO mirror)
Documentation=file:///opt/program-landscape/current/DEPLOYMENT.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/program-landscape
# No --no-minio here: this is the run that captures the object store.
# Its mirror lands under the same 30-day retention as every other, so a
# weekly cadence keeps roughly four of them alive at ~2.5 GB each.
ExecStart=/opt/program-landscape/current/scripts/backup.sh
SuccessExitStatus=0
Nice=10
IOSchedulingClass=idle
