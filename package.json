{
  "name": "program-landscape",
  "version": "0.0.0",
  "private": true,
  "description": "KKU Curriculum Intelligence Platform · Program Landscape — strategic decision-support for the University Council",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "pnpm install && node scripts/link-env.mjs && pnpm db:generate && pnpm db:up && pnpm minio:init && pnpm db:migrate && pnpm data-sources:sync --apply && pnpm db:seed:reference",
    "link-env": "node scripts/link-env.mjs",
    "minio:init": "node scripts/ensure-minio-buckets.mjs",
    "dev": "concurrently -n web,api,ingest -c blue,green,magenta \"pnpm --filter web dev\" \"pnpm --filter api start:dev\" \"pnpm --filter ingestion start:dev\"",
    "db:up": "docker compose up -d postgres redis minio gotenberg",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm minio:init && pnpm db:generate && pnpm db:migrate && pnpm data-sources:sync --apply && pnpm db:seed",
    "db:generate": "pnpm --filter @kku/db generate",
    "db:migrate": "pnpm --filter @kku/db prisma migrate deploy",
    "db:migrate:safe": "node scripts/pre-deploy-snapshot.mjs && pnpm --filter @kku/db prisma migrate deploy",
    "db:backup": "node scripts/pre-deploy-snapshot.mjs",
    "db:seed": "pnpm --filter @kku/db seed",
    "db:seed:reference": "pnpm --filter @kku/db seed",
    "db:seed:kku": "pnpm --filter @kku/db seed:kku",
    "ai:eval": "tsx scripts/ai-eval.mjs",
