{
  "name": "program-landscape",
  "version": "0.0.0",
  "private": true,
  "description": "KKU Curriculum Intelligence Platform · Program Landscape — strategic decision-support for the University Council",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "pnpm install && node scripts/link-env.mjs && pnpm db:up && pnpm minio:init && pnpm db:migrate && pnpm db:seed",
    "link-env": "node scripts/link-env.mjs",
    "minio:init": "node scripts/ensure-minio-buckets.mjs",
    "dev": "concurrently -n web,api,ingest -c blue,green,magenta \"pnpm --filter web dev\" \"pnpm --filter api start:dev\" \"pnpm --filter ingestion start:dev\"",
    "db:up": "docker compose up -d postgres redis minio gotenberg",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm minio:init && pnpm db:migrate && pnpm db:seed",
    "db:migrate": "pnpm --filter @kku/db prisma migrate deploy",
    "db:migrate:safe": "node scripts/pre-deploy-snapshot.mjs && pnpm --filter @kku/db prisma migrate deploy",
    "db:backup": "node scripts/pre-deploy-snapshot.mjs",
    "db:seed": "pnpm --filter @kku/db seed",
    "ai:eval": "tsx scripts/ai-eval.mjs",
    "pdf:bulk-load": "tsx apps/ingestion/src/scripts/bulk-pdf-load.ts",
    "provenance:backfill": "tsx apps/ingestion/src/scripts/backfill-provenance.ts",
    "verdicts:snapshot": "tsx apps/ingestion/src/scripts/verdicts-snapshot.ts",
    "verdicts:diff": "tsx apps/ingestion/src/scripts/verdicts-diff.ts",
    "consistency:check": "tsx apps/ingestion/src/scripts/consistency-check.ts",
    "ai:gold-pick": "tsx apps/ingestion/src/scripts/ai-gold-pick.ts",
    "ai:gold-label": "tsx apps/ingestion/src/scripts/ai-gold-label.ts",
    "ai:eval-accuracy": "tsx apps/ingestion/src/scripts/ai-eval-accuracy.ts",
    "registry:capture": "tsx apps/ingestion/src/scripts/capture-registry-sample.ts",
    "education:probe-scores": "tsx apps/ingestion/src/scripts/probe-entry-scores.ts",
    "registry:seed-mappings": "tsx apps/ingestion/src/scripts/seed-registry-mappings.ts",
    "hr:capture": "tsx apps/ingestion/src/scripts/capture-hr-sample.ts",
    "hr:seed-mappings": "tsx apps/ingestion/src/scripts/seed-hr-mappings.ts",
    "finance:capture": "tsx apps/ingestion/src/scripts/capture-finance-sample.ts",
    "research:capture": "tsx apps/ingestion/src/scripts/capture-research-sample.ts",
    "publications:probe": "tsx apps/ingestion/src/scripts/probe-kku-publications.ts",
    "research:backfill-people": "tsx apps/ingestion/src/scripts/backfill-faculty-from-publications.ts",
    "research:backfill-departments": "tsx apps/ingestion/src/scripts/backfill-department-from-publications.ts",
    "kmitl:capture": "tsx apps/ingestion/src/scripts/capture-kmitl-skill-mapping.ts",
    "programs:seed-from-sheet": "tsx apps/ingestion/src/scripts/seed-programs-from-sheet.ts",
    "programs:digest": "tsx apps/ingestion/src/scripts/digest-program.ts",
    "programs:digest-bulk": "tsx apps/ingestion/src/scripts/bulk-digest-programs.ts",
    "programs:link-orphan-pdfs": "tsx apps/ingestion/src/scripts/link-orphan-pdfs.ts",
    "programs:approve-pending": "tsx apps/ingestion/src/scripts/approve-pending-digests.ts",
    "programs:extract-faculty": "tsx apps/ingestion/src/scripts/extract-program-faculty.ts",
    "programs:extract-skills": "tsx apps/ingestion/src/scripts/extract-program-skills-detailed.ts",
    "programs:map-careers": "tsx apps/ingestion/src/scripts/map-program-careers.ts",
    "programs:match-demand": "tsx apps/ingestion/src/scripts/match-program-demand.ts",
    "programs:link-financials": "tsx apps/ingestion/src/scripts/link-program-financials.ts",
    "programs:link-cohorts": "tsx apps/ingestion/src/scripts/link-program-cohorts.ts",
    "programs:link-alumni": "tsx apps/ingestion/src/scripts/link-program-alumni.ts",
    "programs:link-class-offerings": "tsx apps/ingestion/src/scripts/link-class-offerings.ts",
    "programs:materialise-program-courses": "tsx apps/ingestion/src/scripts/materialise-program-courses.ts",
    "staff:backfill-emails": "tsx apps/ingestion/src/scripts/backfill-faculty-member-emails.ts",
    "programs:pipeline": "tsx apps/ingestion/src/scripts/programs-pipeline.ts",
    "programs:pipeline-status": "tsx apps/ingestion/src/scripts/pipeline-status.ts",
    "programs:ai-readiness": "tsx apps/ingestion/src/scripts/generate-program-ai-readiness.ts",
    "programs:pedagogy": "tsx apps/ingestion/src/scripts/generate-program-pedagogy.ts",
    "programs:lifecycle-snapshot": "tsx apps/ingestion/src/scripts/backfill-lifecycle-snapshots.ts",
    "scenarios:seed-templates": "tsx apps/ingestion/src/scripts/seed-scenario-templates.ts",
    "outcomes:ingest": "tsx apps/ingestion/src/scripts/ingest-employment-surveys.ts",
    "outcomes:ingest-xlsx": "tsx apps/ingestion/src/scripts/ingest-employment-surveys-xlsx.ts",
    "outcomes:refresh-derived": "tsx apps/ingestion/src/scripts/refresh-derived.ts",
    "imd:seed": "tsx apps/ingestion/src/scripts/seed-imd-rankings.ts",
    "imd:extract": "tsx apps/ingestion/src/scripts/extract-imd-pdf.ts",
    "tcas-funnel:probe": "tsx apps/ingestion/src/scripts/probe-tcas-funnel.ts",
    "demographics:seed": "tsx apps/ingestion/src/scripts/seed-thailand-demographics.ts",
    "peers:seed-universities": "tsx apps/ingestion/src/scripts/seed-ranked-universities.ts",
    "peers:select": "tsx apps/ingestion/src/scripts/select-program-peers.ts",
    "skills:normalise": "tsx apps/ingestion/src/scripts/normalise-skill-names.ts",
    "skills:seed-automation-risk": "tsx apps/ingestion/src/scripts/seed-skill-automation-risk.ts",
    "risks:assess": "tsx apps/ingestion/src/scripts/risks-assess.ts",
    "risks:seed-measures": "tsx apps/ingestion/src/scripts/seed-risk-measures.ts",
    "staff:enrich-scopus": "tsx apps/ingestion/src/scripts/enrich-scopus-ids.ts",
    "staff:reconcile-mhesi": "tsx apps/api/src/staff/reconcile-mhesi-codes.ts",
    "data:remove-mocks": "tsx apps/ingestion/src/scripts/remove-mock-data.ts",
    "connector:run": "tsx apps/ingestion/src/scripts/run-connector.ts",
    "build:release": "tsx scripts/build-release.ts",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter web test:e2e",
    "lint": "eslint 'apps/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx}'",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "storybook": "pnpm --filter @kku/ui storybook",
    "clean": "rimraf \"**/node_modules\" \"**/dist\" \"**/.next\" \"**/.turbo\" \"**/coverage\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "4.21.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "next@14.2.32": "patches/next@14.2.32.patch"
    }
  }
}
