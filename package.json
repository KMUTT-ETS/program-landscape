    "secrets:scan": "gitleaks dir . --redact --no-banner --config .gitleaks.toml",
    "secrets:scan-staged": "gitleaks git --staged --redact --no-banner --config .gitleaks.toml",
    "e2e": "pnpm --filter web test:e2e",
    "lint": "eslint 'apps/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx}'",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "docs:dev": "pnpm --filter docs-site site:dev",
    "docs:build": "pnpm --filter docs-site site:build",
    "docs:preview": "pnpm --filter docs-site site:preview",
    "storybook": "pnpm --filter @kku/ui storybook",
    "clean": "rimraf \"**/node_modules\" \"**/dist\" \"**/.next\" \"**/.turbo\" \"**/coverage\"",
    "prepare": "husky",
    "demand:backfill-provenance": "tsx apps/ingestion/src/scripts/backfill-demand-match-provenance.ts",
    "jobthai:derive": "tsx apps/ingestion/src/scripts/jobthai-derive.ts",
