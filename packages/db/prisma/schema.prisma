model TrendSignal {
  id                     String     @id @default(cuid())
  signalType             SignalType @map("signal_type")
  title                  String     @db.Text
  summaryTh              String?    @map("summary_th") @db.Text
  summaryEn              String?    @map("summary_en") @db.Text
  sourceUrl              String?    @map("source_url")
  detectedDate           DateTime   @map("detected_date") @db.Date
  impactScore            Float      @map("impact_score")
  affectedProgramIds     String[]   @map("affected_program_ids")
  affectedSkillIds       String[]   @map("affected_skill_ids")
  // AI-derived recommended actions for KKU — array of
  // { priority, actionTh, actionEn }. Written by trend-signal-analysis.v1
  // alongside affectedProgramIds / affectedSkillIds / aiInferenceId.
  recommendedActionsJson Json?      @map("recommended_actions_json")
  // Per-affected-program job-position candidates — array of
  // { programId, immediateRoles[], emergingRoles[], fitNoteTh }. immediateRoles
  // are jobs a current graduate can fill in response to the signal; emergingRoles
  // are roles reachable in 1-3 years if the program adapts / graduates upskill.
  // The flat affectedProgramIds above is kept in sync for all existing consumers.
  affectedProgramsJson   Json?      @map("affected_programs_json")
  // White-space "new initiative" product/service ideas — array of offerings
  // (re-skill / upskill micro-credentials, bootcamps, short courses) for
  // demanded roles KKU has NO current program supply for (incl. vocational-level
  // positions). Empty when existing programs already cover the demand.
  // Both written by trend-signal-analysis.v3.
  newInitiativesJson     Json?      @map("new_initiatives_json")
  aiInferenceId          String?    @map("ai_inference_id")
  // Optional back-pointer to the Phase-5 ExternalAiSource that
  // produced this signal. NULL for legacy / pre-Phase-5 signals + the
  // 6 seeded connector-driven monitors.
  externalAiSourceId     String?    @map("external_ai_source_id")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  aiInference      AiInference?      @relation(fields: [aiInferenceId], references: [id], onDelete: SetNull)
  externalAiSource ExternalAiSource? @relation(fields: [externalAiSourceId], references: [id], onDelete: SetNull)

  @@index([signalType])
  @@index([detectedDate])
  @@index([externalAiSourceId])
  @@map("trend_signals")
}

// ─────────────────────────────────────────────────────────────────────────
// Document-sourced trend signals. An analyst uploads a PDF or pastes a URL
// (e.g. a manpower-demand / job-posting report); the ANALYZE_TREND_DOCUMENT
// ai-job extracts its text, drafts a TrendSignal (trend-document-ingest.v1),
// then runs the trend-signal-analysis pass to attach affected programs/skills
// + recommended actions. This table is the provenance ledger + processing
// status for that flow; `trendSignalId` links to the published signal.
// ─────────────────────────────────────────────────────────────────────────
model TrendDocument {
  id               String                  @id @default(cuid())
  sourceType       TrendDocumentSourceType @map("source_type")
  status           TrendDocumentStatus     @default(PENDING)
  // FILE inputs — stored in MinIO, content-hash deduped.
  originalFilename String?                 @map("original_filename")
  storageUrl       String?                 @map("storage_url")
  contentHash      String?                 @map("content_hash")
  fileSize         Int?                    @map("file_size")
  // URL inputs — the link we fetched.
  sourceUrl        String?                 @map("source_url")
  // Optional operator hint for the signal type (POLICY / MARKET / ...).
  signalTypeHint   String?                 @map("signal_type_hint")
  // Result.
  trendSignalId    String?                 @map("trend_signal_id")
  error            String?                 @db.Text
  uploadedByUserId String?                 @map("uploaded_by_user_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([contentHash])
  @@map("trend_documents")
}

// ─────────────────────────────────────────────────────────────────────────
// External AI search & synthesis — Phase 5 of the admin-console
// redesign (2026-05-12).
//
// One row per external intelligence feed (WEF, IMD, BOI, World Bank,
// Google News, etc.). Each row has a kind that determines how the
// scheduler fetches content (URL_LIST = enumerate URLs; WEB_SEARCH =
// run search queries) and a configJson that carries the kind-specific
// payload (an array of URLs, or an array of query strings).
//
// Every fetched item is AI-summarised into a TrendSignal row, which the
// rest of the platform already consumes (analyst, deep-dive, cockpit).
// ─────────────────────────────────────────────────────────────────────────
model ExternalAiSource {
  id              String                  @id @default(cuid())
  slug            String                  @unique
  name            String
  description     String?                 @db.Text
  kind            ExternalAiSourceKind
  status          ExternalAiSourceStatus  @default(PAUSED)
  fetchStrategy   ExternalAiFetchStrategy @default(PLAIN) @map("fetch_strategy")
  // URL_LIST: { urls: string[] }
  // WEB_SEARCH: { queries: string[], provider?: 'google_cse'|'bing'|'brave', maxResultsPerQuery?: number }
  configJson      Json                    @map("config_json")
  cadenceCron     String?                 @map("cadence_cron")
  // Default classification + scoring for signals produced by this
  // source — operator-overridable per-source via the admin UI.
  signalType      SignalType              @default(NEWS) @map("signal_type")
  defaultImpact   Float                   @default(0.5) @map("default_impact")
  lastFetchedAt   DateTime?               @map("last_fetched_at")
  lastFetchStatus String?                 @map("last_fetch_status")
  lastFetchError  String?                 @map("last_fetch_error") @db.Text
  lastSignalCount Int?                    @map("last_signal_count")
  createdById     String?                 @map("created_by_id")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  createdBy User?         @relation("ExternalAiSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  signals   TrendSignal[]

  @@index([status])
  @@index([kind])
  @@map("external_ai_sources")
}

model PeerProgram {
  id             String                       @id @default(cuid())
  institution    String
  country        String
  programName    String                       @map("program_name")
  programLevel   ProgramLevel                 @map("program_level")
  // Free-text subject area (e.g. "Computer Science", "Biomedical
  // Engineering"). Allows cross-institution subject grouping without a
  // rigid taxonomy. Added in prompt 10 for benchmarking rollups.
  subjectArea    String?                      @map("subject_area")
  descriptionUrl String?                      @map("description_url")
  ranking        Int?
  lastScraped    DateTime                     @map("last_scraped")
  embedding      Unsupported("vector(1536)")?
  sourcePdfId    String?                      @map("source_pdf_id")
  freshnessDate  DateTime                     @map("freshness_date") @db.Date
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  sourcePdf         PdfDocument?       @relation(fields: [sourcePdfId], references: [id], onDelete: SetNull)
  peerSetMembers    PeerSetMember[]
  peerProgramSkills PeerProgramSkill[]

  @@index([institution])
  @@index([country])
  @@index([programLevel])
  @@index([subjectArea])
  @@map("peer_programs")
}

// ─────────────────────────────────────────────────────────────────────────
// AI-driven peer comparison (2026-05-02)
//
// `RankedUniversity` is a curated catalog of QS / THE-ranked institutions
// across four geographic tiers — the universe the AI picks from when
// selecting peer programs for a KKU program. Seeded once and refreshed
// when KKU Library publishes the latest QS/THE rankings.
//
// `ProgramPeerSelection` records the AI's picks per (program × tier).
// Each row links one KKU program to one ranked institution, names the
// peer program at that institution, and carries the AI's rationale
// + confidence. Re-running the selector regenerates rows in place.
// ─────────────────────────────────────────────────────────────────────────

enum PeerTier {
  WORLD // top global universities
  ASIA // top universities across Asia (incl. East Asia)
  SOUTHEAST_ASIA // SG / MY / ID / VN / PH; excludes Thailand
  THAILAND_PEER // Thai universities ranked at or above KKU
}

model RankedUniversity {
  id               String   @id @default(cuid())
  /// Canonical English name (e.g. "National University of Singapore").
  name             String
  country          String
  /// One of 'World' / 'Asia' / 'Southeast Asia' / 'Thailand'. The
  /// AI selector filters by tier; a single university may appear in
  /// multiple tiers (e.g. NUS qualifies for World, Asia, and SEA)
  /// — for storage we pick the *most-specific* tier and rely on
  /// the AI selector to pull cross-tier candidates as needed.
  region           String
  /// QS World University Ranking position (lower = better). Null if
  /// not ranked in QS.
  qsWorldRank      Int?     @map("qs_world_rank")
  /// Times Higher Education world rank.
  theWorldRank     Int?     @map("the_world_rank")
  /// QS Asia University Ranking position.
  qsAsiaRank       Int?     @map("qs_asia_rank")
  theAsiaRank      Int?     @map("the_asia_rank")
  /// Subject-area rankings as JSON keyed by lowercased subject slug.
  /// Example: `{"engineering": {"qs": 50, "the": 60}, "computer-science": {"qs": 40}}`.
  subjectRanksJson Json?    @map("subject_ranks_json")
  rankingYear      Int      @map("ranking_year")
  websiteUrl       String?  @map("website_url")
  /// Optional analyst note (e.g. "ASEAN-only research-intensive flagship").
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  peerSelections ProgramPeerSelection[]

  @@unique([name, rankingYear])
  @@index([region])
  @@index([qsWorldRank])
  @@index([theWorldRank])
  @@map("ranked_universities")
}

/// AI-generated strategic narrative — official-format markdown brief
/// intended for Council decision review. One per program; idempotent
/// upsert from the pipeline runner. Structure (no greetings/closings):
///   ## Executive summary (1-2 sentences)
///   ## Strategic position
///   ## Critical risks
///   ## Opportunities
///   ## Recommended actions (priority order)
model ProgramStrategicNarrative {
  id                       String   @id @default(cuid())
  programId                String   @unique @map("program_id")
  /// Markdown body — rendered as-is in the Deep-Dive UI.
  contentMarkdown          String   @map("content_markdown") @db.Text
  /// Method version (e.g. `program-strategic-narrative.v1`).
  methodVersion            String   @map("method_version")
  /// AI's self-rated confidence 0-1.
  confidence               Float
  generatedAt              DateTime @default(now()) @map("generated_at")
  generatedByAiInferenceId String?  @map("generated_by_ai_inference_id")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_strategic_narratives")
}

/// Discipline-aware AI readiness assessment per program. Replaces the
/// generic v1 keyword-classifier output with reasoning grounded in the
/// program's actual discipline (music, vet, architecture, etc.).
/// One row per program; re-generation upserts. Drives the Deep-Dive's
/// AI Readiness section gaps + recommendations.
model ProgramAiReadinessAssessment {
  id                       String   @id @default(cuid())
  programId                String   @unique @map("program_id")
  /// Discipline-aware score 0-100 (anchored relative to what AI
  /// readiness MEANS for this discipline, not generic ML coverage).
  relevanceScore           Float    @map("relevance_score")
  /// Full assessment payload — typed at the Zod schema layer
  /// (`ProgramAiReadinessAssessmentSchema`). Stored as JSONB so the
  /// schema can evolve without per-bump migrations.
  payloadJson              Json     @map("payload_json")
  /// Method version stamp (e.g. `program-ai-readiness.v2`).
  methodVersion            String   @map("method_version")
  /// AI's self-rated confidence 0-1.
  confidence               Float
  generatedAt              DateTime @default(now()) @map("generated_at")
  generatedByAiInferenceId String?  @map("generated_by_ai_inference_id")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_ai_readiness_assessments")
}

/// Demonstrated research-expertise brief per program, derived from the
/// program's curated faculty roster's last-10-years publications (see
/// @kku/db's assembleResearchExpertiseInput / program-research-expertise-run.ts).
/// UNLIKE ProgramStrategicNarrative/ProgramAiReadinessAssessment above, this
/// is NOT upserted — every run INSERTs a new row so history is preserved;
/// readers take the latest by `generatedAt`.
model ProgramResearchExpertise {
  id             String   @id @default(cuid())
  programId      String   @map("program_id")
  /// Full assessment payload — typed at the Zod schema layer
  /// (`ProgramResearchExpertiseSchema`). Stored as JSONB so the schema can
  /// evolve without per-bump migrations.
  payloadJson    Json     @map("payload_json")
  /// Deterministic input stats snapshot (`ExpertiseStats`) — lets a reader
  /// audit the payload's theme/trend claims without recomputing them.
  inputStatsJson Json     @map("input_stats_json")
  /// Method version stamp (e.g. `program-research-expertise.v1`).
  methodVersion  String   @map("method_version")
  aiInferenceId  String?  @map("ai_inference_id")
  generatedAt    DateTime @default(now()) @map("generated_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, generatedAt])
  @@map("program_research_expertise")
}

/// Per-program pedagogical-readiness assessment. Reads the curriculum
/// PDF + program metadata (faculty, level) and scores observed teaching
/// /learning/assessment/QA practices against discipline-specific best
/// practice (medical→PBL+clinical, engineering→project-based+internship,
/// etc.). Single source of truth for:
///   - health-score.v3.6 relevance dimension `pedagogical_fit` driver
///   - ai-readiness.v3 `pedagogicalReadiness` sub-score (replaces the
///     reserved-null pedagogy weight redistribution)
/// Methodology version: `program-pedagogy.v1`. Re-generation upserts
/// (programId is unique).
model ProgramPedagogyAssessment {
  id                       String   @id @default(cuid())
  programId                String   @unique @map("program_id")
  /// Discipline-fit score 0-100 — how well OBSERVED pedagogy matches
  /// the EXPECTED pattern for this discipline + level.
  disciplineFitScore       Float    @map("discipline_fit_score")
  /// QA-system quality 0-100 (TQF / AUN-QA / EdPEx framework strength
  /// + stakeholder feedback loops + continuous-improvement evidence).
  qaScore                  Float    @map("qa_score")
  /// Composite 0-100 = 0.5·disciplineFit + 0.3·qa + 0.2·industrial.
  /// Feeds health-score relevance + ai-readiness pedagogy sub-score.
  overallScore             Float    @map("overall_score")
  /// Full assessment payload — typed at the Zod schema layer
  /// (`ProgramPedagogyAssessmentSchema`). JSONB so structure can evolve
  /// without per-bump migrations.
  payloadJson              Json     @map("payload_json")
  /// Method version stamp (e.g. `program-pedagogy.v1`).
  methodVersion            String   @map("method_version")
  /// AI's self-rated confidence 0-1. Drops when teaching/learning/QA
  /// sections are thin in the PDF, not when the program scores low.
  confidence               Float
  generatedAt              DateTime @default(now()) @map("generated_at")
  generatedByAiInferenceId String?  @map("generated_by_ai_inference_id")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_pedagogy_assessments")
}

/// Persisted per-program lifecycle verdict snapshot. Computed by
/// `programLifecycleVerdict()` (lifecycle.v1.x). Acts as a write-through
/// cache so the home dashboard + cockpit rollups can read aggregate
/// distributions without re-running the full multi-driver compute (which
/// reads ~15 queries per program). One row per program; re-generation
/// upserts.
model ProgramLifecycleSnapshot {
  id                 String                  @id @default(cuid())
  programId          String                  @unique @map("program_id")
  verdict            ProgramLifecycleVerdict
  /// Trajectory score 0-100 from the multi-driver compute.
  trajectoryScore    Float                   @map("trajectory_score")
  /// Methodology version that produced this snapshot (`lifecycle.v1.1`,
  /// etc.) — bump invalidates older snapshots at the consumer's
  /// discretion.
  methodologyVersion String                  @map("methodology_version")
  /// All driver contributions, raw values, and the rule-based narrative
  /// — typed in TypeScript via `ProgramLifecycleResult`. JSONB so the
  /// driver list can grow without per-bump migrations.
  driversJson        Json                    @map("drivers_json")
  computedAt         DateTime                @default(now()) @map("computed_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([verdict])
  @@map("program_lifecycle_snapshots")
}

/// Cross-scope divergence snapshot — closes evaluation-pipeline.md §13
/// gap #7. Records the difference between a faculty's directly-computed
/// health overall (from `computeHealthScores('university')`) and the
/// enrolment-weighted mean of its programs' overall scores. The two are
/// computed independently (each scope reads its own MV) so divergence
/// is mathematically possible. This snapshot makes it measurable.
///
/// `pnpm consistency:check` writes one row per faculty per run. Rows
/// where `exceedsThreshold = true` (default >10 pts) feed an analyst
/// worklist + the future /admin/data-quality surface.
model CrossScopeDivergenceSnapshot {
  id                String   @id @default(cuid())
  computedAt        DateTime @default(now()) @map("computed_at") @db.Timestamptz
  bundleTag         String   @map("bundle_tag")
  bundleFingerprint String   @map("bundle_fingerprint")
  facultyId         String   @map("faculty_id")
  /// Faculty-scope overall (from computeHealthScores('university')).
  /// NULL when no dimension could be computed at faculty scope.
  facultyOverall    Float?   @map("faculty_overall")
  /// Σ(programOverall × enrolled) / Σ(enrolled) across canonical-and-active
  /// programs in this faculty whose overall is non-null.
  bottomUpWeighted  Float?   @map("bottom_up_weighted")
  programCount      Int      @default(0) @map("program_count")
  programsWithScore Int      @default(0) @map("programs_with_score")
  totalEnrolled     Int      @default(0) @map("total_enrolled")
  /// abs(facultyOverall - bottomUpWeighted). NULL when either side is null.
  divergence        Float?   @map("divergence")
  exceedsThreshold  Boolean  @default(false) @map("exceeds_threshold")
  /// Per-program contributions (programId, overall, enrolled, contribution).
  payloadJson       Json     @map("payload_json")
  createdAt         DateTime @default(now()) @map("created_at")

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([computedAt(sort: Desc)])
  @@index([facultyId, computedAt(sort: Desc)])
  @@index([exceedsThreshold])
  @@map("cross_scope_divergence_snapshots")
}

/// Verdict-stability snapshot — the union of all three verdict axes
/// (Health Score · Lifecycle Verdict · Risk Tier) at one point in time,
/// stamped with the methodology-bundle identity that produced them.
/// Closes evaluation-pipeline.md §13 gap #6.
///
/// Workflow:
///   - `pnpm verdicts:snapshot` writes one row per canonical program.
///   - `pnpm verdicts:diff` compares two snapshots (latest vs previous
///     quarter, or two explicit dates) → analyst worklist of programs
///     whose verdicts flipped or whose drivers moved 20+ pts without
///     flipping (band-edge instability).
///
/// Different from `ProgramLifecycleSnapshot` (which is a write-through
/// cache, one row per program, latest-state-only). VerdictSnapshot is
/// append-only history — multiple rows per program over time.
model VerdictSnapshot {
  id                    String                   @id @default(cuid())
  programId             String                   @map("program_id")
  snapshotAt            DateTime                 @default(now()) @map("snapshot_at") @db.Timestamptz
  bundleTag             String                   @map("bundle_tag")
  bundleFingerprint     String                   @map("bundle_fingerprint")
  /// Health Score — overall + 5 dimensions + completeness%. NULL when the
  /// dimension couldn't be computed (rare; happens when the metric
  /// universe is entirely mocked or absent for a program).
  healthOverall         Float?                   @map("health_overall")
  healthAttractiveness  Float?                   @map("health_attractiveness")
  healthFinancial       Float?                   @map("health_financial")
  healthCapability      Float?                   @map("health_capability")
  healthOutcomes        Float?                   @map("health_outcomes")
  healthRelevance       Float?                   @map("health_relevance")
  healthCompletenessPct Float                    @default(0) @map("health_completeness_pct")
  /// Lifecycle verdict — see ProgramLifecycleVerdict.
  lifecycleVerdict      ProgramLifecycleVerdict? @map("lifecycle_verdict")
  lifecycleTrajectory   Float?                   @map("lifecycle_trajectory")
  /// Risk Score — composite + L1/L2/L3 + tier. BACHELOR-only by design;
  /// NULL on non-BACHELOR programs.
  riskTier              RiskTier?                @map("risk_tier")
  riskComposite         Float?                   @map("risk_composite")
  riskL1                Float?                   @map("risk_l1")
  riskL2                Float?                   @map("risk_l2")
  riskL3                Float?                   @map("risk_l3")
  /// Full per-axis payload (HealthScoreRow + ProgramLifecycleResult +
  /// RiskAssessment shape). JSONB so analysts can grep through history
  /// without per-field migrations.
  payloadJson           Json                     @map("payload_json")
  createdAt             DateTime                 @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, snapshotAt(sort: Desc)])
  @@index([snapshotAt(sort: Desc)])
  @@index([bundleFingerprint])
  @@map("verdict_snapshots")
}

enum ProgramLifecycleVerdict {
  SUNSET
  STABLE
  RISING
  FRONTIER
}

/// Frank AI-generated comparative review of one KKU program against its
/// AI-picked peer set. One row per program; re-generation upserts.
/// Drives the Deep-Dive's Peer Comparison section UI — strengths +
/// weaknesses + per-tier verdicts + improvement recommendations.
model ProgramPeerReview {
  id                       String   @id @default(cuid())
  programId                String   @unique @map("program_id")
  /// Method version stamp (e.g. `program-peer-review.v1`).
  methodVersion            String   @map("method_version")
  /// Full review payload — typed at the Zod schema layer
  /// (`ProgramPeerReviewPayloadSchema`). Stored as JSONB so the schema
  /// can evolve without per-bump migrations.
  payloadJson              Json     @map("payload_json")
  /// AI's overall self-rated confidence in the review (0-1).
  confidence               Float
  /// Number of peer programs the review was generated against.
  peerCountTotal           Int      @map("peer_count_total")
  generatedAt              DateTime @default(now()) @map("generated_at")
  generatedByAiInferenceId String?  @map("generated_by_ai_inference_id")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_peer_reviews")
}

model ProgramPeerSelection {
  id                      String   @id @default(cuid())
  programId               String   @map("program_id")
  tier                    PeerTier
  rankedUniversityId      String   @map("ranked_university_id")
  /// AI-suggested peer program name at this institution (e.g.
  /// "Bachelor of Engineering in Mechanical Engineering" at NUS).
  peerProgramName         String   @map("peer_program_name")
  peerProgramUrl          String?  @map("peer_program_url")
  /// 1-3 sentence rationale for why this is a good peer.
  rationale               String   @db.Text
  /// AI's self-rated confidence in this pick, 0.0-1.0.
  confidence              Float
  /// QS/THE subject-area used (e.g. "engineering-mechanical").
  subjectArea             String?  @map("subject_area")
  /// 1-based rank in the AI's recommendation list for this tier
  /// (1 = best fit). Selectors typically return 5 picks per tier.
  rankInTier              Int      @map("rank_in_tier")
  selectedAt              DateTime @default(now()) @map("selected_at")
  selectedByAiInferenceId String?  @map("selected_by_ai_inference_id")

  program          Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  rankedUniversity RankedUniversity @relation(fields: [rankedUniversityId], references: [id], onDelete: Cascade)

  @@unique([programId, tier, rankedUniversityId])
  @@index([programId, tier])
  @@map("program_peer_selections")
}

model LaborMarketForecast {
  id                 String   @id @default(cuid())
  occupationCode     String   @map("occupation_code")
  region             String
  year               Int
  projectedDemand    Int      @map("projected_demand")
  projectedSupply    Int      @map("projected_supply")
  source             String
  confidence         Float
  freshnessDate      DateTime @map("freshness_date") @db.Date
  methodologyVersion String   @default("v1") @map("methodology_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([occupationCode, region, year, source])
  @@index([occupationCode])
  @@index([region])
  @@index([year])
  @@map("labor_market_forecasts")
}

model DemographicProjection {
  id            String   @id @default(cuid())
  region        String
  year          Int
  ageCohort     String   @map("age_cohort")
  population    Int
  source        String
  freshnessDate DateTime @map("freshness_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([region, year, ageCohort, source])
  @@index([region])
  @@index([year])
  @@map("demographic_projections")
}

// ══════════════════════════════════════════════════════════════════════════
// PDF document infrastructure (primary external-data input — prompt 03b)
// ══════════════════════════════════════════════════════════════════════════

model PdfDocument {
  id                       String                       @id @default(cuid())
  originalFilename         String                       @map("original_filename")
  storageUrl               String                       @map("storage_url")
  fileSize                 Int                          @map("file_size")
  pageCount                Int                          @map("page_count")
  // sourceCategory is the classifier's verdict — or the connector/uploader's
  // explicit override. sourceCategoryHint is the pre-classification guess
  // (from the connector or the uploader's form) that the pipeline weighs
  // against the classifier's proposal.
  sourceCategory           PdfSourceCategory            @map("source_category")
  sourceCategoryHint       PdfSourceCategory?           @map("source_category_hint")
  sourceOrg                String?                      @map("source_org")
  language                 PdfLanguage                  @default(TH)
  uploadedByUserId         String?                      @map("uploaded_by_user_id")
  uploadedAt               DateTime                     @default(now()) @map("uploaded_at")
  processingStatus         PdfProcessingStatus          @default(PENDING) @map("processing_status")
  processingError          String?                      @map("processing_error") @db.Text
  extractedTextUrl         String?                      @map("extracted_text_url")
  ocrApplied               Boolean                      @default(false) @map("ocr_applied")
  ocrConfidence            Float?                       @map("ocr_confidence")
  // Classifier's confidence in sourceCategory — low values surface in the
  // review UI so an analyst can correct an obvious miscategorisation.
  classificationConfidence Float?                       @map("classification_confidence")
  contentHash              String                       @unique @map("content_hash")
  embedding                Unsupported("vector(1536)")?
  // Library lifecycle — orthogonal to processingStatus.
  // ACTIVE is the default for every new PDF; ARCHIVED + DEPRECATED are
  // operator-driven, persisted via PATCH /pdfs/:id/lifecycle.
  lifecycleStatus          PdfLifecycleStatus           @default(ACTIVE) @map("lifecycle_status")
  lifecycleNote            String?                      @map("lifecycle_note") @db.Text
  lifecycleChangedAt       DateTime?                    @map("lifecycle_changed_at")
  lifecycleChangedById     String?                      @map("lifecycle_changed_by_id")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")

  uploadedBy User? @relation("PdfUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  pages               PdfPage[]
  extractions         PdfExtraction[]
  tables              PdfTable[]
  curricula           Curriculum[]
  jobPostings         JobPosting[]
  policyDocuments     PolicyDocument[]
  peerPrograms        PeerProgram[]
  decisionResolutions CouncilDecision[] @relation("DecisionResolution")
  programDocuments    ProgramDocument[]

  @@index([sourceCategory])
  @@index([processingStatus])
  @@index([uploadedAt])
  @@index([lifecycleStatus])
  @@map("pdf_documents")
}

model PdfPage {
  id            String                       @id @default(cuid())
  pdfDocumentId String                       @map("pdf_document_id")
  pageNumber    Int                          @map("page_number")
  textContent   String?                      @map("text_content") @db.Text
  hasImages     Boolean                      @default(false) @map("has_images")
  hasTables     Boolean                      @default(false) @map("has_tables")
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now()) @map("created_at")

  pdfDocument PdfDocument @relation(fields: [pdfDocumentId], references: [id], onDelete: Cascade)

  @@unique([pdfDocumentId, pageNumber])
  @@index([pdfDocumentId])
  @@map("pdf_pages")
}

model PdfExtraction {
  id               String            @id @default(cuid())
  pdfDocumentId    String            @map("pdf_document_id")
  extractionType   PdfExtractionType @map("extraction_type")
  targetEntityType String            @map("target_entity_type")
  targetEntityId   String?           @map("target_entity_id")
  confidence       Float
  methodVersion    String            @map("method_version")
  reviewStatus     ReviewStatus      @default(PENDING_REVIEW) @map("review_status")
  reviewedByUserId String?           @map("reviewed_by_user_id")
  reviewedAt       DateTime?         @map("reviewed_at")
  payloadJson      Json              @map("payload_json")
  // LLM's own "show reasoning" explanation — filled when prompt 04 wires
  // the AI service. Rendered in the review UI's expandable panel.
  reasoning        String?           @db.Text
  // Reviewer notes at approval/rejection time. Pairs with reviewStatus =
  // APPROVED (optional note) or REJECTED (required reason).
  reviewNotes      String?           @map("review_notes") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  pdfDocument PdfDocument @relation(fields: [pdfDocumentId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("ExtractionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([pdfDocumentId])
  @@index([extractionType])
  @@index([reviewStatus])
  @@index([targetEntityType, targetEntityId])
  @@map("pdf_extractions")
}

model PdfTable {
  id             String   @id @default(cuid())
  pdfDocumentId  String   @map("pdf_document_id")
  pageNumber     Int      @map("page_number")
  tableIndex     Int      @map("table_index")
  headersJson    Json     @map("headers_json")
  rowsJson       Json     @map("rows_json")
  structuredData Json?    @map("structured_data")
  createdAt      DateTime @default(now()) @map("created_at")

  pdfDocument PdfDocument @relation(fields: [pdfDocumentId], references: [id], onDelete: Cascade)

  @@unique([pdfDocumentId, pageNumber, tableIndex])
  @@index([pdfDocumentId])
  @@map("pdf_tables")
}

// ══════════════════════════════════════════════════════════════════════════
// Decisions & governance
// ══════════════════════════════════════════════════════════════════════════

model Scenario {
  id                 String                 @id @default(cuid())
  userId             String                 @map("user_id")
  name               String
  descriptionTh      String?                @map("description_th") @db.Text
  descriptionEn      String?                @map("description_en") @db.Text
  scope              ScenarioScope
  scopeId            String?                @map("scope_id")
  scenarioType       ScenarioType           @default(RESHAPE) @map("scenario_type")
  workflowStatus     ScenarioWorkflowStatus @default(DRAFT) @map("workflow_status")
  isTemplate         Boolean                @default(false) @map("is_template")
  // Programs this scenario touches (for list-view filtering + authorisation).
  affectedProgramIds String[]               @map("affected_program_ids")
  horizonYears       Int                    @default(5) @map("horizon_years")
  // Assumption overrides vs the system baseline (keyed by assumption id).
  assumptionsJson    Json                   @map("assumptions_json")
  // Intervention levers — shape varies by scenarioType. Validated in
  // shared/scenarios/types.ts before the engine runs.
  interventionsJson  Json                   @default("[]") @map("interventions_json")
  collaboratorIds    String[]               @map("collaborator_ids")
  parentScenarioId   String?                @map("parent_scenario_id")
  methodologyVersion String                 @default("scenario-engine.v1") @map("methodology_version")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Scenario?         @relation("ScenarioBranch", fields: [parentScenarioId], references: [id], onDelete: SetNull)
  children  Scenario[]        @relation("ScenarioBranch")
  results   ScenarioResult[]
  runs      ScenarioRun[]
  decisions CouncilDecision[]

  @@index([userId])
  @@index([scope, scopeId])
  @@index([scenarioType])
  @@index([workflowStatus])
  @@index([isTemplate])
  @@map("scenarios")
}

// One row per engine run — captures the full projection + sensitivity
// + risk register + Monte Carlo bounds. ScenarioResult stays as a
// searchable flattened metric store (one row per metric-value pair);
// ScenarioRun is the authoritative "everything we computed" blob.
model ScenarioRun {
  id                    String   @id @default(cuid())
  scenarioId            String   @map("scenario_id")
  runAt                 DateTime @default(now()) @map("run_at")
  // Immutable snapshots of what was actually run, so the run is
  // reproducible even after the parent scenario is edited.
  assumptionsSnapshot   Json     @map("assumptions_snapshot")
  interventionsSnapshot Json     @map("interventions_snapshot")
  // Full year-by-year projection + CI + sensitivity + risks.
  projectionJson        Json     @map("projection_json")
  sensitivityJson       Json     @map("sensitivity_json")
  riskRegisterJson      Json     @default("[]") @map("risk_register_json")
  briefAiInferenceId    String?  @map("brief_ai_inference_id")
  methodologyVersion    String   @default("scenario-engine.v1") @map("methodology_version")
  monteCarloN           Int      @default(100) @map("monte_carlo_n")
  // Deterministic seed for Monte Carlo — round-trip identical.
  seed                  BigInt   @default(42)

  scenario Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  briefAi  AiInference? @relation(fields: [briefAiInferenceId], references: [id], onDelete: SetNull)

  @@index([scenarioId])
  @@index([runAt])
  @@map("scenario_runs")
}

model ScenarioResult {
  id            String   @id @default(cuid())
  scenarioId    String   @map("scenario_id")
  metric        String
  value         Float
  confidence    Float?
  aiInferenceId String?  @map("ai_inference_id")
  createdAt     DateTime @default(now()) @map("created_at")

  scenario    Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  aiInference AiInference? @relation(fields: [aiInferenceId], references: [id], onDelete: SetNull)

  @@index([scenarioId])
  @@index([metric])
  @@map("scenario_results")
}

model CouncilDecision {
  id                 String         @id @default(cuid())
  userId             String         @map("user_id")
  scenarioId         String?        @map("scenario_id")
  // Council-facing display title. Free-text; defaults to "<DecisionType>
  // — <first affected program>" when not provided. Added in prompt 12.
  title              String
  decisionType       DecisionType   @map("decision_type")
  affectedProgramIds String[]       @map("affected_program_ids")
  // Programs or faculties affected, pre-resolved for display.
  facultyId          String?        @map("faculty_id")
  rationaleTh        String?        @map("rationale_th") @db.Text
  rationaleEn        String?        @map("rationale_en") @db.Text
  dissentingViewsTh  String?        @map("dissenting_views_th") @db.Text
  effectiveDate      DateTime?      @map("effective_date") @db.Date
  councilSessionRef  String?        @map("council_session_ref")
  status             DecisionStatus @default(PROPOSED)
  // Frozen snapshot of the cockpit/gap/trend state at decision time.
  // Captured once when status transitions to COUNCIL_REVIEWED; immutable
  // thereafter. This is what makes the outcomes review possible —
  // comparing what was projected vs what happened requires freezing
  // the projection at the time of the decision.
  snapshotJson       Json?          @map("snapshot_json")
  snapshotCapturedAt DateTime?      @map("snapshot_captured_at")
  // Amendment chain — a new decision row can supersede an older one.
  // The superseded row stays in the DB (institutional memory).
  version            Int            @default(1)
  supersededById     String?        @map("superseded_by_id")
  // Council resolution / board approval PDF (uploaded separately through
  // the existing PDF intake pipeline).
  resolutionPdfId    String?        @map("resolution_pdf_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  scenario       Scenario?               @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  supersededBy   CouncilDecision?        @relation("DecisionAmendment", fields: [supersededById], references: [id], onDelete: SetNull)
  amendments     CouncilDecision[]       @relation("DecisionAmendment")
  milestones     DecisionMilestone[]
  approvers      DecisionApprover[]
  outcomeReviews DecisionOutcomeReview[]
  resolutionPdf  PdfDocument?            @relation("DecisionResolution", fields: [resolutionPdfId], references: [id], onDelete: SetNull)
  riskMeasures   RiskMeasure[]

  @@index([userId])
  @@index([decisionType])
  @@index([status])
  @@index([facultyId])
  @@index([supersededById])
  @@map("council_decisions")
}

model DecisionMilestone {
  id            String                  @id @default(cuid())
  decisionId    String                  @map("decision_id")
  title         String
  descriptionTh String?                 @map("description_th") @db.Text
  ownerId       String?                 @map("owner_id")
  targetDate    DateTime?               @map("target_date") @db.Date
  completedDate DateTime?               @map("completed_date") @db.Date
  status        DecisionMilestoneStatus @default(PLANNED)
  evidenceUrl   String?                 @map("evidence_url")
  orderIdx      Int                     @default(0) @map("order_idx")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  decision CouncilDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  owner    User?           @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([decisionId, orderIdx])
  @@index([ownerId])
  @@index([status])
  @@index([targetDate])
  @@map("decision_milestones")
}

model DecisionApprover {
  id           String   @id @default(cuid())
  decisionId   String   @map("decision_id")
  userId       String   @map("user_id")
  // 'approver' | 'observer' | 'dissenter'
  role         String   @default("approver")
  // E-signature placeholder — real integration with KKU e-sign service
  // lives in prompt 14 / post-launch.
  signatureRef String?  @map("signature_ref")
  approvedAt   DateTime @default(now()) @map("approved_at")
  noteTh       String?  @map("note_th") @db.Text

  decision CouncilDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user     User            @relation("ApproverUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([decisionId, userId])
  @@index([decisionId])
  @@index([userId])
  @@map("decision_approvers")
}

// AI-generated outcome review. One row per (decision, horizon) pair.
// Scheduled generation (6mo/1yr/3yr after effectiveDate) lands in
// prompt 13 hardening — today, trigger is manual via POST.
model DecisionOutcomeReview {
  id                 String               @id @default(cuid())
  decisionId         String               @map("decision_id")
  horizon            OutcomeReviewHorizon
  generatedAt        DateTime             @default(now()) @map("generated_at")
  narrativeTh        String               @map("narrative_th") @db.Text
  narrativeEn        String?              @map("narrative_en") @db.Text
  // What worked / didn't / lessons — structured for the lessons-learned
  // search page.
  whatWorkedJson     Json                 @map("what_worked_json")
  whatDidntWorkJson  Json                 @map("what_didnt_work_json")
  lessonsJson        Json                 @map("lessons_json")
  // Link to the AiInference row for full audit.
  aiInferenceId      String?              @map("ai_inference_id")
  methodologyVersion String               @default("outcome-review.v1") @map("methodology_version")

  decision    CouncilDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  aiInference AiInference?    @relation("OutcomeReviewAi", fields: [aiInferenceId], references: [id], onDelete: SetNull)

  @@unique([decisionId, horizon])
  @@index([decisionId])
  @@index([horizon])
  @@map("decision_outcome_reviews")
}

model Annotation {
  id            String               @id @default(cuid())
  userId        String               @map("user_id")
  entityType    String               @map("entity_type")
  entityId      String               @map("entity_id")
  // 'comment' (default), 'disagreement' (expert correction of an AI
  // output), 'narrative_edit' (human override of an AI narrative).
  kind          String               @default("comment")
  // Section of the deep-dive this annotation targets — e.g. 'skills',
  // 'outcomes', 'narrative'. Free-text so new sections land without
  // schema churn.
  sectionKey    String?              @map("section_key")
  // When the annotation is a correction of a specific AI output, link
  // to the AiInference row so model-improvement tooling can find it.
  aiInferenceId String?              @map("ai_inference_id")
  bodyTh        String?              @map("body_th") @db.Text
  bodyEn        String?              @map("body_en") @db.Text
  // Visibility added in prompt 12 for the Decision Workspace:
  // PRIVATE (default), TEAM (collaborators on a scenario/decision),
  // COUNCIL (visible across the Council + Executive roles).
  visibility    AnnotationVisibility @default(PRIVATE)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiInference AiInference? @relation(fields: [aiInferenceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([kind])
  @@index([visibility])
  @@map("annotations")
}

// One row per external data source. Connectors in apps/ingestion look up
// their DataSource row on boot and write lastSyncedAt + IngestionRun rows
// as they run. Seeded in packages/db/prisma/seed.ts from the connector
// registry so names never drift between code and DB.
model DataSource {
  id                String                @id @default(cuid())
  // Stable, lowercase-kebab identifier the connector registry keys off
  // (e.g. "kku-registry", "mhesi-cisa"). Don't rename without a DB migration.
  slug              String                @unique
  name              String                @unique
  kind              DataSourceKind
  // Connectors flagged PDF hand fetched bytes to the prompt 03b intake
  // pipeline (create a PdfDocument row) rather than extracting in-process.
  inputFormat       DataSourceInputFormat @default(JSON) @map("input_format")
  baseUrl           String?               @map("base_url")
  acceptsPdfUploads Boolean               @default(false) @map("accepts_pdf_uploads")
  // Cron schedule honoured by the BullMQ scheduler. Null = manual-only.
  // Format: standard 5-field cron (minute hour day month weekday).
  cadenceCron       String?               @map("cadence_cron")
  scheduleEnabled   Boolean               @default(true) @map("schedule_enabled")
  lastSyncedAt      DateTime?             @map("last_synced_at")
  // One of: 'active' | 'paused' | 'error' | 'disabled'. Free-text for now
  // so we can iterate on the lifecycle without migrations; enumify later.
  status            String                @default("active")
  /// Explicit marker for connectors that produce mocked data. Promoted
  /// from the free-text `status='mocked'` convention by migration
  /// 20260511120000_data_quality_provenance. The catalog seeder in
  /// packages/shared/src/ingestion/catalog.ts is the source of truth;
  /// flip a connector's `mocked` value there + reseed to update.
  mocked            Boolean               @default(false)
  // The KKU contact who owns the data-sharing agreement for this source.
  // Non-technical field — filled in docs/data-sources.md and synced here.
  ownerContact      String?               @map("owner_contact")
  notes             String?               @db.Text
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  ingestionRuns IngestionRun[]

  @@index([kind])
  @@index([inputFormat])
  @@index([status])
  @@index([mocked])
  @@map("data_sources")
}

// Every execution of a connector — scheduled or manual — writes one row
// here. The admin /data-sources page reads this for the "recent runs" +
// "error log" panels. status = RUNNING while in-flight so we can detect
// stuck workers; QUEUED is set by the enqueuer.
model IngestionRun {
  id                String              @id @default(cuid())
  dataSourceId      String              @map("data_source_id")
  // SCHEDULED = BullMQ cron fired, MANUAL = admin clicked "Run now",
  // BACKFILL = reserved for bulk catch-up runs.
  trigger           IngestionRunTrigger @default(SCHEDULED)
  triggeredByUserId String?             @map("triggered_by_user_id")
  status            IngestionRunStatus  @default(QUEUED)
  startedAt         DateTime?           @map("started_at")
  completedAt       DateTime?           @map("completed_at")
  recordsFetched    Int                 @default(0) @map("records_fetched")
  recordsLoaded     Int                 @default(0) @map("records_loaded")
  recordsFailed     Int                 @default(0) @map("records_failed")
  // PDF-format connectors record the PdfDocument row they created so the
  // intake pipeline can follow up. Null for API/CSV/etc.
  pdfDocumentId     String?             @map("pdf_document_id")
  durationMs        Int?                @map("duration_ms")
  // BullMQ attempt number (1 for the first try, 2+ for retries). Useful
  // for the admin dashboard when reading logs.
  attempt           Int                 @default(1)
  errorCode         String?             @map("error_code")
  errorMessage      String?             @map("error_message") @db.Text
  // Small structured blob — counts by sub-type, sample IDs, etc.
  // Connector-specific; the UI renders it as a JSON tree.
  metadata          Json?
  createdAt         DateTime            @default(now()) @map("created_at")

  dataSource                 DataSource                  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  triggeredBy                User?                       @relation("IngestionTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  staffEducationHistories    StaffEducationHistory[]
  staffProgramAssignments    StaffProgramAssignment[]
  studentProgramRecords      StudentProgramRecord[]
  staffMasterRecords         StaffMasterRecord[]
  staffCompensationCubes     StaffCompensationCube[]
  // Metric/fact tables added by migration 20260511120000_data_quality_provenance.
  // Each metric row's ingestion_run_id traces back to the originating
  // connector run, enabling per-row provenance + mock-filter at the
  // query layer (see packages/db/src/data-quality.ts).
  enrollmentMetrics          EnrollmentMetric[]
  studentDemographics        StudentDemographic[]
  tcasAdmissionStats         TcasAdmissionStat[]
  alumniCohortStatuses       AlumniCohortStatus[]
  studentCohortDistributions StudentCohortDistribution[]
  financialMetrics           FinancialMetric[]
  graduateOutcomes           GraduateOutcome[]
  researchOutputs            ResearchOutput[]
  facultyCompensations       FacultyCompensation[]
  facultyBudgets             FacultyBudget[]
  kmitlCareers               KmitlCareer[]
  kmitlCareerSkillDemands    KmitlCareerSkillDemand[]
  kmitlSkillGrowths          KmitlSkillGrowth[]
  tcasAdmissionFunnels       TcasAdmissionFunnel[]
  programDemandMatches       ProgramDemandMatch[]
  classOfferings             ClassOffering[]
  programCourses             ProgramCourse[]
  evaluationQuestions        EvaluationQuestion[]
  evaluationResponses        EvaluationResponseSummary[]
  admissionCampaignStats     AdmissionCampaignStat[]

  @@index([dataSourceId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("ingestion_runs")
}

// Every call to PdfGenerationService writes a row here — success or
// failure. The admin "/pdf-generation" dashboard reads this. Observability
// only; the generated bytes live in MinIO (see storageKey).
model PdfGeneration {
  id                   String              @id @default(cuid())
  templateName         String              @map("template_name")
  templateVersion      String              @map("template_version")
  requesterId          String?             @map("requester_id")
  scopeLevel           String?             @map("scope_level")
  scopeId              String?             @map("scope_id")
  // SHA-256 of the JSON-stringified input data. Lets us detect identical
  // regenerations without storing the (possibly large, possibly sensitive)
  // payload itself.
  dataHash             String              @map("data_hash")
  status               PdfGenerationStatus @default(QUEUED)
  byteSize             Int?                @map("byte_size")
  pageCount            Int?                @map("page_count")
  generationDurationMs Int?                @map("generation_duration_ms")
  storageBucket        String?             @map("storage_bucket")
  storageKey           String?             @map("storage_key")
  gotenbergRequestId   String?             @map("gotenberg_request_id")
  errorCode            String?             @map("error_code")
  errorMessage         String?             @map("error_message") @db.Text
  createdAt            DateTime            @default(now()) @map("created_at")
  completedAt          DateTime?           @map("completed_at")

  requester User? @relation(fields: [requesterId], references: [id], onDelete: SetNull)

  @@index([templateName, createdAt])
  @@index([requesterId, createdAt])
  @@index([status])
  @@map("pdf_generations")
}

// Per-user saved cockpit filter state. A "saved view" captures enough
// URL state + filter JSON to restore the cockpit exactly as the user
// left it. Small, cheap, scoped to a single user — not shared.
model SavedCockpitView {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  // Cockpit view mode ('heatmap' / 'matrix' / 'rollup').
  viewMode    String   @map("view_mode")
  scope       String
  scopeId     String?  @map("scope_id")
  // Free-shape filter blob so new filter facets land without a schema
  // migration. Shape is declared in the cockpit DTO Zod schema.
  filtersJson Json     @map("filters_json")
  lastUsedAt  DateTime @default(now()) @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastUsedAt])
  @@map("saved_cockpit_views")
}

// In-app notification inbox. Created by fan-out when a new high-impact
// TrendSignal affects a program the user subscribes to (or, via role +
// faculty association, is responsible for). The inbox surface is a
// top-bar bell + /inbox list; email fan-out is deferred to prompt 13
// when SMTP infra lands.
model Notification {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  // 'trend_signal' (default), 'extraction_ready', 'decision_pending' —
  // free-text discriminator so new kinds don't require migrations.
  kind       String    @default("trend_signal")
  // Short single-line headline (English). Thai body goes in bodyTh.
  title      String
  bodyEn     String?   @map("body_en") @db.Text
  bodyTh     String?   @map("body_th") @db.Text
  // Optional link to the entity that triggered the notification. Kept
  // as text pair so notifications for different entity kinds share the
  // same table. Consumer maps (entityType, entityId) to an app route.
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  // Severity drives badge tone in the bell. 'low' / 'medium' / 'high'.
  severity   String    @default("medium")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([kind])
  @@map("notifications")
}

// Per-user subscription rules. When a TrendSignal matches any rule the
// user subscribed to, fan-out writes a Notification row. Rules are
// ORed (any match fires). Each rule carries ONE filter type to keep
// the matching loop simple.
model SignalSubscription {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  // One of 'program', 'skill', 'sector', 'signal_type'.
  filterType     String   @map("filter_type")
  // Matched against TrendSignal fields depending on filterType:
  //   program      → programId (present in TrendSignal.affectedProgramIds)
  //   skill        → skillId   (present in TrendSignal.affectedSkillIds)
  //   sector       → tags (a planned TrendSignal.tags Text[] — for now
  //                  matched against title substring)
  //   signal_type  → one of POLICY/RESEARCH/MARKET/TECH/NEWS
  filterValue    String   @map("filter_value")
  // Minimum impactScore (0-1) below which the signal is skipped.
  minImpactScore Float    @default(0) @map("min_impact_score")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, filterType, filterValue])
  @@index([filterType, filterValue])
  @@index([isActive])
  @@map("signal_subscriptions")
}

// Bridges KKU SSO faculty/department claim values to our internal IDs.
// Populated manually (seeded for dev) or through an admin screen once we
// see real SSO claims from KKU IT. Auto-provisioning on first SSO login
// reads this table to assign User.facultyId / User.departmentId.
model KkuOrgCodeMapping {
  id           String         @id @default(cuid())
  kkuCode      String         @map("kku_code")
  kind         KkuOrgCodeKind
  facultyId    String?        @map("faculty_id")
  departmentId String?        @map("department_id")
  notes        String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@unique([kkuCode, kind])
  @@index([kind])
  @@map("kku_org_code_mappings")
}

// ══════════════════════════════════════════════════════════════════════════
// Sector taxonomy (Gap Analyzer — prompt 08)
//
// Thailand's BCG economy (Bio-Circular-Green) + the 10+2 S-curve
// targeted industries are the two reference taxonomies we benchmark skill
// demand against. Sectors are a FLAT list (no hierarchy) tagged onto
// individual skills via `skill_sectors`. One skill may belong to several
// sectors (e.g., "battery chemistry" is both Bio-Circular (Green) and
// S-curve "next-gen automotive"). Aggregation is by sum/union at the
// gap-analysis layer.
// ══════════════════════════════════════════════════════════════════════════

enum SectorFamily {
  BCG
  SCURVE
  CUSTOM
}

model Sector {
  id                 String       @id @default(cuid())
  code               String       @unique
  family             SectorFamily
  nameTh             String       @map("name_th")
  nameEn             String       @map("name_en")
  descriptionTh      String?      @map("description_th") @db.Text
  descriptionEn      String?      @map("description_en") @db.Text
  // Heuristic demand-weight multiplier applied when rolling up skill demand
  // into a sector-level index. Default 1.0; higher for strategic sectors.
  demandMultiplier   Float        @default(1.0) @map("demand_multiplier")
  methodologyVersion String       @default("sectors.v1") @map("methodology_version")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  skillSectors SkillSector[]

  @@index([family])
  @@map("sectors")
}

model SkillSector {
  id        String   @id @default(cuid())
  skillId   String   @map("skill_id")
  sectorId  String   @map("sector_id")
  // Weight in [0, 1]: how strongly this skill represents the sector.
  // 1.0 = defining skill, 0.3 = adjacent/transferable.
  weight    Float    @default(1.0)
  createdAt DateTime @default(now()) @map("created_at")

  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([skillId, sectorId])
  @@index([skillId])
  @@index([sectorId])
  @@map("skill_sectors")
}

// ══════════════════════════════════════════════════════════════════════════
// Forecast runs (Gap Analyzer — prompt 08)
//
// Every forecast (demand projection, supply projection) writes one row
// so we can (a) reproduce the value from inputs, (b) back-test accuracy
// when the forecast horizon is reached. `actualValue` and `errorPct`
// start null and are filled when the target year is observed.
// ══════════════════════════════════════════════════════════════════════════

enum ForecastKind {
  DEMAND
  SUPPLY
}

model ForecastRun {
  id                 String       @id @default(cuid())
  kind               ForecastKind
  // Subject of the forecast — e.g., occupation code, skill id, program id.
  subjectType        String       @map("subject_type")
  subjectId          String       @map("subject_id")
  region             String       @default("TH")
  targetYear         Int          @map("target_year")
  projectedValue     Float        @map("projected_value")
  ci50Low            Float?       @map("ci_50_low")
  ci50High           Float?       @map("ci_50_high")
  ci80Low            Float?       @map("ci_80_low")
  ci80High           Float?       @map("ci_80_high")
  ci95Low            Float?       @map("ci_95_low")
  ci95High           Float?       @map("ci_95_high")
  actualValue        Float?       @map("actual_value")
  errorPct           Float?       @map("error_pct")
  methodologyVersion String       @default("forecasting.v1") @map("methodology_version")
  notes              String?      @db.Text
  runAt              DateTime     @default(now()) @map("run_at")

  @@index([kind])
  @@index([subjectType, subjectId])
  @@index([region])
  @@index([targetYear])
  @@map("forecast_runs")
}

// ══════════════════════════════════════════════════════════════════════════
// Competitive Benchmarking (prompt 10)
//
// Peers live in `peer_programs` already (prompt 01). This module adds:
//   - PeerSet: named, re-usable peer collections (Thai top-10, ASEAN,
//     Global subject leaders, Custom). `isSystem=true` = seeded + read-only.
//   - PeerSetMember: join table with per-peer analyst notes.
//   - PeerProgramSkill: which skills each peer program teaches — enables
//     skill-coverage comparison against KKU's ProgramSkill.
//   - PeerRanking: THE/QS/SCImago rankings by year + subject. Lets the
//     subject-leadership view plot a trend line without joining across
//     multiple sources per metric.
// ══════════════════════════════════════════════════════════════════════════

model PeerSet {
  id            String   @id @default(cuid())
  name          String
  descriptionTh String?  @map("description_th") @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  // System sets (seeded) vs user-created custom sets.
  isSystem      Boolean  @default(false) @map("is_system")
  // Optional subject area for subject-specific peer sets.
  subjectArea   String?  @map("subject_area")
  // Region tag for filtering: TH | ASEAN | GLOBAL | CUSTOM.
  region        String   @default("CUSTOM")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  creator User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  members PeerSetMember[]

  @@index([isSystem])
  @@index([region])
  @@index([subjectArea])
  @@map("peer_sets")
}

model PeerSetMember {
  id            String   @id @default(cuid())
  peerSetId     String   @map("peer_set_id")
  peerProgramId String   @map("peer_program_id")
  // Analyst-editable note: "apples-to-oranges because different credit system"
  noteTh        String?  @map("note_th") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  peerSet     PeerSet     @relation(fields: [peerSetId], references: [id], onDelete: Cascade)
  peerProgram PeerProgram @relation(fields: [peerProgramId], references: [id], onDelete: Cascade)

  @@unique([peerSetId, peerProgramId])
  @@index([peerSetId])
  @@index([peerProgramId])
  @@map("peer_set_members")
}

model PeerProgramSkill {
  id            String      @id @default(cuid())
  peerProgramId String      @map("peer_program_id")
  skillId       String      @map("skill_id")
  weight        Float       @default(1.0)
  source        SkillSource @default(LLM_EXTRACTED)
  confidence    Float?
  createdAt     DateTime    @default(now()) @map("created_at")

  peerProgram PeerProgram @relation(fields: [peerProgramId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([peerProgramId, skillId])
  @@index([peerProgramId])
  @@index([skillId])
  @@map("peer_program_skills")
}

model PeerRanking {
  id            String   @id @default(cuid())
  institution   String
  // Free-text source identifier: 'THE' | 'QS' | 'SCImago' | 'custom'.
  source        String
  // Free-text subject area — empty for overall (university) rankings.
  subjectArea   String?  @map("subject_area")
  year          Int
  rank          Int
  // Percentile within the ranked cohort (0–100). Optional — some sources
  // only publish the rank.
  percentile    Float?
  url           String?
  freshnessDate DateTime @map("freshness_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([institution, source, subjectArea, year])
  @@index([institution])
  @@index([source])
  @@index([subjectArea])
  @@index([year])
  @@map("peer_rankings")
}

// ══════════════════════════════════════════════════════════════════════════
// AI Analyst (prompt 11) — conversational layer
//
// One AnalystConversation per threaded chat. AnalystMessage is the
// audit-grade turn-by-turn record (one row per user message + one per
// assistant final turn); the full tool-use trace is captured in
// `evidenceJson` and each AiInference row referenced by
// `aiInferenceIds` is the authoritative LLM call log.
//
// AnalystFeedback is thumbs-up/down + optional correction text per
// assistant message. Used to surface bad answers for analyst review
// and to feed a future fine-tune loop.
// ══════════════════════════════════════════════════════════════════════════

enum AnalystMessageRole {
  USER
  ASSISTANT
}

// Discriminates which assistant flavour produced the conversation.
//
// STRATEGIC — the Council-facing /analyst. Full tool catalog (programs,
// scenarios, peers, trends, risks). System prompt frames the assistant
// as a strategic advisor.
// DASHBOARD — the operational /analyst/dashboards (and the in-page side
// panel on Education + Staff). Narrower tool catalog scoped to the
// Education + Staff dashboard surfaces. System prompt steers strategic
// questions back to /analyst.
//
// Kept as a separate enum (not a free-text tag) so the conversation
// list queries can filter on a B-tree index without LIKE scans.
enum AnalystConversationKind {
  STRATEGIC
  DASHBOARD
}

model AnalystConversation {
  id           String                  @id @default(cuid())
  userId       String                  @map("user_id")
  // Which assistant flavour this conversation belongs to. Defaults to
  // STRATEGIC for back-compat with rows created before the column landed.
  kind         AnalystConversationKind @default(STRATEGIC)
  title        String
  // Running summary of pruned-away older turns, so the agent has memory
  // even after we truncate messages outside the sliding window.
  summaryTh    String?                 @map("summary_th") @db.Text
  summaryEn    String?                 @map("summary_en") @db.Text
  // Language detected from the first user turn ('th' | 'en'). Used to
  // pick system-prompt flavour; not sticky per-message.
  language     String                  @default("en")
  messageCount Int                     @default(0) @map("message_count")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AnalystMessage[]

  @@index([userId])
  @@index([updatedAt])
  // List-query path: WHERE userId = ? AND kind = ? ORDER BY updatedAt DESC.
  @@index([userId, kind, updatedAt])
  @@map("analyst_conversations")
}

model AnalystMessage {
  id              String             @id @default(cuid())
  conversationId  String             @map("conversation_id")
  role            AnalystMessageRole
  content         String             @db.Text
  // Full tool-use trace: the array of ToolUseMessage from the engine.
  // Kept as JSON so the evidence panel can render tool calls + results.
  toolCallsJson   Json?              @map("tool_calls_json")
  // Pre-computed "evidence" payload for the side panel — tool calls +
  // data previews + confidence per sub-claim.
  evidenceJson    Json?              @map("evidence_json")
  // Each LLM invocation during a tool-use loop produces one AiInference
  // row; this array stitches them all back together for audit.
  aiInferenceIds  String[]           @map("ai_inference_ids")
  stopReason      String?            @map("stop_reason")
  tokensInput     Int?               @map("tokens_input")
  tokensOutput    Int?               @map("tokens_output")
  costEstimateUsd Float?             @map("cost_estimate_usd")
  latencyMs       Int?               @map("latency_ms")
  refused         Boolean            @default(false)
  createdAt       DateTime           @default(now()) @map("created_at")

  conversation AnalystConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     AnalystFeedback[]

  @@index([conversationId, createdAt])
  @@index([role])
  @@map("analyst_messages")
}

model AnalystFeedback {
  id         String   @id @default(cuid())
  messageId  String   @map("message_id")
  userId     String   @map("user_id")
  // 'up' | 'down'
  vote       String
  correction String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  message AnalystMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
  @@map("analyst_feedback")
}

// ══════════════════════════════════════════════════════════════════════════
// Connector bridge tables
// ══════════════════════════════════════════════════════════════════════════

// Bridge between the KKU Registrar's Oracle views (denormalised, text
// keys only — no stable program code) and our Program rows.
//
// The registrar exposes student rows annotated with FACULTYNAME +
// PROGRAMNAME + PROGRAMLEVEL + MAJOR (all Thai text). We need to roll
// each row up to the right Program.id at load time. Rather than fuzzy-
// match, we keep an explicit allowlist here. An admin (or a one-off
// seed script) populates this table once per program; future ingestion
// runs do an exact-tuple lookup.
//
// `registry_major` is `''` when the source PROGRAMNAME has no major
// (most undergrad programs). The unique constraint then collapses two
// "no-major" rows for the same program — required because Postgres
// treats NULLs as distinct in unique indexes by default and we want
// the empty case to still de-duplicate.
//
// Rows fetched from the registrar that do not match any mapping land
// in IngestionRun.metadata.unmappedSamples[] for the analyst on duty
// to triage. Once a mapping is added, the next run picks it up.
model RegistryProgramMapping {
  id                  String    @id @default(cuid())
  registryFacultyName String    @map("registry_faculty_name") @db.Text
  registryProgramName String    @map("registry_program_name") @db.Text
  registryLevel       String    @map("registry_level")
  registryMajor       String    @default("") @map("registry_major") @db.Text
  programId           String    @map("program_id")
  notes               String?   @db.Text
  confirmedBy         String?   @map("confirmed_by")
  confirmedAt         DateTime? @map("confirmed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([registryFacultyName, registryProgramName, registryLevel, registryMajor])
  @@index([programId])
  @@map("registry_program_mappings")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR org bridge — used by the kku-hr connector. HCMEmployee uses 5-digit
// numeric BU codes (e.g., "07000" = Faculty of Medicine; "07408" = a
// department under it). Our Faculty/Department FKs need an explicit
// allowlist; same pattern as RegistryProgramMapping (no fuzzy match).
//
// hrCode is the BU code from HCMEmployee.BU1/BU2/BU3. Each row resolves
// it to either a Faculty (if hrCode is a faculty-level code) or a
// Department (if hrCode is a department-level code) — never both.
// hrLabelTh is the human-readable label from epm_report.dbo.Faculty
// (`code - ชื่อ`) for analyst reference.
//
// hrOrgKind discriminates the row's purpose:
//   FACULTY    — hrCode resolves to a Faculty (facultyId required)
//   DEPARTMENT — hrCode resolves to a Department (departmentId required)
//
// Codes that have no KKU equivalent (hospital sub-units, central admin
// offices) get isResolved=false rows so the analyst can confirm "this
// is intentionally unmapped" rather than "we forgot it".
model HrOrgMapping {
  id           String    @id @default(cuid())
  hrCode       String    @unique @map("hr_code")
  hrLabelTh    String?   @map("hr_label_th") @db.Text
  hrOrgKind    HrOrgKind @map("hr_org_kind")
  facultyId    String?   @map("faculty_id")
  departmentId String?   @map("department_id")
  isResolved   Boolean   @default(true) @map("is_resolved")
  notes        String?   @db.Text
  confirmedBy  String?   @map("confirmed_by")
  confirmedAt  DateTime? @map("confirmed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([facultyId])
  @@index([departmentId])
  @@index([hrOrgKind])
  @@map("hr_org_mappings")
}

enum HrOrgKind {
  FACULTY
  DEPARTMENT
  UNRESOLVED
}

// ─────────────────────────────────────────────────────────────────────────────
// Aggregate compensation per (faculty × department × rank × year) from
// the kku-hr connector. Server-side GROUP BY in HR Q2 ensures no per-
// person salary ever crosses the wire. HEADCOUNT < 5 cells are
// suppressed at the source (HAVING COUNT(*) >= 5).
//
// Used by the cost-allocation methodology — see
// docs/methodologies/cost-allocation.md. Until KKU-Finance lands, this
// is the only authoritative source of academic-payroll information.
model FacultyCompensation {
  id                 String      @id @default(cuid())
  facultyId          String      @map("faculty_id")
  departmentId       String?     @map("department_id")
  rank               FacultyRank
  fiscalYear         Int         @map("fiscal_year")
  headcount          Int
  sumSalary          Decimal     @map("sum_salary") @db.Decimal(14, 2)
  meanSalary         Decimal     @map("mean_salary") @db.Decimal(14, 2)
  minSalary          Decimal     @map("min_salary") @db.Decimal(14, 2)
  maxSalary          Decimal     @map("max_salary") @db.Decimal(14, 2)
  freshnessDate      DateTime    @map("freshness_date") @db.Date
  methodologyVersion String      @default("kku-hr.v1") @map("methodology_version")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  ingestionRunId     String?     @map("ingestion_run_id")

  faculty      Faculty       @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([facultyId, departmentId, rank, fiscalYear])
  @@index([facultyId])
  @@index([fiscalYear])
  @@index([ingestionRunId])
  @@map("faculty_compensation")
}

// ─────────────────────────────────────────────────────────────────────────────
// Raw budget allocation per (division × fund × fiscal year) from the
// kku-finance connector's Q2 (MSSQL ERPPowerBI.BudgetData). Stored at
// the division level — does NOT cascade to programs (that's the
// cost-allocation methodology layer downstream).
//
// `facultyId` is nullable: divisions that aren't faculties (central
// admin, external research centres) get null but are still tracked so
// total spend reconciles. `divisionName` preserves the original
// (un-stripped) division name for transparency on hospital sub-units.
//
// `fundCategory` is the revenue-source split — values like
// `งบประมาณเงินรายได้` (university revenue) vs `งบประมาณเงินอุดหนุนจากรัฐ`
// (government subsidy). The 75/25 mix is a non-trivial Council talking
// point.
//
// `BudgetData` upstream is current-year-only; each ingestion run
// over-writes the latest snapshot for the same (division, fund, year)
// tuple via the unique constraint.
model FacultyBudget {
  id                 String   @id @default(cuid())
  facultyId          String?  @map("faculty_id")
  divisionName       String   @map("division_name") @db.Text
  fundCategory       String   @map("fund_category")
  /// This one IS a true fiscal year (Oct-Sep), sourced from BudgetData's
  /// FISCAL_YEAR_BE column (kku-finance/connector.ts). Do NOT confuse with
  /// FinancialMetric.fiscalYear above, which shares this exact column name
  /// but actually holds an ACADEMIC year (Jun-May) — the two columns are
  /// on different calendars despite the identical name and must not be
  /// treated as the same axis.
  fiscalYear         Int      @map("fiscal_year")
  snapshotName       String?  @map("snapshot_name")
  totalBudget        Decimal  @map("total_budget") @db.Decimal(16, 2)
  totalCommitment    Decimal  @default(0) @map("total_commitment") @db.Decimal(16, 2)
  totalObligation    Decimal  @default(0) @map("total_obligation") @db.Decimal(16, 2)
  totalExpenditure   Decimal  @default(0) @map("total_expenditure") @db.Decimal(16, 2)
  fundsAvailable     Decimal  @default(0) @map("funds_available") @db.Decimal(16, 2)
  freshnessDate      DateTime @map("freshness_date") @db.Date
  methodologyVersion String   @default("kku-finance.v1") @map("methodology_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  ingestionRunId     String?  @map("ingestion_run_id")

  faculty      Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([divisionName, fundCategory, fiscalYear])
  @@index([facultyId])
  @@index([fiscalYear])
  @@index([ingestionRunId])
  @@map("faculty_budgets")
}

// ─────────────────────────────────────────────────────────────────────────────
// KMITL Skill Mapping — replaces the original jobthai + jobsdb plan. KMITL
// exposes aggregated skill-demand intelligence (LinkedIn profiles + job
// postings + grad data, processed by them) at career/group/sub-group level.
// We store dedicated tables rather than overloading OccupationDemand because
// (a) KMITL careers aren't ISCO-08 codes, (b) values are percentages not
// counts, (c) data lineage stays obvious for the Council provenance drawer.
// ─────────────────────────────────────────────────────────────────────────────

enum KmitlDataScope {
  GLOBAL
  THAILAND

  @@map("kmitl_data_scope")
}

enum KmitlDemandSource {
  PROFILES
  JOB_POSTINGS

  @@map("kmitl_demand_source")
}

// Taxonomy mirror — captures KMITL's group → sub_group → career hierarchy.
// `iscoCode` is null on first ingest; analysts hand-map over time so the
// kmitl careers can roll up into our existing OccupationDemand world if
// downstream consumers need it. `kmitlCareerId` is the stable upstream id.
model KmitlCareer {
  id                 String   @id @default(cuid())
  kmitlCareerId      Int      @unique @map("kmitl_career_id")
  kmitlGroupId       Int      @map("kmitl_group_id")
  kmitlSubGroupId    Int      @map("kmitl_sub_group_id")
  groupName          String   @map("group_name")
  subGroupName       String   @map("sub_group_name")
  careerName         String   @map("career_name")
  iscoCode           String?  @map("isco_code")
  freshnessDate      DateTime @map("freshness_date") @db.Date
  methodologyVersion String   @default("kmitl-skill-mapping.v1") @map("methodology_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  ingestionRunId     String?  @map("ingestion_run_id")

  skillDemands KmitlCareerSkillDemand[]
  ingestionRun IngestionRun?            @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@index([kmitlGroupId, kmitlSubGroupId])
  @@index([ingestionRunId])
  @@map("kmitl_careers")
}

// Fact table: per-career, per-skill, per-scope, per-source, latest snapshot.
// Re-runs overwrite on the unique key so we keep one current row per tuple.
// Time-series of demand percentages comes from KMITL's own
// `skills_growth_overview` (→ KmitlSkillGrowth).
//
// `skillId` is nullable because KMITL's free-text skill names don't always
// resolve to our Skill table on first pass; unmatched rows still land with
// `skillNameRaw` populated, surfaced via IngestionRun.metadata for triage
// (same pattern as kku-finance unmapped divisions, kku-research unmatched
// authors).
//
// `metadata` JSONB holds the `industries_overview` + `universities_overview`
// snippets that share the same parent payload as the skill demand. Promote
// to dedicated tables if downstream consumers need them.
model KmitlCareerSkillDemand {
  id                 String            @id @default(cuid())
  careerId           String            @map("career_id")
  kmitlCareerId      Int               @map("kmitl_career_id")
  skillId            String?           @map("skill_id")
  skillNameRaw       String            @map("skill_name_raw")
  dataScope          KmitlDataScope    @map("data_scope")
  dataSource         KmitlDemandSource @map("data_source")
  amount             Int               @default(0)
  percentage         Float             @default(0)
  snapshotAt         DateTime          @map("snapshot_at") @db.Date
  freshnessDate      DateTime          @map("freshness_date") @db.Date
  metadata           Json?
  methodologyVersion String            @default("kmitl-skill-mapping.v1") @map("methodology_version")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  ingestionRunId     String?           @map("ingestion_run_id")

  career       KmitlCareer   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill        Skill?        @relation(fields: [skillId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([kmitlCareerId, skillNameRaw, dataScope, dataSource])
  @@index([careerId])
  @@index([skillId])
  @@index([dataScope, dataSource])
  @@index([snapshotAt])
  @@index([ingestionRunId])
  @@map("kmitl_career_skill_demands")
}

// Skill growth trend snapshot — captured at multiple context levels:
// 'group', 'sub_group', or 'career'. Each level stores its own row so the
// Cockpit + Gap Analyzer can pick the granularity they need without
// re-deriving from the demand fact table.
model KmitlSkillGrowth {
  id                 String         @id @default(cuid())
  skillId            String?        @map("skill_id")
  skillNameRaw       String         @map("skill_name_raw")
  contextLevel       String         @map("context_level")
  contextId          Int            @map("context_id")
  contextName        String         @map("context_name")
  dataScope          KmitlDataScope @map("data_scope")
  growthPct          Float          @map("growth_pct")
  snapshotAt         DateTime       @map("snapshot_at") @db.Date
  methodologyVersion String         @default("kmitl-skill-mapping.v1") @map("methodology_version")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  ingestionRunId     String?        @map("ingestion_run_id")

  skill        Skill?        @relation(fields: [skillId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([contextLevel, contextId, skillNameRaw, dataScope])
  @@index([skillId])
  @@index([snapshotAt])
  @@index([ingestionRunId])
  @@map("kmitl_skill_growths")
}

// ─────────────────────────────────────────────────────────────────────
// Education dashboard cubes — pre-aggregated student/finance roll-ups
// drawn from the KKU Registrar Oracle warehouse (POWERBI views). Each
// cube is wiped + re-inserted on every refresh; no per-student rows
// ever land here. Refresh is operator-triggered (manual fetch button)
// rather than nightly cron — see EducationCubeRefresh for run logs.
// ─────────────────────────────────────────────────────────────────────

model EducationStudentCube {
  id              String   @id @default(cuid())
  facultyName     String   @map("faculty_name")
  programLevel    String   @map("program_level")
  programName     String   @map("program_name")
  major           String?  @map("major")
  majorNorm       String   @default("") @map("major_norm")
  cohortYearBe    Int      @map("cohort_year_be")
  statusCode      Int      @map("status_code")
  statusName      String?  @map("status_name")
  gender          String?  @map("gender")
  genderNorm      String   @default("") @map("gender_norm")
  nationality     String?  @map("nationality")
  nationalityNorm String   @default("") @map("nationality_norm")
  isThai          Boolean  @map("is_thai")
  entryType       String?  @map("entry_type")
  entryTypeNorm   String   @default("") @map("entry_type_norm")
  studentCount    Int      @map("student_count")
  // Age aggregation — sum of student ages in the 16-80 range, plus
  // the count of valid ages used. Average = ageSum / ageCount;
  // out-of-range and missing birthdates are excluded from both.
  ageSum          Int      @default(0) @map("age_sum")
  ageCount        Int      @default(0) @map("age_count")
  refreshedAt     DateTime @map("refreshed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([facultyName, programLevel, programName, majorNorm, cohortYearBe, statusCode, genderNorm, nationalityNorm, isThai, entryTypeNorm], name: "edu_student_cube_natural_key")
  @@index([statusCode])
  @@index([cohortYearBe])
  @@index([facultyName])
  @@index([programLevel])
  @@map("education_student_cube")
}

model EducationStudentLocationCube {
  id                 String   @id @default(cuid())
  facultyName        String   @map("faculty_name")
  programLevel       String   @map("program_level")
  programName        String   @map("program_name")
  cohortYearBe       Int      @map("cohort_year_be")
  schoolName         String?  @map("school_name")
  schoolNameNorm     String   @default("") @map("school_name_norm")
  schoolProvinceName String?  @map("school_province_name")
  schoolProvinceNorm String   @default("") @map("school_province_norm")
  thaiRegion         String?  @map("thai_region")
  statusCode         Int      @map("status_code")
  studentCount       Int      @map("student_count")
  refreshedAt        DateTime @map("refreshed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([facultyName, programLevel, programName, cohortYearBe, schoolNameNorm, schoolProvinceNorm, statusCode], name: "edu_student_location_cube_natural_key")
  @@index([cohortYearBe])
  @@index([thaiRegion])
  @@index([facultyName])
  @@map("education_student_location_cube")
}

model EducationTuitionCube {
  id             String   @id @default(cuid())
  facultyName    String   @map("faculty_name")
  programLevel   String   @map("program_level")
  programName    String   @map("program_name")
  academicYearBe Int      @map("academic_year_be")
  semester       String   @map("semester")
  revenueThb     Decimal  @map("revenue_thb") @db.Decimal(18, 2)
  studentCount   Int      @map("student_count")
  refreshedAt    DateTime @map("refreshed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([facultyName, programLevel, programName, academicYearBe, semester], name: "edu_tuition_cube_natural_key")
  @@index([academicYearBe])
  @@index([facultyName])
  @@map("education_tuition_cube")
}

// Per-school undergraduate performance — each row is one
// (faculty × program × school × province × region × status) bucket.
// Source: VIEW_STUDENT_DETAIL (current students only). GPA columns
// are stored as cumulative sums + counts so the dashboards can take
// a weighted mean across any filter without re-scanning the source.
model EducationPerformanceCube {
  id                 String   @id @default(cuid())
  facultyName        String   @map("faculty_name")
  programLevel       String   @map("program_level")
  programName        String   @map("program_name")
  schoolName         String?  @map("school_name")
  schoolNameNorm     String   @default("") @map("school_name_norm")
  schoolProvinceName String?  @map("school_province_name")
  schoolProvinceNorm String   @default("") @map("school_province_norm")
  thaiRegion         String?  @map("thai_region")
  statusName         String?  @map("status_name")
  statusNameNorm     String   @default("") @map("status_name_norm")
  studentCount       Int      @map("student_count")
  // Cumulative GPA aggregates — average = sum / count.
  entryGpaSum        Float    @default(0) @map("entry_gpa_sum")
  entryGpaCount      Int      @default(0) @map("entry_gpa_count")
  gpaSum             Float    @default(0) @map("gpa_sum")
  gpaCount           Int      @default(0) @map("gpa_count")
  englishGpaSum      Float    @default(0) @map("english_gpa_sum")
  englishGpaCount    Int      @default(0) @map("english_gpa_count")
  refreshedAt        DateTime @map("refreshed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([facultyName, programLevel, programName, schoolNameNorm, schoolProvinceNorm, statusNameNorm], name: "edu_performance_cube_natural_key")
  @@index([facultyName])
  @@index([programLevel])
  @@index([thaiRegion])
  @@map("education_performance_cube")
}

// Per-subject entry test scores. Source: AVSREG.VIEW_STUDENT_SCORE.
// Joined with VIEW_STUDENT_DETAIL on STUDENTCODE so each row carries
// faculty + program metadata. Cumulative sum + count for averaging.
model EducationEntryScoreCube {
  id           String   @id @default(cuid())
  facultyName  String   @map("faculty_name")
  programLevel String   @map("program_level")
  programName  String   @map("program_name")
  subjectCode  String   @map("subject_code")
  subjectName  String?  @map("subject_name")
  studentCount Int      @map("student_count")
  scoreSum     Float    @default(0) @map("score_sum")
  scoreCount   Int      @default(0) @map("score_count")
  scoreMin     Float?   @map("score_min")
  scoreMax     Float?   @map("score_max")
  refreshedAt  DateTime @map("refreshed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([facultyName, programLevel, programName, subjectCode], name: "edu_entry_score_cube_natural_key")
  @@index([facultyName])
  @@index([subjectCode])
  @@map("education_entry_score_cube")
}

model EducationCubeRefresh {
  id                String    @id @default(cuid())
  cubeName          String    @map("cube_name")
  status            String    @map("status")
  startedAt         DateTime  @map("started_at")
  completedAt       DateTime? @map("completed_at")
  recordsLoaded     Int?      @map("records_loaded")
  durationMs        Int?      @map("duration_ms")
  triggeredByUserId String?   @map("triggered_by_user_id")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([cubeName, startedAt])
  @@index([status])
  @@map("education_cube_refresh")
}

// ─── Class offerings (POWERBI.VIEW_CLASS_OPEN_GROUP_OFFICER) ────────────
//
// One row per CLASSID = one course-section opened in a given
// (academic year, semester). The view is the registrar's authoritative
// list of every class taught + the staff who taught it. Two dashboards
// consume this table:
//   - /education/class-offerings — seat fulfilment + course catalogue
//   - /staff/teaching-workload   — contact hours per teacher
//
// Faculty attribution is direct (`registryFacultyId` + `facultyName`
// from the view, resolved to `facultyId` by Thai-name exact-match
// against Faculty.nameTh at insert time). Garbage rows (LEVELNAME
// 'ทดสอบ'/'ไม่กำหนด', FACULTYNAME 'ข้อมูลเดิม', test course codes)
// are filtered out by the connector. Refreshed by
// `pnpm programs:link-class-offerings` — idempotent full-replace.
//
// Program attribution is many-to-many through `program_courses` —
// a course can appear in multiple curricula. Resolve at query time.
model ClassOffering {
  id                  String   @id @default(cuid())
  /// Buddhist-Era academic year (e.g., 2568).
  acadYearBE          Int      @map("acad_year_be")
  /// 1, 2 = main terms; 3, 4 = summer/special terms.
  semester            Int
  /// Whitespace-stripped, upper-cased course code (e.g., "EN241100").
  /// `courseCodeRaw` keeps the registrar's original form for audit.
  courseCode          String   @map("course_code")
  courseCodeRaw       String   @map("course_code_raw")
  courseNameTh        String?  @map("course_name_th")
  courseNameEn        String?  @map("course_name_en")
  /// Section / group number within a course in a semester.
  section             Int
  /// Registrar's natural key — unique across the entire view.
  classId             BigInt   @unique @map("class_id")
  /// `CREDITTOTAL` — total credits the course is worth.
  creditTotal         Int?     @map("credit_total")
  /// Raw `COURSEUNIT` string, e.g., "3 (2-2-5)" = A (B-C-D) where
  /// A=credits, B=lecture-hrs/wk, C=lab-hrs/wk, D=self-study-hrs/wk.
  courseUnit          String?  @map("course_unit")
  /// Parsed B = lecture contact hours per week. Drives teacher workload.
  lectureHrsPerWeek   Int?     @map("lecture_hrs_per_week")
  /// Parsed C = lab contact hours per week. Drives teacher workload.
  labHrsPerWeek       Int?     @map("lab_hrs_per_week")
  /// Students currently enrolled in this section.
  enrollSeat          Int      @map("enroll_seat")
  /// Section capacity (max students that can register).
  totalSeat           Int      @map("total_seat")
  /// LEVELNAME = "ปริญญาตรี" / "ปริญญาโท" / etc. Already filtered
  /// to drop test/unspecified values at connector time.
  levelName           String   @map("level_name")
  /// Raw FACULTYID from the registrar's view (numeric string).
  registryFacultyId   String   @map("registry_faculty_id")
  /// Raw FACULTYNAME from the registrar's view (Thai).
  registryFacultyName String   @map("registry_faculty_name")
  /// Resolved FK to our Faculty model. Null when the registrar's
  /// faculty name doesn't match any seeded Faculty.nameTh (analyst
  /// reconciliation worklist).
  facultyId           String?  @map("faculty_id")
  /// True when the course is general-education: starts with `00`
  /// (legacy numeric GE) or `GE` (current GE codes), or the owning
  /// registry faculty is the GE Institute or Language Institute.
  isGeneralEducation  Boolean  @default(false) @map("is_general_education")
  descriptionTh       String?  @map("description_th") @db.Text
  descriptionEn       String?  @map("description_en") @db.Text
  // ── Grade distribution (added 2026-05-19) ───────────────────────────
  // Per-letter counts pulled from VIEW_CLASS_OPEN_GROUP_OFFICER columns
  // A / BPLUS / B / CPLUS / C / DPLUS / D / F (the 8 graded letters that
  // weight into GPA) and I / W / AU / S (non-graded — excluded from GPA).
  // All default 0 so older rows pre-grade-feature stay consistent;
  // `gradedCount = sum of 8 graded letters`, `classGpa = NULL` when
  // gradedCount=0 (current term in progress or pass/fail course).
  // KKU 4.0 weights: A=4.0, B+=3.5, B=3.0, C+=2.5, C=2.0, D+=1.5, D=1.0, F=0.
  gradeA              Int      @default(0) @map("grade_a")
  gradeBPlus          Int      @default(0) @map("grade_b_plus")
  gradeB              Int      @default(0) @map("grade_b")
  gradeCPlus          Int      @default(0) @map("grade_c_plus")
  gradeC              Int      @default(0) @map("grade_c")
  gradeDPlus          Int      @default(0) @map("grade_d_plus")
  gradeD              Int      @default(0) @map("grade_d")
  gradeF              Int      @default(0) @map("grade_f")
  gradeI              Int      @default(0) @map("grade_i")
  gradeW              Int      @default(0) @map("grade_w")
  gradeAU             Int      @default(0) @map("grade_au")
  gradeS              Int      @default(0) @map("grade_s")
  /// Sum of the 8 graded letters — denominator for class_gpa.
  gradedCount         Int      @default(0) @map("graded_count")
  /// Weighted mean of letter grades on the KKU 4.0 scale, precomputed
  /// at ingestion. NULL when gradedCount = 0 (term in progress, or
  /// course is pass/fail-only with all S/AU). 0.0 is a legitimate value
  /// (everyone failed) and must not be substituted for null.
  classGpa            Float?   @map("class_gpa")
  refreshedAt         DateTime @default(now()) @updatedAt @map("refreshed_at")
  ingestionRunId      String?  @map("ingestion_run_id")

  faculty             Faculty?                    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  ingestionRun        IngestionRun?               @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  teachers            ClassOfferingTeacher[]
  evaluationResponses EvaluationResponseSummary[]

  @@index([facultyId, acadYearBE, semester])
  @@index([acadYearBE, semester])
  @@index([courseCode])
  @@index([levelName])
  @@index([isGeneralEducation, acadYearBE, semester])
  @@index([ingestionRunId])
  /// Drives the /education/performance class-GPA trend query — fans by
  /// (faculty × year × sem) and reads classGpa + gradedCount + creditTotal.
  /// Partial-style index covering only graded rows would be cheaper but
  /// Prisma can't express that yet; the predicate ON classGpa IS NOT NULL
  /// at query time keeps the inverted-bitmap scan small.
  @@index([acadYearBE, semester, facultyId, classGpa])
  @@map("class_offerings")
}

// Per-teacher attribution for a class offering. One row per (CLASSID ×
// distinct KKUMAIL email). KKUMAIL is a comma-separated list with
// historical duplicates — the connector takes distinct values per
// CLASSID before inserting here.
//
// All teachers on a team-taught course receive the FULL workload per
// KKU teaching-credit policy (the registrar's representation matches
// this — every co-teacher appears as one of the comma-separated
// emails, and we treat each as fully responsible).
//
// `facultyMemberId` is a soft FK — resolved against `FacultyMember.
// kkuEmail` (lowercased exact match) at connector time. Null when the
// email doesn't match any active staff (external lecturers, retired
// staff, HCM-not-yet-ingested) — surfaces as the "unresolved teachers"
// row on the workload dashboard for analyst follow-up.
model ClassOfferingTeacher {
  id              String   @id @default(cuid())
  classOfferingId String   @map("class_offering_id")
  /// Lowercased KKU work email from KKUMAIL (e.g., "nattee@kku.ac.th").
  kkuEmail        String   @map("kku_email")
  facultyMemberId String?  @map("faculty_member_id")
  createdAt       DateTime @default(now()) @map("created_at")

  classOffering ClassOffering  @relation(fields: [classOfferingId], references: [id], onDelete: Cascade)
  facultyMember FacultyMember? @relation(fields: [facultyMemberId], references: [id], onDelete: SetNull)

  @@unique([classOfferingId, kkuEmail])
  @@index([facultyMemberId])
  @@index([kkuEmail])
  @@map("class_offering_teachers")
}

// ══════════════════════════════════════════════════════════════════════════
// Student evaluations on teaching & learning (POWERBI.EVALUATE_INSTRUCTOR)
// ══════════════════════════════════════════════════════════════════════════
//
// Two tables work together:
//   - evaluation_questions          — canonical question catalog with
//                                     drift detection (TH text + AI-EN)
//   - evaluation_response_summaries — pre-aggregated cell per
//                                     (class × question × instructor)
//
// PDPA gate: the connector applies a server-side `HAVING TOTAL_STUDENT >= 5`
// clause so no per-student data ever lands in our DB. Cells with fewer
// than 5 respondents are dropped at source.

model EvaluationQuestion {
  id                     String    @id @default(cuid())
  /// Registrar's QUESTIONID — zero-padded text e.g. "01"…"40".
  /// The registrar reuses the same id across years; text drifts
  /// occasionally — `questionTextHash` discriminates versions.
  questionIdRegistrar    String    @map("question_id_registrar")
  questionTextTh         String    @map("question_text_th") @db.Text
  /// AI-translated English (evaluation-question-translate.v1).
  /// Watermark in UI: "(EN — AI translation, pending review)".
  /// Null = not yet translated; populate via
  /// `pnpm evaluations:translate-questions`.
  questionTextEn         String?   @map("question_text_en") @db.Text
  /// DEAN / ADMIN-curated override. UI prefers this over `questionTextEn`
  /// when present. Same text length budget as the Thai source.
  questionTextEnOverride String?   @map("question_text_en_override") @db.Text
  /// SHA-256 prefix of `questionTextTh` (16-char hex). Two rows with the
  /// same `questionIdRegistrar` but different hashes are different
  /// versions of the same question — kept separate so audit history
  /// survives drift.
  questionTextHash       String    @map("question_text_hash")
  /// Analyst-curated theme: "active-learning" | "ethics" | "assessment"
  /// | "feedback" | "content-design" | "english-skills" | ""
  themeTag               String?   @map("theme_tag")
  firstSeenYearBE        Int       @map("first_seen_year_be")
  lastSeenYearBE         Int       @map("last_seen_year_be")
  /// Count of distinct (acadYear × semester) buckets the question
  /// appears in. Used to classify "core / extended / recent /
  /// specialized" without a separate enum.
  semestersUsed          Int       @map("semesters_used")
  /// True when the question is present in every observed (year,sem)
  /// bucket. Derived at ingestion time.
  isCore                 Boolean   @default(false) @map("is_core")
  methodologyVersion     String    @default("kku-evaluations.v1") @map("methodology_version")
  translatedAt           DateTime? @map("translated_at")
  translationModel       String?   @map("translation_model")
  ingestionRunId         String?   @map("ingestion_run_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  ingestionRun IngestionRun?               @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  responses    EvaluationResponseSummary[]

  @@unique([questionIdRegistrar, questionTextHash])
  @@index([questionIdRegistrar])
  @@index([isCore])
  @@index([ingestionRunId])
  @@map("evaluation_questions")
}

model EvaluationResponseSummary {
  id         String @id @default(cuid())
  acadYearBE Int    @map("acad_year_be")
  semester   Int

  // ── Resolved foreign keys (nullable — best-effort resolution) ───────
  /// Joined via ClassOffering.facultyId (same CLASSID).
  facultyId       String? @map("faculty_id")
  /// Joined via ClassOffering.classId == classIdRegistrar.
  classOfferingId String? @map("class_offering_id")
  /// Joined via FacultyMember.kkuEmail (lowercased) == kkumail.
  facultyMemberId String? @map("faculty_member_id")
  /// FK to EvaluationQuestion (resolved at ingest time by
  /// `(questionIdRegistrar, questionTextHash)`).
  questionId      String? @map("question_id")

  // ── Registrar's natural keys (raw, retained for audit) ──────────────
  facultyRegistryId   Int    @map("faculty_registry_id")
  classIdRegistrar    BigInt @map("class_id_registrar")
  officerIdRegistrar  Int    @map("officer_id_registrar")
  questionIdRegistrar String @map("question_id_registrar")

  // ── Denormalized for fast filter without joins ──────────────────────
  courseCode    String  @map("course_code")
  courseCodeRaw String  @map("course_code_raw")
  courseNameTh  String? @map("course_name_th")
  courseNameEn  String? @map("course_name_en")
  section       Int
  campusId      Int     @map("campus_id")
  /// Retained when facultyMemberId can't resolve — operators see who
  /// the registrar credited the score to even if we can't pin them.
  kkumailRaw    String? @map("kkumail_raw")

  // ── Aggregate metrics ───────────────────────────────────────────────
  /// 0.000–5.000 — Thai 1-5 likert mean from POWERBI POINT_AVG.
  /// Stored as Decimal so the round-trip preserves 2-3 decimal places.
  ratingAvg       Decimal   @map("rating_avg") @db.Decimal(4, 3)
  /// ≥ 5 by construction (server-side anonymity gate). Number of
  /// students who answered this question in this class.
  respondentCount Int       @map("respondent_count")
  /// Source-side refresh timestamp (LAST_UPDATE from the view —
  /// single batch value, shared across all rows in a registrar refresh).
  lastUpdateAt    DateTime? @map("last_update_at")

  // ── Audit ───────────────────────────────────────────────────────────
  methodologyVersion String   @default("kku-evaluations.v1") @map("methodology_version")
  ingestionRunId     String   @map("ingestion_run_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  faculty       Faculty?            @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  classOffering ClassOffering?      @relation(fields: [classOfferingId], references: [id], onDelete: SetNull)
  facultyMember FacultyMember?      @relation(fields: [facultyMemberId], references: [id], onDelete: SetNull)
  question      EvaluationQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  ingestionRun  IngestionRun        @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  /// Natural key from the source — uniquely identifies every row of
  /// POWERBI.EVALUATE_INSTRUCTOR. Idempotent upsert key.
  @@unique([acadYearBE, semester, classIdRegistrar, questionIdRegistrar, officerIdRegistrar], name: "evaluation_natural_key")
  /// Faculty rollup index — drives `/education/satisfaction` aggregations.
  @@index([facultyId, acadYearBE, semester])
  /// Instructor rollup index — drives `/staff/teaching` per-person reads.
  @@index([facultyMemberId, acadYearBE, semester])
  @@index([classOfferingId])
  @@index([courseCode, acadYearBE, semester])
  @@index([questionIdRegistrar])
  @@index([ingestionRunId])
  @@map("evaluation_response_summaries")
}

// Many-to-many bridge from `Program` → course code, materialised from
// approved `PROGRAM_DIGEST` AiExtraction payloads. A course can appear
// in multiple programs (the registrar's class-offering view has no
// direct program column for exactly this reason). Refreshed by
// `pnpm programs:materialise-program-courses` — idempotent
// delete-and-replace per program.
//
// `courseCode` is normalised the same way as ClassOffering.courseCode
// (whitespace stripped, upper) so the natural join key matches.
model ProgramCourse {
  id             String   @id @default(cuid())
  programId      String   @map("program_id")
  /// Whitespace-stripped, upper-cased course code, matching
  /// ClassOffering.courseCode (e.g., "EN241100").
  courseCode     String   @map("course_code")
  /// As-extracted course code (preserves the digest's original form,
  /// usually with spaces like "EN 241 100").
  courseCodeRaw  String   @map("course_code_raw")
  courseNameTh   String?  @map("course_name_th")
  courseNameEn   String?  @map("course_name_en")
  credits        Int?
  /// Method version of the PROGRAM_DIGEST extractor that produced
  /// this row — lets a methodology bump re-flow new courses without
  /// wiping older curricula whose digests haven't been re-run yet.
  methodVersion  String   @map("method_version")
  refreshedAt    DateTime @default(now()) @updatedAt @map("refreshed_at")
  ingestionRunId String?  @map("ingestion_run_id")

  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([programId, courseCode])
  @@index([courseCode])
  @@index([ingestionRunId])
  @@map("program_courses")
}

// ─── Staff cross-system identity tables ─────────────────────────────────
//
// These two tables receive UNICON DS2003 + DS2004 data. Both are keyed
// by `citizenIdHash` — SHA-256 of the digit-stripped Thai citizen ID
// (or alphanumeric-stripped passport for foreign staff). Same hash is
// computed by the processed-HR mart connector and (eventually) the
// rehashed kku-hr feed; one canonical join key across all sources.
//
// `facultyMemberId` is a soft FK populated lazily — initial ingestion
// leaves it NULL; it gets filled when a connector observes a matching
// citizenIdHash on a FacultyMember row. Service-layer queries can join
// directly on citizenIdHash for unmatched rows.

// DS2003 — one row per (staff × degree). Source: UNICON_STAFF_KKU.DS2003.
model StaffEducationHistory {
  id             String   @id @default(cuid())
  citizenIdHash  String   @map("citizen_id_hash")
  source         String // 'unicon-ds2003'
  academicYear   String?  @map("academic_year") // BE year as string for source fidelity
  semester       String?
  univId         String?  @map("univ_id")
  gradYear       String?  @map("grad_year") // BE year of graduation
  gradLevelId    String?  @map("grad_level_id") // REF_LEV id; '-' or NULL when source missed it
  gradLevelName  String?  @map("grad_level_name") // derived from gradCurriculum if id absent
  gradCurriculum String?  @map("grad_curriculum") // GRAD_CURR — full degree+major name
  gradIscedId    String?  @map("grad_isced_id") // ISCED-2013 code; mostly empty in current data
  gradProgram    String?  @map("grad_program") // GRAD_PROG — major
  gradInstitute  String?  @map("grad_institute") // GRAD_UNIV — institute name
  gradCountryId  String?  @map("grad_country_id") // ISO-3166-1 alpha-2
  ingestionRunId String?  @map("ingestion_run_id")
  ingestedAt     DateTime @default(now()) @map("ingested_at")

  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@index([citizenIdHash])
  @@index([gradCountryId])
  @@index([gradLevelId])
  @@map("staff_education_history")
}

// DS2004 — one row per (staff × program × teach-type). Source: reg_unicon.ds2004_<YYSEM>.
model StaffProgramAssignment {
  id             String   @id @default(cuid())
  citizenIdHash  String   @map("citizen_id_hash")
  programId      String?  @map("program_id") // resolved via Program.mhesiCode = CURR_ID
  mhesiCurrId    String   @map("mhesi_curr_id") // raw CURR_ID, kept for audit + unresolved rows
  facId          String?  @map("fac_id") // raw MHESI faculty code (REF_FAC)
  teachTypeId    Int      @map("teach_type_id") // 1=regular, 2=curriculum lecturer, 3=responsible
  academicYear   Int      @map("academic_year") // BE year
  semester       Int
  univId         String?  @map("univ_id")
  ingestionRunId String?  @map("ingestion_run_id")
  ingestedAt     DateTime @default(now()) @map("ingested_at")

  program      Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([academicYear, semester, citizenIdHash, mhesiCurrId, teachTypeId], map: "uq_staff_prog_natural")
  @@index([citizenIdHash])
  @@index([programId])
  @@index([mhesiCurrId])
  @@map("staff_program_assignment")
}

// One Program ↔ many MHESI CURR_IDs. Reconciles cases where MHESI tracks
// distinct curriculum codes for what we model as a single Program (Thai
// vs International program-mode variants, curriculum-revision codes,
// etc.). UNICON is the trust source for CURR_IDs; this table is the
// many-side that lets DS2004 resolve all of them to our single Program
// row. `Program.mhesiCode` remains the canonical primary; aliases here
// are non-primary by definition.
model ProgramMhesiAlias {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  mhesiCode String   @unique @map("mhesi_code")
  source    String // 'unicon-ds2004', 'analyst-curated', etc.
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("program_mhesi_aliases")
}

// DS1001 — student-level snapshot, one row per (student × AY × sem).
// Source: reg_unicon.view_ds1001 (KKU's UNICON submission).
//
// PII handling at ingestion (DPO-approved 2026-05-04):
//   - Direct identifiers DROPPED: name (TH+EN), full DOB, sub-district,
//     passport number/dates, prefix.
//   - CITIZEN_ID and STD_ID HASHED via @kku/shared/identity/hash-citizen-id.
//     citizenIdHash is the canonical cross-system join key (matches
//     staff_program_assignment, staff_education_history).
//   - BIRTHDAY → birth year only (year-precision, like FacultyMember).
//   - DEFORM_ID (disability) and FUND_STATUS_ID retained but flagged
//     as §26-sensitive — RBAC gate at the service layer.
//
// CURR_ID resolves to Program via Program.mhesiCode ∪ ProgramMhesiAlias.
// Snapshot replace by (academicYear, semester) on every refresh.
model StudentProgramRecord {
  id              String  @id @default(cuid())
  citizenIdHash   String  @map("citizen_id_hash")
  studentCodeHash String? @map("student_code_hash") // SHA-256 of STD_ID
  programId       String? @map("program_id")
  mhesiCurrId     String  @map("mhesi_curr_id")
  facId           String? @map("fac_id")
  academicYear    Int     @map("academic_year")
  semester        Int
  univId          String? @map("univ_id")

  // Demographics — categorical, low re-identification risk
  genderId      String? @map("gender_id")
  nationalityId String? @map("nationality_id")
  birthYear     Int?    @map("birth_year")
  admitYear     Int?    @map("admit_year")

  // Study mode + status
  studyTypeId        String? @map("study_type_id")
  studyTimeId        String? @map("study_time_id")
  studyRegId         String? @map("study_reg_id")
  classYear          String? @map("class_year")
  degreeNum          Int?    @map("degree_num")
  graduationStatusId String? @map("graduation_status_id")
  studentStatusId    String? @map("student_status_id")
  terminateCause     String? @map("terminate_cause")

  // Academic performance — sensitive; RBAC-gate
  gpa       Float?
  gpax      Float?
  numCredit Int?   @map("num_credit")
  accCredit Int?   @map("acc_credit")

  // Funding aid + accessibility — §26-adjacent; RBAC-gate
  fundStatusId String? @map("fund_status_id")
  fundName     String? @map("fund_name")
  deformId     String? @map("deform_id")
  talentId     String? @map("talent_id")

  ingestionRunId String?  @map("ingestion_run_id")
  ingestedAt     DateTime @default(now()) @map("ingested_at")

  program      Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([academicYear, semester, citizenIdHash], map: "uq_student_record_natural")
  @@index([citizenIdHash])
  @@index([programId])
  @@index([mhesiCurrId])
  @@index([facId])
  @@index([studentStatusId])
  @@map("student_program_record")
}

// DS2001 — staff master record (one row per staff per AY+sem). Source:
// UNICON_STAFF_KKU.DS2001 via the unicon-ds2001 connector.
//
// PII handling at projection (DPO-approved 2026-05-04):
//   DROPPED:  HOMEADD, MOO, STREET, SUB_DISTRICT_ID, ZIPCODE, TELEPHONE,
//             EMAIL, PASSPORT_*, APPOINTMENT_*, SCHOLAR_ORDER_*,
//             DECORATION_ID/DATE
//   HASHED:   CITIZEN_ID → citizenIdHash (canonical cross-system join key)
//   YEAR-DOWN: BIRTHDAY → birth_year only
//
// Names KEPT — useful for staff rosters + top-producer panels (DPO scope
// covers internal Council/management surfaces; service layer RBAC-gates
// the name fields when serving non-admin requests).
model StaffMasterRecord {
  id            String @id @default(cuid())
  citizenIdHash String @map("citizen_id_hash")

  // Names — RBAC-gate at service layer for non-admin readers
  prefixNameId String? @map("prefix_name_id")
  firstName    String? @map("first_name")
  middleName   String? @map("middle_name")
  lastName     String? @map("last_name")
  firstNameEn  String? @map("first_name_en")
  middleNameEn String? @map("middle_name_en")
  lastNameEn   String? @map("last_name_en")

  // Demographics
  genderId      String? @map("gender_id")
  birthYear     Int?    @map("birth_year")
  nationalityId String? @map("nationality_id")

  // Type / track
  staffTypeId        String? @map("staff_type_id")
  subStaffTypeId     String? @map("sub_staff_type_id")
  timeContactId      String? @map("time_contact_id")
  budgetId           String? @map("budget_id")
  adminPositionId    String? @map("admin_position_id")
  positionWork       String? @map("position_work")
  academicStandingId String? @map("academic_standing_id")
  positionLevelId    String? @map("position_level_id")

  // Org placement
  departmentRawId String? @map("department_raw_id")
  facultyId       String? @map("faculty_id")

  // Lifecycle
  dateInWork     DateTime? @map("date_in_work") @db.Date
  dateStartThisU DateTime? @map("date_start_this_u") @db.Date
  movementTypeId String?   @map("movement_type_id")
  movementDate   DateTime? @map("movement_date") @db.Date

  // Specialisation
  specialNameId1               String? @map("special_name_id_1")
  specialNameId2               String? @map("special_name_id_2")
  academicStandingSubjectId    String? @map("academic_standing_subject_id")
  academicStandingSubjectOther String? @map("academic_standing_subject_other")
  teachLevelId                 String? @map("teach_level_id")

  // Income — UNICON-codified band (e.g., '15001-20000', '20001-25000')
  incomeId String? @map("income_id")

  // §26-sensitive — RBAC strict
  deformId String? @map("deform_id")

  researcherStatusId String? @map("researcher_status_id")

  academicYear   Int      @map("academic_year")
  semester       Int      @map("semester")
  univId         String?  @map("univ_id")
  ingestionRunId String?  @map("ingestion_run_id")
  ingestedAt     DateTime @default(now()) @map("ingested_at")

  faculty      Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([academicYear, semester, citizenIdHash], map: "uq_staff_master_natural")
  @@index([citizenIdHash])
  @@index([facultyId])
  @@index([staffTypeId])
  @@index([subStaffTypeId])
  @@index([academicStandingId])
  @@index([positionLevelId])
  @@map("staff_master_record")
}

// Processed-HR salary aggregates (sourced from `vw_history` at
// 202.28.117.84:3306). Aggregate-at-source via `GROUP BY ... HAVING n>=5`
// — no per-person salary ever crosses the wire. Two grain levels:
// (faculty × isAcademic × rank/level × salType) for the dashboard,
// reusable in the cost-allocation methodology + program pipeline.
model StaffCompensationCube {
  id          String  @id @default(cuid())
  fiscalYear  Int     @map("fiscal_year")
  facultyName String  @map("faculty_name") // raw Thai name from vw_history.faculty
  facultyId   String? @map("faculty_id") // resolved to our Faculty
  isAcademic  Boolean @map("is_academic") // true if posi_academic non-empty
  level       String? // ผศ/รศ/ศ/อ./ปฏิบัติการ/ชำนาญการ/...
  salType     String? @map("sal_type") // เงินงบประมาณ / เงินรายได้ / 50:50 / ...

  headcount  Int
  meanSalary Float @map("mean_salary")
  minSalary  Float @map("min_salary")
  maxSalary  Float @map("max_salary")
  sumSalary  Float @map("sum_salary")

  ingestionRunId String?  @map("ingestion_run_id")
  ingestedAt     DateTime @default(now()) @map("ingested_at")

  faculty      Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([fiscalYear, facultyName, isAcademic, level, salType], map: "uq_staff_comp_natural")
  @@index([facultyId])
  @@index([fiscalYear])
  @@index([isAcademic])
  @@map("staff_compensation_cube")
}

// Per-method-prefix AI model override. Set via the admin AI-settings
// page (Phase 3 of the admin redesign, 2026-05-12). The dispatch
// chain in @kku/shared's GoogleAiService / AnthropicAiService now
// reads this table before falling back to MODEL_BY_METHOD_PREFIX,
// so operators can swap models per task at runtime without code
// changes.
//
// `methodPrefix` matches the prefix of `methodVersion` strings passed
// into AiService.extractStructured / complete — e.g. 'program-pedagogy'
// covers both 'program-pedagogy.v1' and any future v2. Operators
// don't worry about version bumps unless they explicitly want to.
//
// Per Q5: changing a model affects NEW runs only — existing
// AiInference rows stamped with the old `model` value stay
// untouched. UI surfaces a "stale" hint where applicable; no
// auto-re-run.
model AiModelOverride {
  id           String   @id @default(cuid())
  methodPrefix String   @unique @map("method_prefix")
  /// The model identifier (e.g. 'gemini-3.1-pro-preview',
  /// 'claude-sonnet-4-6'). Validated against the catalog at the
  /// admin-endpoint layer; stored verbatim here so even off-catalog
  /// models work in a pinch.
  modelId      String   @map("model_id")
  /// Operator who last changed this override. Helpful for audit.
  setByUserId  String?  @map("set_by_user_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  setBy User? @relation(fields: [setByUserId], references: [id])

  @@map("ai_model_overrides")
}

// Catalog of AI models selectable on the admin AI-settings page.
//
// Google Gemini rows (source='openrouter') are refreshed daily from the
// OpenRouter model list (https://openrouter.ai/api/v1/models) — the 2
// latest flash + 2 latest pro, with OpenRouter's description + pricing.
// OpenRouter is used ONLY for model discovery; AI calls still route
// through the Google provider directly (id = OpenRouter id minus the
// 'google/' prefix).
//
// Anthropic rows (source='static') are seeded once and never touched by
// the refresh — the analyst runs on Claude and needs them as override
// options.
//
// Pricing here is the single source of truth: PrismaAiInferenceRecorder
// computes AiInference.costEstimateUsd from these per-1M figures,
// falling back to the provider's static table only when a model is
// absent from the catalog.
model AiModelCatalog {
  /// Provider API model id — what we pass to the Google/Anthropic SDK
  /// (e.g. 'gemini-3.5-flash', 'claude-sonnet-4-6').
  id              String    @id
  provider        String
  /// 'flash' | 'pro' | 'sonnet' | 'haiku' | 'opus'.
  tier            String
  label           String
  description     String    @db.Text
  costInputPer1m  Float     @map("cost_input_per_1m")
  costOutputPer1m Float     @map("cost_output_per_1m")
  /// 'openrouter' (cron-managed) | 'static' (seeded, never refreshed).
  source          String
  /// OpenRouter model id, e.g. 'google/gemini-3.5-flash'. Null for static rows.
  openrouterId    String?   @map("openrouter_id")
  /// OpenRouter `created` timestamp — drives "2 latest" ordering.
  sourceCreatedAt DateTime? @map("source_created_at")
  contextLength   Int?      @map("context_length")
  /// Shown in the admin model picker. False = kept for cost lookup only.
  isSelectable    Boolean   @default(true) @map("is_selectable")
  /// True when this is NOT the freshest model of its tier (UI badge).
  legacy          Boolean   @default(false)
  /// When the row was last written by the refresh / seed.
  fetchedAt       DateTime  @default(now()) @map("fetched_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([source])
  @@index([isSelectable])
  @@map("ai_model_catalog")
}

// Per-hire snapshot from HCMEmployee.EmployeeDetail. Captures every
// staff member (academic + research + support, no STATUS or
// position-type filter) who joined KKU within the last 10 years —
// FIRSTHIREDATE-keyed. Drives the "New hires" KPI on
// /staff/workforce. Same construction pattern as StaffSeparation
// (parallel hires/separations sources, both derived from the full
// EmployeeDetail without the active-only filter that scopes Q1 to
// academic faculty).
//
// One row per hire event, keyed on HCM's EMPLOYEEID hash so
// re-ingestion is idempotent. Snapshot-replaced by the kku-hr
// connector on each run.
model StaffHire {
  /// SHA-256 of HCMEmployee.EMPLOYEEID — canonical join key.
  employeeHash  String    @id @map("employee_hash")
  /// HR-internal employment number — non-PII per KKU 2026-05-02.
  employeeId    String?   @map("employee_id")
  /// SHA-256 of citizen ID when present.
  citizenIdHash String?   @map("citizen_id_hash")
  /// HCMEmployee.BIRTHDAY — primary HCM birth date for ALL staff
  /// (including support). Replaces vw_history.birthday as the source
  /// for age + retirement-cliff + retirement-risk calcs across the
  /// workforce dashboard. The table name kept as "staff_hires" for
  /// continuity even though it now functionally holds full HCM staff
  /// demographics (one row per FIRSTHIREDATE-having employee).
  birthDate     DateTime? @map("birth_date") @db.Date
  /// HCMEmployee.FIRSTHIREDATE — original KKU join date.
  firstHireDate DateTime  @map("first_hire_date") @db.Date
  /// HCM STATUS at time of pull. 'A' = active; other = the person
  /// joined within the window AND has already separated.
  status        String?
  /// BU1 (faculty code) at time of pull.
  facultyKey    String?   @map("faculty_key")
  /// workforce_hcm_actual.All_Position_Types — current position type.
  positionType  String?   @map("position_type")
  /// Resolved Faculty row from the kku-hr connector's facultyMappings.
  facultyId     String?   @map("faculty_id")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  faculty Faculty? @relation(fields: [facultyId], references: [id])

  @@index([firstHireDate])
  @@index([birthDate])
  @@index([positionType])
  @@map("staff_hires")
}

// Per-separation snapshot from HCMEmployee.EmployeeDetail. Captures
// every academic / research staff member who has left KKU
// (ENDWORKDATE filled) within the last 10 years. Drives the turnover
// signal on /staff/workforce — denominator-correct because the
// numerator includes staff who are no longer in the active-only Q1
// projection (and therefore not in FacultyMember-active).
//
// One row per separation event, keyed on HCM's EMPLOYEEID hash so
// re-ingestion is idempotent. Snapshot-replaced by the kku-hr
// connector on each run.
model StaffSeparation {
  /// SHA-256 of HCMEmployee.EMPLOYEEID — canonical join key.
  employeeHash  String   @id @map("employee_hash")
  /// HR-internal employment number — non-PII per KKU 2026-05-02.
  employeeId    String?  @map("employee_id")
  /// SHA-256 of citizen ID when present — cross-system join to
  /// FacultyMember, StaffMasterRecord, StaffLifecycleDates.
  citizenIdHash String?  @map("citizen_id_hash")
  /// HCMEmployee.ENDWORKDATE — date the staff stopped working at KKU.
  endWorkDate   DateTime @map("end_work_date") @db.Date
  /// HCM STATUS code at time of pull (e.g. 'R' retired, 'S' resigned).
  /// Free-text — meaning is documented in docs/data-sources/kku-hr.md.
  status        String?
  /// BU1 (faculty code) at time of separation.
  facultyKey    String?  @map("faculty_key")
  /// workforce_hcm_actual.All_Position_Types — 'วิชาการ' / 'วิจัย' /
  /// 'สนับสนุน' / etc. Null when the workforce position record was
  /// already cleared by the time we ran.
  positionType  String?  @map("position_type")
  /// Resolved Faculty row from the kku-hr connector's facultyMappings
  /// (BU1 → Faculty.id). Null when unmapped.
  facultyId     String?  @map("faculty_id")
  updatedAt     DateTime @updatedAt @map("updated_at")

  faculty Faculty? @relation(fields: [facultyId], references: [id])

  @@index([endWorkDate])
  @@index([positionType])
  @@map("staff_separations")
}

// Per-person lifecycle dates from processed-HR vw_history.
// PII-narrow projection: just SHA-256(citizen_id) + dates.
// Snapshot replace by source on every refresh.
//
// Date columns added 2026-05-12 — `vw_history` carries full-precision
// dates (`birthday`, `putday`=hire, `retireday`, `sixtyday`) but the
// original load truncated to YEAR(). Full dates power:
//   - FacultyMember.retirementDate enrichment (deep-dive bug fix —
//     MSSQL HCMEmployee.RESIGNDATE is only filled post-resignation,
//     so it's null for active staff)
//   - FacultyMember.hireDate enrichment (more reliable than MSSQL
//     STARTDATE which has bulk-stamp anomalies)
//   - workforce dashboard month-precision retirement timeline
// Year columns retained for legacy callers + indexes.
model StaffLifecycleDates {
  citizenIdHash String    @id @map("citizen_id_hash")
  birthYearAd   Int?      @map("birth_year_ad")
  retireYearAd  Int?      @map("retire_year_ad")
  sixtyYearAd   Int?      @map("sixty_year_ad")
  /// Full date of birth from `vw_history.birthday` (UTC midnight). Year
  /// fields above are derived from these dates.
  birthDate     DateTime? @map("birth_date") @db.Date
  /// Hire date from `vw_history.putday` (joined KKU). Authoritative
  /// source; supersedes HCMEmployee.STARTDATE (which has been observed
  /// with 2025 bulk-stamp anomalies).
  hireDate      DateTime? @map("hire_date") @db.Date
  /// Mandatory retirement date from `vw_history.retireday`. Scheduled
  /// retirement (computed from birthday + 60-year boundary); authoritative
  /// for "when will this person retire" — HCMEmployee.RESIGNDATE is null
  /// for active staff.
  retireDate    DateTime? @map("retire_date") @db.Date
  /// Date the person turns 60 (`vw_history.sixtyday`). For most academic
  /// staff this equals retireDate; differs for support staff with
  /// extended-contract paths.
  sixtyDate     DateTime? @map("sixty_date") @db.Date
  source        String    @default("kku-hr-processed")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([retireYearAd])
  @@index([birthYearAd])
  @@index([retireDate])
  @@map("staff_lifecycle_dates")
}

// ══════════════════════════════════════════════════════════════════════════
// IMD World Competitiveness Center — country-level competitiveness rankings
// (Lausanne, free public summaries from imd.org/wcc).
//
// Three datasets (ImdDataset):
//   WCY  = World Competitiveness Yearbook (~67 economies, 4 pillars)
//   WTR  = World Talent Ranking (~67 economies, 3 factors)
//   WDCR = World Digital Competitiveness Ranking (~67 economies, 3 factors)
//
// Country-level only — IMD doesn't publish per-program data. Used as a
// macro-context backdrop for the Trends Radar narrative, the Cockpit AI
// brief's executive paragraph, and the Benchmarking module's ASEAN
// peer-country comparator.
//
// Two ingest paths:
//   1. Manual seed via `pnpm imd:seed` (analyst-curated JSON, refreshed
//      annually after IMD's June/July/September releases)
//   2. PDF intake of the annual WCY summary PDF (mocked Q1; real LLM
//      extraction in a later session)
// ══════════════════════════════════════════════════════════════════════════

enum ImdDataset {
  WCY // World Competitiveness Yearbook
  WTR // World Talent Ranking
  WDCR // World Digital Competitiveness Ranking
}

/// IMD's economy taxonomy (~67 entries; mostly nation-states + Hong Kong
/// SAR / Macao / Taiwan). Code is IMD's preferred 2- or 3-letter slug;
/// region groupings are coarse for ASEAN/peer comparison.
model ImdEconomy {
  id        String   @id @default(cuid())
  /// 2–3 letter ISO-style code as published by IMD (e.g. "TH", "SG", "USA").
  code      String   @unique
  name      String
  /// Coarse region — "ASEAN", "EastAsia", "Europe", "NorthAmerica", etc.
  region    String?
  /// True when the analyst flags this as a KKU peer country worth
  /// surfacing in dashboards. Drives the default comparator on the
  /// Benchmarking country axis.
  isPeer    Boolean  @default(false) @map("is_peer")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rankings ImdRanking[]

  @@index([region])
  @@map("imd_economies")
}

/// One row per (year × dataset × economy × indicator). The pillar/factor
/// hierarchy lives in `indicatorKey` as a slash-delimited path
/// (e.g. "wcy.overall", "wcy.economic_performance",
/// "wtr.overall", "wdcr.knowledge"). Free-text by design — IMD adjusts
/// pillar wording every 1–2 years.
model ImdRanking {
  id                 String     @id @default(cuid())
  year               Int
  dataset            ImdDataset
  economyId          String     @map("economy_id")
  /// Slash-delimited indicator path; lowercase. "<dataset>.overall" for
  /// the headline; "<dataset>.<pillar>" for sub-scores.
  indicatorKey       String     @map("indicator_key")
  /// Numeric value when one is published (score 0–100 or raw indicator).
  /// Null when only a rank is available.
  value              Float?
  /// Position rank — 1 = best. Null when only a value is published.
  rank               Int?
  /// Total economies ranked that year (denominator for percentile calc).
  totalRanked        Int?       @map("total_ranked")
  /// Original published string from the IMD report — kept verbatim for
  /// audit + analyst sanity-check.
  rawValue           String?    @map("raw_value")
  /// Free text — sub-pillar name, methodology bump notes, etc.
  notes              String?
  methodologyVersion String     @default("imd.v1") @map("methodology_version")
  /// 'manual-seed' | 'imd-wcy-pdf' | 'imd-wtr-pdf' | 'imd-wdcr-pdf'
  /// — points back at the connector / CLI that wrote the row.
  source             String
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  economy ImdEconomy @relation(fields: [economyId], references: [id], onDelete: Cascade)

  @@unique([year, dataset, economyId, indicatorKey])
  @@index([dataset, year])
  @@index([economyId])
  @@map("imd_rankings")
}

// ══════════════════════════════════════════════════════════════════════════
// KKU TCAS admission funnel — full round 1–4 data per program × year.
//
// Source: registry Oracle view POWERBI.ADMISSION_STAT_CURRID. Replaces
// the TCAS3-only rows that previously lived in TcasAdmissionStat. The
// peer-institution rows in TcasAdmissionStat stay (for benchmarking);
// only the KKU rows are migrated here.
//
// One row per (mhesi_curr_id × round × entry_year_be). MHESI's CURR_ID
// joins back to Program via Program.mhesiCode ∪ ProgramMhesiAlias.
//
// All count columns are nullable because the upstream view sometimes
// reports NULL for rounds where a program didn't run (e.g. round 4
// for selective programs that closed at round 3).
// ══════════════════════════════════════════════════════════════════════════

model TcasAdmissionFunnel {
  id                   String   @id @default(cuid())
  /// Resolved through Program.mhesiCode ∪ ProgramMhesiAlias. Nullable
  /// when the CURR_ID couldn't be mapped (surfaces in the run summary
  /// for analyst follow-up).
  programId            String?  @map("program_id")
  /// MHESI curriculum ID — the natural primary join key from the Oracle
  /// view. Always present.
  mhesiCurrId          String   @map("mhesi_curr_id")
  /// TCAS round — stored as String because the source view uses both
  /// integer rounds (1, 2, 3, 4) AND fractional sub-rounds (1.2, 2.2,
  /// 4.2) when a round is split across phases. Numeric stringification
  /// preserves the source representation exactly. Sort
  /// lexicographically when displaying — that orders 1, 1.2, 1.3, 2,
  /// 2.2, 3, 4, 4.2 correctly.
  round                String
  /// Buddhist Era entry year (e.g. 2568 for the 2025 cohort).
  entryYearBE          Int      @map("entry_year_be")
  /// จำนวนรับ — admission seats allocated to THIS round. Sum across
  /// rounds in a year is intentionally LARGER than `planPerYear` —
  /// the registrar over-allocates to compensate for no-show. The
  /// observed over-allocation factor at KKU sits around 1.5–2.0×
  /// (BE 2568: 1.65×).
  enrollSeats          Int?     @map("enroll_seats")
  /// PLAN_PER_YEAR — the registrar's actual annual seat target for
  /// the program (year-level value). Same value repeats across rounds
  /// of the same (CURR_ID × ACADYEAR), with rare drift across rounds
  /// when the plan is revised mid-cycle (~1% of cases). Use MAX()
  /// when aggregating per program to collapse those cases.
  planPerYear          Int?     @map("plan_per_year")
  /// จำนวนผู้สมัคร — total applicants.
  totalApplicants      Int?     @map("total_applicants")
  /// TOTAL_PASS — total who passed the round.
  totalPassed          Int?     @map("total_passed")
  /// จำนวนส่ง Clearinghouse.
  sendClearinghouse    Int?     @map("send_clearinghouse")
  /// จำนวนยืนยัน Clearinghouse.
  confirmClearinghouse Int?     @map("confirm_clearinghouse")
  /// จำนวนส่งออกรหัส นศ reg เพื่อรายงานตัว.
  sendRegReported      Int?     @map("send_reg_reported")
  /// จำนวนผู้ที่รายงานตัว — actually reported / enrolled.
  regReported          Int?     @map("reg_reported")
  freshnessDate        DateTime @map("freshness_date") @db.Date
  source               String   @default("kku-tcas-funnel")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ingestionRunId       String?  @map("ingestion_run_id")

  program      Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([mhesiCurrId, round, entryYearBE])
  @@index([programId])
  @@index([entryYearBE])
  @@index([ingestionRunId])
  @@map("tcas_admission_funnels")
}

// ─────────────────────────────────────────────────────────────────────────────
// Actual recruitment campaigns — POWERBI.ADMISSION_STAT.
//
// Where TcasAdmissionFunnel is the CURRICULUM-level rollup (one row per
// MHESI curriculum × round × year), this table is the PRACTICAL recruitment
// grain: one row per campaign TRACK — a specific competency / language /
// exam option / quota type / branch-campus intake within a program × round
// × year. The Oracle surrogate WPROGRAMID is unique per row.
//
// PROGRAMID (recruitmentProgramId) is a 12-digit recruitment code that is
// NOT the MHESI curr code; it resolves to a canonical Program only through
// AdmissionStatProgramMapping (LLM-assisted), joined at query time so a
// mapping change takes effect without re-ingesting. facultyId IS resolved
// at ingest (exact nameTh match) since FACULTYNAME ships inline.
// ─────────────────────────────────────────────────────────────────────────────
model AdmissionCampaignStat {
  id                   String   @id @default(cuid())
  /// WPROGRAMID — Oracle's unique per-row surrogate for one campaign-track
  /// instance. The natural key for upserts.
  wProgramId           String   @unique @map("w_program_id")
  /// PROGRAMID — the recruitment-program code (≠ MHESI curr code). One
  /// PROGRAMID groups many campaign tracks. Resolved to a canonical
  /// Program via AdmissionStatProgramMapping. Length-1 / "0" values are
  /// the source's not-yet-assigned ("convert") rows.
  recruitmentProgramId String   @map("recruitment_program_id")
  /// CURR_ID — the 14-digit MHESI curriculum code (added by Registrar IT
  /// 2026-05-30). Authoritative link to the canonical program via
  /// Program.mhesiCode ∪ ProgramMhesiAlias (same path the TCAS funnel
  /// uses). PROGRAMID → CURR_ID is a function; one CURR_ID may span
  /// several PROGRAMIDs (management classes: ภาคปกติ / โครงการพิเศษ …),
  /// each of which can carry its own PLAN_PER_YEAER.
  currId               String?  @map("curr_id")
  /// Resolved canonical program — via CURR_ID → Program.mhesiCode ∪
  /// ProgramMhesiAlias (authoritative), with the name-based
  /// AdmissionStatProgramMapping bridge as fallback. Resolved + stored at
  /// ingest so scoring / deep-dive / risk read it directly (drop-in for the
  /// retired tcas_admission_funnels.program_id). Null = "to be assigned".
  programId            String?  @map("program_id")
  /// PROGRAMNAME — free-text campaign label; encodes the track / quota /
  /// competency option / branch campus.
  campaignName         String   @map("campaign_name") @db.Text
  /// FACULTYID from source (KKU internal numbering). 0 = "ยังไม่ถูกกำหนด
  /// - อยู่ในช่วง convert" (not yet assigned).
  sourceFacultyId      Int?     @map("source_faculty_id")
  /// FACULTYNAME (Thai) from source — authoritative for the campaign.
  facultyNameTh        String   @map("faculty_name_th")
  /// Resolved canonical Faculty (exact nameTh match). Nullable when the
  /// source faculty is unassigned / unmatched.
  facultyId            String?  @map("faculty_id")
  /// ACADYEAR — Buddhist Era entry cohort year.
  acadYearBE           Int      @map("acad_year_be")
  /// TCAS round — String for parity with the funnel table (integer +
  /// fractional sub-rounds 1.2, 2.2, 4.2…). Sort lexicographically.
  round                String
  /// ENROLLSEAT — per-track allocated seats (sums across tracks/rounds;
  /// over-allocated vs the plan to absorb no-show). Null when unset.
  enrollSeats          Int?     @map("enroll_seats")
  /// PLAN_PER_YEAER (sic — Registrar's column spelling) — annual plan,
  /// constant per (PROGRAMID, year). One CURR_ID may carry >1 distinct
  /// plan across its management classes → aggregate as SUM(DISTINCT plan)
  /// per CURR_ID. Null = "not yet assigned" → no-plan-on-file.
  planPerYear          Int?     @map("plan_per_year")
  totalApplicants      Int?     @map("total_applicants")
  totalPassed          Int?     @map("total_passed")
  sendClearinghouse    Int?     @map("send_clearinghouse")
  confirmClearinghouse Int?     @map("confirm_clearinghouse")
  sendRegReported      Int?     @map("send_reg_reported")
  regReported          Int?     @map("reg_reported")
  freshnessDate        DateTime @map("freshness_date") @db.Date
  source               String   @default("kku-admission-campaigns")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ingestionRunId       String?  @map("ingestion_run_id")

  program      Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  faculty      Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([recruitmentProgramId])
  @@index([currId])
  @@index([facultyId])
  @@index([acadYearBE])
  @@index([ingestionRunId])
  @@map("admission_campaign_stats")
}

// PROGRAMID → canonical Program bridge for ADMISSION_STAT (LLM-assisted).
// One row per distinct recruitment-program code; the dashboard LEFT JOINs
// this so unmapped codes fall into a "to be assigned" bucket.
model AdmissionStatProgramMapping {
  id                   String    @id @default(cuid())
  /// PROGRAMID from POWERBI.ADMISSION_STAT.
  recruitmentProgramId String    @unique @map("recruitment_program_id")
  /// A representative PROGRAMNAME for analyst review of the mapping.
  sampleCampaignName   String?   @map("sample_campaign_name") @db.Text
  facultyNameTh        String?   @map("faculty_name_th")
  programId            String    @map("program_id")
  /// 0–1. 1.0 = deterministic exact / manual; LLM supplies its own.
  confidence           Float     @default(1.0)
  /// 'deterministic' | 'llm-assisted' | 'manual-reviewed'.
  method               String    @default("llm-assisted")
  notes                String?   @db.Text
  reviewedBy           String?   @map("reviewed_by")
  reviewedAt           DateTime? @map("reviewed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("admission_stat_program_mappings")
}

/// Analyst override for a recruitment program (PROGRAMID) that isn't yet in the
/// curriculum catalog — e.g. a brand-new intake the TCAS feed slots under
/// another program's reused curr_id. Flagging it here makes the recruitment
/// dashboard surface it as its own standalone "new program" (its curr_id is
/// ignored for grouping) instead of folding it into that curr_id's program.
model RecruitmentProgramOverride {
  id                   String   @id @default(cuid())
  /// PROGRAMID from POWERBI.ADMISSION_STAT.
  recruitmentProgramId String   @unique @map("recruitment_program_id")
  /// Discriminator. Today only 'NEW_PROGRAM' (standalone, uncatalogued).
  kind                 String   @default("NEW_PROGRAM")
  /// Optional display name; falls back to the campaign-derived label.
  displayNameTh        String?  @map("display_name_th")
  displayNameEn        String?  @map("display_name_en")
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("recruitment_program_overrides")
}

// ═════════════════════════════════════════════════════════════════════════════
// Risk Management module (risk-scoring.v1)
//
// Per-program risk profile with three Likelihood drivers and two Impact
// dimensions. Composite uses max(L) so a single critical driver isn't
// diluted by lower-scoring ones. Impact is carried in raw THB (the unit
// Council asks about) AND a 0-100 normalised score for portfolio-level
// matrix plotting.
//
// Scope: undergraduate only (Program.level = BACHELOR). Master/PhD risk
// has different drivers and is a v2 module.
//
// Null handling: missing inputs return null (data gap), never imputed
// zeros. Confidence on each driver = data completeness.
// ═════════════════════════════════════════════════════════════════════════════

enum AutomationRisk {
  LOW // requires judgement / dexterity / interpersonal — safe near-term
  MEDIUM // partial automation likely 5-10y horizon
  HIGH // routine cognitive / structured — automation already underway
  UNKNOWN // not yet classified
}

// KKU 5×5 institutional risk matrix level — matrix score = likelihood (1-5)
// × impact (1-5) → 1-25 → bucketed per KKU's standard ERM colour rule:
//   1-4   → ต่ำ (Low)        / Green
//   5-9   → ปานกลาง (Moderate) / Yellow
//   10-15 → สูง (High)        / Orange
//   16-25 → สูงมาก (Very High) / Red
// NEEDS_DATA covers programs whose composite likelihood OR impact is null.
enum KkuRiskLevel {
  NEEDS_DATA
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum RiskTier {
  // Program-specific data is too thin to issue a verdict (recruitment funnel
  // missing AND skill-automation tagging absent). Surfaces as a separate
  // bucket so analysts can prioritise the data-acquisition worklist
  // instead of receiving a misleading "low risk" verdict.
  NEEDS_DATA
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RiskMeasureKind {
  // Narrow, specific recommendations per user. The AI prompt fills in
  // the SPECIFIC course / channel / peer / cohort — these enum values
  // are coarse buckets for filtering and dashboard rollup only.
  CURRICULUM_MODERNIZE // add/swap specific courses to address L2 (AI disruption)
  CURRICULUM_DIFFERENTIATE // add a niche track to occupy a peer white-space
  RECRUITMENT_CHANNEL // open or invest in a specific marketing channel
  RECRUITMENT_TARGETING // shift target school / region / cohort segment
  COHORT_REDUCTION // reduce planned intake to match realistic demand
  PROGRAM_MERGE // merge with a specific named program
  PROGRAM_PHASE_OUT // staged sunset over N years
  PARTNERSHIP_INDUSTRY // specific industry partner for placements / curriculum input
  FACULTY_HIRE // hire faculty in a specific gap area
  TUITION_ADJUST // reprice (up or down) to match positioning
}

enum RiskMeasureStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

// Time-to-effect horizon for a recommended measure. Lets Council scan a
// program profile by what's actionable now vs what requires longer
// commitment. Aligned with KKU strategic-plan cadences.
//   SHORT_TERM  — 0-12 months. Curriculum tweaks, marketing, partnerships
//                 that don't need new positions/facilities.
//   MEDIUM_TERM — 1-3 years. Faculty hires, new electives, channel buildout,
//                 cohort-size adjustments.
//   LONG_TERM   — 3-5 years. Curriculum redesign, mergers, phase-out plans,
//                 new specialisation tracks.
enum RiskMeasureHorizon {
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
}

enum RiskIndicatorSeverity {
  OK
  WARN
  CRITICAL
}

model RiskAssessment {
  id                       String       @id @default(cuid())
  programId                String       @map("program_id")
  assessedAt               DateTime     @default(now()) @map("assessed_at")
  // Three likelihood drivers, each 0-100 or null (data gap).
  // L1 = recruitment / TCAS competition decay
  // L2 = AI-disruption (share of taught skills tagged HIGH automationRisk)
  // L3 = demographic ceiling (competitiveness percentile × cohort projection)
  l1RecruitmentScore       Float?       @map("l1_recruitment_score")
  l1RecruitmentConfidence  Float?       @map("l1_recruitment_confidence")
  l2AiDisruptionScore      Float?       @map("l2_ai_disruption_score")
  l2AiDisruptionConfidence Float?       @map("l2_ai_disruption_confidence")
  l3DemographicScore       Float?       @map("l3_demographic_score")
  l3DemographicConfidence  Float?       @map("l3_demographic_confidence")
  // Composite score: max(L1, L2, L3) over non-null drivers. 0-100.
  compositeScore           Float?       @map("composite_score")
  tier                     RiskTier     @map("tier")
  // KKU 5×5 institutional matrix view — alongside the composite tier for
  // alignment with the university's ERM templates. Equal-width 0-100 → 1-5
  // bins; score = L × I (1-25); colour level per KKU criteria.
  likelihoodBin            Int?         @map("likelihood_bin")
  impactBin                Int?         @map("impact_bin")
  kkuMatrixScore           Int?         @map("kku_matrix_score")
  kkuRiskLevel             KkuRiskLevel @default(NEEDS_DATA) @map("kku_risk_level")
  // Impact dimensions in raw THB (Council-readable) plus 0-100 normalised
  // score for matrix plotting (normalised against the at-risk-revenue
  // distribution at portfolio level — recomputed on each pipeline run).
  directRevenueAtRiskThb   Decimal?     @map("direct_revenue_at_risk_thb") @db.Decimal(16, 2)
  strandedCostThb          Decimal?     @map("stranded_cost_thb") @db.Decimal(16, 2)
  impactScore              Float?       @map("impact_score")
  // Methodology + AI provenance.
  methodologyVersion       String       @default("risk-scoring.v1") @map("methodology_version")
  aiInferenceId            String?      @map("ai_inference_id")
  confidence               Float?
  narrativeTh              String?      @map("narrative_th") @db.Text
  narrativeEn              String?      @map("narrative_en") @db.Text
  // Data gaps surfaced to the UI ("no TCAS funnel for 2024", "no automationRisk
  // tag on 12 of 24 program skills", etc.). Array of `{ field, reason }`.
  dataGapsJson             Json?        @map("data_gaps_json")
  // Full raw AI payload (echoes the typed fields above plus anything the
  // model added that didn't fit the schema). Audit trail.
  payloadJson              Json?        @map("payload_json")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  program  Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  measures RiskMeasure[]

  @@index([programId, assessedAt(sort: Desc)])
  @@index([tier])
  @@index([assessedAt])
  @@map("risk_assessments")
}

// Catalog of KRIs — slug, label, formula description, thresholds.
// Seeded with the v1 indicator set; analyst-tunable via /admin in v2.
model RiskIndicator {
  id                 String   @id @default(cuid())
  slug               String   @unique
  labelTh            String   @map("label_th")
  labelEn            String   @map("label_en")
  descriptionTh      String   @map("description_th") @db.Text
  descriptionEn      String   @map("description_en") @db.Text
  // Free-text formula description (rendered in the indicator drawer's
  // "How calculated" section). The actual computation lives in
  // packages/db/src/risk-scoring.ts.
  formula            String   @db.Text
  // Thresholds — semantic varies per indicator. For a ratio indicator
  // these are absolute; for a CAGR indicator they're percentages.
  warnThreshold      Float    @map("warn_threshold")
  criticalThreshold  Float    @map("critical_threshold")
  // Direction: when to ALARM. 'low' = alarm when value <= threshold;
  // 'high' = alarm when value >= threshold.
  alarmDirection     String   @default("low") @map("alarm_direction")
  methodologyVersion String   @default("risk-scoring.v1") @map("methodology_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  breaches RiskIndicatorBreach[]

  @@map("risk_indicators")
}

// One row per (program × indicator × evaluation moment). Lets the UI
// show breach history as a series — KRI dashboards plot this.
model RiskIndicatorBreach {
  id                 String                @id @default(cuid())
  programId          String                @map("program_id")
  indicatorSlug      String                @map("indicator_slug")
  value              Float?
  severity           RiskIndicatorSeverity
  // The evaluation moment (when this breach was computed by the pipeline).
  observedAt         DateTime              @default(now()) @map("observed_at")
  // The data freshness — i.e. what cohort year / fiscal year was being
  // evaluated. Distinct from observedAt because we may evaluate FY2025
  // numbers in FY2026.
  freshnessDate      DateTime              @map("freshness_date") @db.Date
  methodologyVersion String                @default("risk-scoring.v1") @map("methodology_version")
  createdAt          DateTime              @default(now()) @map("created_at")

  program   Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  indicator RiskIndicator @relation(fields: [indicatorSlug], references: [slug], onDelete: Cascade)

  @@index([programId, observedAt(sort: Desc)])
  @@index([indicatorSlug, observedAt(sort: Desc)])
  @@index([severity])
  @@map("risk_indicator_breaches")
}

model RiskMeasure {
  id                   String                 @id @default(cuid())
  assessmentId         String                 @map("assessment_id")
  kind                 RiskMeasureKind
  // The SPECIFIC recommendation. titleEn = short label (used in tables),
  // rationaleTh = the analyst-facing "why" (200-400 chars). The AI fills
  // both with concrete program-level context — not a generic "modernize
  // curriculum" but "add CS-301 Applied Generative AI; drop CS-220 SOAP
  // Web Services."
  titleTh              String                 @map("title_th")
  titleEn              String                 @map("title_en")
  rationaleTh          String                 @map("rationale_th") @db.Text
  rationaleEn          String?                @map("rationale_en") @db.Text
  // Coarse cost class — 'LOW' (process / curriculum tweak),
  // 'MEDIUM' (hire / channel investment), 'HIGH' (program restructure /
  // facility build).
  costClass            String?                @map("cost_class")
  // Time horizon to effect (Council strategic-plan cadence).
  horizon              RiskMeasureHorizon     @default(MEDIUM_TERM)
  // Expected revenue delta over a 5y window (positive = revenue saved/added,
  // negative = cost). Often null for low-confidence measures.
  expectedDeltaThb     Decimal?               @map("expected_delta_thb") @db.Decimal(16, 2)
  // 1 = highest priority within the assessment.
  priority             Int                    @default(99)
  status               RiskMeasureStatus      @default(PROPOSED)
  // Optional link to the Decision Workspace if the measure has been
  // raised to a formal decision.
  decisionId           String?                @map("decision_id")
  // Specific evidence references the AI cited — peer programs, demand
  // signals, automation-risk tagged skills, etc. Free-shape JSON.
  evidenceJson         Json?                  @map("evidence_json")
  // When this measure was generated by the deterministic rule engine
  // (risk-measure-rules.v1+) in response to a KRI breach, these fields
  // record which indicator + severity triggered it. NULL for measures
  // proposed purely by the AI without a rule match. The UI uses these
  // to render a "triggered by indicator X" badge on the measure card.
  triggerIndicatorSlug String?                @map("trigger_indicator_slug")
  triggerSeverity      RiskIndicatorSeverity? @map("trigger_severity")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  assessment RiskAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  decision   CouncilDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([status])
  @@index([decisionId])
  @@index([triggerIndicatorSlug])
  @@map("risk_measures")
}

/// Generic key-value application settings (operator-tunable, DB-backed).
/// First use: academic_year.next_start_date. Keep keys dotted + namespaced.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_settings")
}
