// Structured output produced by an AiService extractStructured() call.
// Parallel to PdfExtraction — that table handles PDF-sourced extractions,
// this one handles everything else (course descriptions typed into admin
// forms, job-posting JSON from connectors, policy doc narrative tagging
// that chains off a PdfExtraction). The review UI at
// /admin/extraction-review reads from BOTH tables.
//
// Lifecycle:
//   1. AI job writes a row with reviewStatus = PENDING_REVIEW (or
//      AUTO_APPROVED when confidence clears the threshold).
//   2. If PENDING_REVIEW, an analyst approves/rejects/edits in the admin UI.
//   3. On APPROVED, a post-approval handler materialises the payload into
//      the real domain table (CourseSkill / JobPostingSkill / etc.).
model AiExtraction {
  id                   String       @id @default(cuid())
  // Source anchor — one of 'course', 'job_posting', 'policy_document',
  // 'curriculum', … Keyed as text so new kinds land without enum churn.
  sourceEntityType     String       @map("source_entity_type")
  sourceEntityId       String       @map("source_entity_id")
  // Which extraction this row represents — 'COURSE_SKILLS',
  // 'JOB_POSTING_SKILLS', 'POLICY_DOC_ANALYSIS', etc. Maps 1:1 to a
  // prompt template in @kku/shared/ai/prompts.
  extractionKind       String       @map("extraction_kind")
  payloadJson          Json         @map("payload_json")
  confidence           Float
  methodVersion        String       @map("method_version")
  aiInferenceId        String?      @map("ai_inference_id")
  reviewStatus         ReviewStatus @default(PENDING_REVIEW) @map("review_status")
  reviewedByUserId     String?      @map("reviewed_by_user_id")
  reviewedAt           DateTime?    @map("reviewed_at")
  reviewNotes          String?      @map("review_notes") @db.Text
  reasoning            String?      @db.Text
  // ── Gold-set fields (added 2026-05-11 — gap #3 closure) ────────────
  // Hand-curated ground truth for the AI accuracy measurement loop. Set
  // `isGoldSample=true` to nominate a row as a labelling candidate, then
  // an analyst fills `goldLabel` via `pnpm ai:gold-label`. The eval
  // runner (`pnpm ai:eval-accuracy`) compares (payloadJson, goldLabel)
  // to compute per-prompt precision/recall/F1.
  isGoldSample         Boolean      @default(false) @map("is_gold_sample")
  goldLabel            Json?        @map("gold_label")
  goldLabelledAt       DateTime?    @map("gold_labelled_at")
  goldLabelledByUserId String?      @map("gold_labelled_by_user_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  aiInference    AiInference? @relation(fields: [aiInferenceId], references: [id], onDelete: SetNull)
  reviewedBy     User?        @relation("AiExtractionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  goldLabelledBy User?        @relation("AiExtractionGoldLabeller", fields: [goldLabelledByUserId], references: [id], onDelete: SetNull)

  @@index([sourceEntityType, sourceEntityId])
  @@index([extractionKind])
  @@index([reviewStatus])
  @@index([isGoldSample])
  @@map("ai_extractions")
}

