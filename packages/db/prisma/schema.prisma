// External-AI-search source kinds. URL_LIST pulls explicit URLs
// (RSS / report-index pages / one-off reports) on cadence and AI-
// summarises each item. WEB_SEARCH issues queries against a search
// provider (Google CSE / Bing / Brave — keyed at runtime, env-driven)
// and AI-summarises the top-N results. Added 2026-05-12 for Phase 5.
enum ExternalAiSourceKind {
  URL_LIST
  WEB_SEARCH
}

enum ExternalAiSourceStatus {
  ACTIVE
  PAUSED
  DISABLED
}

// How to fetch the source URLs. PLAIN uses Node fetch with a browser
// UA (works for most sites). HEADLESS launches a Playwright Chromium
// page (necessary for CDN-protected sources — WEF's siblings on
// Akamai, OECD, Incapsula-protected gov sites). HEADLESS is more
// expensive (per-fetch wall-time + memory) so default stays PLAIN.
enum ExternalAiFetchStrategy {
  PLAIN
  HEADLESS
}

enum SignalType {
  POLICY
  RESEARCH
  MARKET
  TECH
  NEWS
}

// Where the uploaded/linked trend document came from.
enum TrendDocumentSourceType {
