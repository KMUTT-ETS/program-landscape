  updatedAt       DateTime      @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  results   ScenarioResult[]
  decisions CouncilDecision[]

  @@index([userId])
  @@index([scope, scopeId])
  @@map("scenarios")
}

model ScenarioResult {
