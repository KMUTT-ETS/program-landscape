// ══════════════════════════════════════════════════════════════════════════
// Organization (university → faculty → department → program)
// ══════════════════════════════════════════════════════════════════════════

model Faculty {
  id        String   @id @default(cuid())
  code      String   @unique
  nameTh    String   @map("name_th")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments    Department[]
  programs       Program[]
  users          User[]
  facultyMembers FacultyMember[]
  facultySkills  FacultySkill[]

  @@index([code])
  @@map("faculties")
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  nameTh    String   @map("name_th")
  nameEn    String   @map("name_en")
  facultyId String   @map("faculty_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faculty          Faculty           @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  programs         Program[]
  users            User[]
  facultyMembers   FacultyMember[]
  departmentSkills DepartmentSkill[]

  @@index([facultyId])
  @@map("departments")
}

model Program {
  id              String        @id @default(cuid())
  code            String        @unique
  nameTh          String        @map("name_th")
  nameEn          String        @map("name_en")
  facultyId       String        @map("faculty_id")
  departmentId    String?       @map("department_id")
  level           ProgramLevel
  status          ProgramStatus @default(ACTIVE)
  yearEstablished Int?          @map("year_established")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  faculty    Faculty     @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  curricula           Curriculum[]
  courses             Course[]
  programSkills       ProgramSkill[]
  programFaculties    ProgramFaculty[]
  enrollmentMetrics   EnrollmentMetric[]
  studentDemographics StudentDemographic[]
  financialMetrics    FinancialMetric[]
  graduateOutcomes    GraduateOutcome[]
  employerFeedback    EmployerFeedback[]

  @@index([facultyId])
  @@index([departmentId])
  @@index([status])
  @@index([level])
  @@map("programs")
}

// ══════════════════════════════════════════════════════════════════════════
// Users, audit, AI logs
// ══════════════════════════════════════════════════════════════════════════

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  ssoSubject      String?         @unique @map("sso_subject")
  name            String?
  role            UserRole        @default(VIEWER)
  facultyId       String?         @map("faculty_id")
  departmentId    String?         @map("department_id")
  themePreference ThemePreference @default(SYSTEM) @map("theme_preference")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  auditLogs              AuditLog[]
  aiInferences           AiInference[]
  uploadedPdfs           PdfDocument[]      @relation("PdfUploader")
  reviewedExtractions    PdfExtraction[]    @relation("ExtractionReviewer")
  reviewedAiExtractions  AiExtraction[]     @relation("AiExtractionReviewer")
  scenarios              Scenario[]
  councilDecisions       CouncilDecision[]
  annotations            Annotation[]
  pdfGenerations         PdfGeneration[]
  triggeredIngestionRuns IngestionRun[]     @relation("IngestionTriggeredBy")
  savedCockpitViews      SavedCockpitView[]

  @@index([email])
  @@index([ssoSubject])
  @@index([role])
  @@map("users")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  payloadJson Json?    @map("payload_json")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AiInference {
  id              String   @id @default(cuid())
  userId          String?  @map("user_id")
  module          String
  // Free-text call kind (e.g. 'course-skills.extract', 'policy-doc.summary',
  // 'embedding', 'translation'). Used for rollup dashboards.
  kind            String?
  prompt          String   @db.Text
  promptVersion   String?  @map("prompt_version")
  model           String
  response        String   @db.Text
  confidence      Float?
  sourcesJson     Json?    @map("sources_json")
  tokensInput     Int?     @map("tokens_input")
  tokensOutput    Int?     @map("tokens_output")
  latencyMs       Int?     @map("latency_ms")
  // Per-call cost estimate in USD. Computed by the provider from token
  // counts × per-model pricing. Admin dashboard rolls this up.
  costEstimateUsd Float?   @map("cost_estimate_usd")
  createdAt       DateTime @default(now()) @map("created_at")

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  trendSignals    TrendSignal[]
  scenarioResults ScenarioResult[]
  aiExtractions   AiExtraction[]
  annotations     Annotation[]

  @@index([userId])
  @@index([module])
  @@index([kind])
  @@index([createdAt])
  @@map("ai_inferences")
}

// Structured output produced by an AiService extractStructured() call.
// Parallel to PdfExtraction — that table handles PDF-sourced extractions,
// this one handles everything else (course descriptions typed into admin
// forms, job-posting JSON from connectors, policy doc narrative tagging
// that chains off a PdfExtraction). The review UI at
// /admin/extraction-review reads from BOTH tables.
//
// Lifecycle:
//   1. AI job writes a row with reviewStatus = PENDING_REVIEW (or
//      AUTO_APPROVED when confidence clears the threshold).
//   2. If PENDING_REVIEW, an analyst approves/rejects/edits in the admin UI.
//   3. On APPROVED, a post-approval handler materialises the payload into
//      the real domain table (CourseSkill / JobPostingSkill / etc.).
model AiExtraction {
  id               String       @id @default(cuid())
  // Source anchor — one of 'course', 'job_posting', 'policy_document',
  // 'curriculum', … Keyed as text so new kinds land without enum churn.
  sourceEntityType String       @map("source_entity_type")
  sourceEntityId   String       @map("source_entity_id")
  // Which extraction this row represents — 'COURSE_SKILLS',
  // 'JOB_POSTING_SKILLS', 'POLICY_DOC_ANALYSIS', etc. Maps 1:1 to a
  // prompt template in @kku/shared/ai/prompts.
  extractionKind   String       @map("extraction_kind")
  payloadJson      Json         @map("payload_json")
  confidence       Float
  methodVersion    String       @map("method_version")
  aiInferenceId    String?      @map("ai_inference_id")
  reviewStatus     ReviewStatus @default(PENDING_REVIEW) @map("review_status")
  reviewedByUserId String?      @map("reviewed_by_user_id")
  reviewedAt       DateTime?    @map("reviewed_at")
  reviewNotes      String?      @map("review_notes") @db.Text
  reasoning        String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  aiInference AiInference? @relation(fields: [aiInferenceId], references: [id], onDelete: SetNull)
  reviewedBy  User?        @relation("AiExtractionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([sourceEntityType, sourceEntityId])
  @@index([extractionKind])
  @@index([reviewStatus])
  @@map("ai_extractions")
}

// ══════════════════════════════════════════════════════════════════════════
// Curriculum & courses
// ══════════════════════════════════════════════════════════════════════════

model Curriculum {
  id              String           @id @default(cuid())
  programId       String           @map("program_id")
  version         String
  effectiveYear   Int              @map("effective_year")
  totalCredits    Int              @map("total_credits")
  mko2DocumentUrl String?          @map("mko2_document_url")
  sourcePdfId     String?          @map("source_pdf_id")
  status          CurriculumStatus @default(DRAFT)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  program   Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  sourcePdf PdfDocument?       @relation(fields: [sourcePdfId], references: [id], onDelete: SetNull)
  courses   CurriculumCourse[]

  @@unique([programId, version])
  @@index([programId])
  @@index([effectiveYear])
  @@map("curricula")
}

model Course {
  id            String     @id @default(cuid())
  programId     String     @map("program_id")
  code          String
  nameTh        String     @map("name_th")
  nameEn        String     @map("name_en")
  credits       Int
  type          CourseType @default(ELECTIVE)
  descriptionTh String?    @map("description_th") @db.Text
  descriptionEn String?    @map("description_en") @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  program      Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  curricula    CurriculumCourse[]
  courseSkills CourseSkill[]

  @@unique([programId, code])
  @@index([programId])
  @@index([type])
  @@map("courses")
}

model CurriculumCourse {
  id           String  @id @default(cuid())
  curriculumId String  @map("curriculum_id")
  courseId     String  @map("course_id")
  semester     Int
  isRequired   Boolean @default(true) @map("is_required")

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, courseId, semester])
  @@index([curriculumId])
  @@index([courseId])
  @@map("curriculum_courses")
}

// ══════════════════════════════════════════════════════════════════════════
// Skills
// ══════════════════════════════════════════════════════════════════════════

model Skill {
  id             String                       @id @default(cuid())
  code           String                       @unique
  nameTh         String                       @map("name_th")
  nameEn         String                       @map("name_en")
  taxonomySource SkillTaxonomy                @map("taxonomy_source")
  category       String?
  parentSkillId  String?                      @map("parent_skill_id")
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  parent           Skill?            @relation("SkillHierarchy", fields: [parentSkillId], references: [id], onDelete: SetNull)
  children         Skill[]           @relation("SkillHierarchy")
  courseSkills     CourseSkill[]
  programSkills    ProgramSkill[]
  departmentSkills DepartmentSkill[]
  facultySkills    FacultySkill[]
  jobPostingSkills JobPostingSkill[]

  @@index([code])
  @@index([taxonomySource])
  @@index([parentSkillId])
  @@map("skills")
}

model CourseSkill {
  id         String      @id @default(cuid())
  courseId   String      @map("course_id")
  skillId    String      @map("skill_id")
  weight     Float       @default(1.0)
  source     SkillSource @default(MANUAL)
  confidence Float?
  createdAt  DateTime    @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
  @@index([courseId])
  @@index([skillId])
  @@map("course_skills")
}

// Denormalized rollups — regenerated by ingestion jobs (prompt 04) whenever
// the underlying CourseSkill weights or curriculum membership changes.
model ProgramSkill {
  id         String   @id @default(cuid())
  programId  String   @map("program_id")
  skillId    String   @map("skill_id")
  weight     Float
  computedAt DateTime @default(now()) @map("computed_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([programId, skillId])
  @@index([programId])
  @@index([skillId])
  @@map("program_skills")
}

model DepartmentSkill {
  id           String   @id @default(cuid())
  departmentId String   @map("department_id")
  skillId      String   @map("skill_id")
  weight       Float
  computedAt   DateTime @default(now()) @map("computed_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([departmentId, skillId])
  @@index([departmentId])
  @@index([skillId])
  @@map("department_skills")
}

model FacultySkill {
  id         String   @id @default(cuid())
  facultyId  String   @map("faculty_id")
  skillId    String   @map("skill_id")
  weight     Float
  computedAt DateTime @default(now()) @map("computed_at")

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([facultyId, skillId])
  @@index([facultyId])
  @@index([skillId])
  @@map("faculty_skills")
}

// ══════════════════════════════════════════════════════════════════════════
// People
// ══════════════════════════════════════════════════════════════════════════

model FacultyMember {
  id                    String      @id @default(cuid())
  facultyId             String      @map("faculty_id")
  departmentId          String?     @map("department_id")
  employeeCode          String      @unique @map("employee_code")
  nameTh                String      @map("name_th")
  nameEn                String      @map("name_en")
  rank                  FacultyRank
  academicQualification String?     @map("academic_qualification")
  specialization        String?
  dateOfBirth           DateTime?   @map("date_of_birth") @db.Date
  hireDate              DateTime?   @map("hire_date") @db.Date
  retirementDate        DateTime?   @map("retirement_date") @db.Date
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  faculty          Faculty          @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  programFaculties ProgramFaculty[]
  researchOutputs  ResearchOutput[]

  @@index([facultyId])
  @@index([departmentId])
  @@index([isActive])
  @@map("faculty_members")
}

model ProgramFaculty {
  id              String             @id @default(cuid())
  facultyMemberId String             @map("faculty_member_id")
  programId       String             @map("program_id")
  role            ProgramFacultyRole @default(CORE)
  createdAt       DateTime           @default(now()) @map("created_at")

  facultyMember FacultyMember @relation(fields: [facultyMemberId], references: [id], onDelete: Cascade)
  program       Program       @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([facultyMemberId, programId])
  @@index([facultyMemberId])
  @@index([programId])
  @@map("program_faculties")
}

// ══════════════════════════════════════════════════════════════════════════
// Student funnel
// ══════════════════════════════════════════════════════════════════════════

model EnrollmentMetric {
  id                 String   @id @default(cuid())
  programId          String   @map("program_id")
  academicYear       Int      @map("academic_year")
  applications       Int
  admitted           Int
  enrolled           Int
  retainedYear2      Int      @map("retained_year2")
  graduatedOnTime    Int      @map("graduated_on_time")
  graduatedLate      Int      @map("graduated_late")
  dropouts           Int
  freshnessDate      DateTime @map("freshness_date") @db.Date
  methodologyVersion String   @default("v1") @map("methodology_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, academicYear])
  @@index([programId])
  @@index([academicYear])
  @@index([freshnessDate])
  @@map("enrollment_metrics")
}

model StudentDemographic {
  id            String   @id @default(cuid())
  programId     String   @map("program_id")
  academicYear  Int      @map("academic_year")
  breakdownJson Json     @map("breakdown_json")
  avgTgatScore  Float?   @map("avg_tgat_score")
  avgTpatScore  Float?   @map("avg_tpat_score")
  freshnessDate DateTime @map("freshness_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, academicYear])
  @@index([programId])
  @@index([academicYear])
  @@map("student_demographics")
}

// ══════════════════════════════════════════════════════════════════════════
// Financial
// ══════════════════════════════════════════════════════════════════════════

model CostMethodology {
  id            String   @id @default(cuid())
  version       String   @unique
  description   String   @db.Text
  effectiveDate DateTime @map("effective_date") @db.Date
  documentUrl   String?  @map("document_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  financialMetrics FinancialMetric[]

  @@index([effectiveDate])
  @@map("cost_methodologies")
}

model FinancialMetric {
  id                    String   @id @default(cuid())
  programId             String   @map("program_id")
  fiscalYear            Int      @map("fiscal_year")
  tuitionRevenue        Decimal  @map("tuition_revenue") @db.Decimal(14, 2)
  otherRevenue          Decimal  @default(0) @map("other_revenue") @db.Decimal(14, 2)
  directCost            Decimal  @map("direct_cost") @db.Decimal(14, 2)
  allocatedFacultyCost  Decimal  @map("allocated_faculty_cost") @db.Decimal(14, 2)
  allocatedFacilityCost Decimal  @map("allocated_facility_cost") @db.Decimal(14, 2)
  allocatedOverhead     Decimal  @map("allocated_overhead") @db.Decimal(14, 2)
  netContribution       Decimal  @map("net_contribution") @db.Decimal(14, 2)
  costPerStudent        Decimal? @map("cost_per_student") @db.Decimal(14, 2)
  freshnessDate         DateTime @map("freshness_date") @db.Date
  methodologyVersion    String   @default("v1") @map("methodology_version")
  costMethodologyId     String?  @map("cost_methodology_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  costMethodology CostMethodology? @relation(fields: [costMethodologyId], references: [id], onDelete: SetNull)

  @@unique([programId, fiscalYear])
  @@index([programId])
  @@index([fiscalYear])
  @@index([freshnessDate])
  @@map("financial_metrics")
}

// ══════════════════════════════════════════════════════════════════════════
// Outcomes
// ══════════════════════════════════════════════════════════════════════════

model GraduateOutcome {
  id                 String   @id @default(cuid())
  programId          String   @map("program_id")
  graduationYear     Int      @map("graduation_year")
  surveyYear         Int      @map("survey_year")
  employmentRate     Float    @map("employment_rate")
  averageSalary      Decimal  @map("average_salary") @db.Decimal(12, 2)
  jobRelevanceScore  Float    @map("job_relevance_score")
  furtherStudyRate   Float    @map("further_study_rate")
  sampleSize         Int      @map("sample_size")
  freshnessDate      DateTime @map("freshness_date") @db.Date
  methodologyVersion String   @default("v1") @map("methodology_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

