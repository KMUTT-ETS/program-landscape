model ResearchOutput {
  id              String             @id @default(cuid())
  // Nullable so KKU-affiliated papers whose author can't be resolved
  // to a FacultyMember row still land for analyst triage. The
  // (openalexId, facultyMemberId) unique pair allows the same paper
  // to be linked once per matched KKU author.
  facultyMemberId String?            @map("faculty_member_id")
  year            Int
  type            ResearchOutputType
  title           String             @db.Text
  venue           String?
  citations       Int                @default(0)
