// ══════════════════════════════════════════════════════════════════════════
// Organization (university → faculty → department → program)
// ══════════════════════════════════════════════════════════════════════════

model Faculty {
  id        String      @id @default(cuid())
  code      String      @unique
  nameTh    String      @map("name_th")
  nameEn    String      @map("name_en")
  kind      FacultyKind @default(ACADEMIC)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  departments         Department[]
  programs            Program[]
  users               User[]
  userScopes          UserScope[]
  facultyMembers      FacultyMember[]
  facultySkills       FacultySkill[]
  hrOrgMappings       HrOrgMapping[]
  facultyCompensation FacultyCompensation[]
  facultyBudgets      FacultyBudget[]
  staffMasterRecords  StaffMasterRecord[]
  staffCompensationCubes StaffCompensationCube[]

  @@index([code])
  @@map("faculties")
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  nameTh    String   @map("name_th")
  nameEn    String   @map("name_en")
  facultyId String   @map("faculty_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faculty             Faculty               @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  programs            Program[]
  users               User[]
  facultyMembers      FacultyMember[]
  departmentSkills    DepartmentSkill[]
  hrOrgMappings       HrOrgMapping[]
  facultyCompensation FacultyCompensation[]

  @@index([facultyId])
  @@map("departments")
}

model Program {
  id                   String        @id @default(cuid())
  code                 String        @unique
  // Official MHESI program code (รหัสหลักสูตร อว.). NOT unique across rows
  // because the KKU master sheet has duplicates (same code occasionally
  // reused between Bachelor + Master variants of related programs — likely
  // sheet data-entry inconsistency, kept as-is for analyst reconciliation).
  // For canonical identification across the platform use `code`, which is
  // derived from sequenceNoFromSheet → guaranteed unique.
  mhesiCode            String?       @map("mhesi_code")
  // Row order from the KKU master sheet — UNIQUE per sheet row, drives
  // the canonical Program.code (KKU-SEQ-NNNN format). Source of truth for
  // sheet↔DB reconciliation.
  sequenceNoFromSheet  Int?          @unique @map("sequence_no_from_sheet")
  nameTh               String        @map("name_th")
  nameEn               String        @map("name_en")
  facultyId            String        @map("faculty_id")
  departmentId         String?       @map("department_id")
  level                ProgramLevel
  status               ProgramStatus @default(ACTIVE)
  yearEstablished      Int?          @map("year_established")
  // Marketing-ready Thai narrative for prospective students (~200-400
  // words). Generated by the program-digest.v1 AI extractor; reviewed via
  // /admin/extraction-review before materialising. English translation is
  // deferred (translate-on-demand path).
  recruitmentSummaryTh String?       @map("recruitment_summary_th") @db.Text
  recruitmentSummaryEn String?       @map("recruitment_summary_en") @db.Text

  // KKU master sheet's column E ("ชื่อสาขา") preserved verbatim ONLY when
  // it disagrees with the canonical discipline parsed from column D's
  // parens. Captures rename history ("เปลียนจาก X เป็น Y"), typos, and
  // legacy notes the analyst may want to reconcile. Empty when E matches D.
  sheetRemark String? @map("sheet_remark") @db.Text

  // มคอ.2 header fields (Section 1 "ข้อมูลทั่วไป"). Nullable because older
  // seeded rows pre-date the curriculum-doc import flow; populated when an
  // admin applies a reviewed CURRICULUM_SPEC extraction.
  degreeNameTh             String?  @map("degree_name_th")
  degreeNameEn             String?  @map("degree_name_en")
  degreeAbbrTh             String?  @map("degree_abbr_th")
  degreeAbbrEn             String?  @map("degree_abbr_en")
  majors                   String[] @default([])
  totalCredits             Int?     @map("total_credits")
  durationYears            Int?     @map("duration_years")
  programPlans             String[] @default([]) @map("program_plans")
  language                 String?
  admissionScope           String?  @map("admission_scope")
  careersThJson            Json?    @map("careers_th_json")
  /// KMITL career IDs that the program's professions map to.
  /// Mapping is produced by the career-kmitl-mapping AI script and used by
  /// the deep-dive skills section to filter labour-market demand to careers
  /// the program actually targets (instead of generic top-10 across all
  /// careers). Empty array = no mapping yet → demand uses fallback.
  kmitlCareerIds           Int[]    @default([]) @map("kmitl_career_ids")
  openingYear              Int?     @map("opening_year")
  openingSemester          Int?     @map("opening_semester")
  curriculumYearBE         Int?     @map("curriculum_year_be")
  isRevision               Boolean  @default(false) @map("is_revision")
  previousCurriculumYearBE Int?     @map("previous_curriculum_year_be")
  approvalHistoryJson      Json?    @map("approval_history_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faculty    Faculty     @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  curricula             Curriculum[]
  courses               Course[]
  programSkills         ProgramSkill[]
  programFaculties      ProgramFaculty[]
  programUsers          User[]                      @relation("ProgramUserScope")
  userScopes            UserScope[]
  enrollmentMetrics     EnrollmentMetric[]
  studentDemographics   StudentDemographic[]
  cohortDistributions   StudentCohortDistribution[]
  alumniCohortStatuses  AlumniCohortStatus[]
  tcasAdmissionStats    TcasAdmissionStat[]
  tcasAdmissionFunnels  TcasAdmissionFunnel[]
  peerSelections        ProgramPeerSelection[]
  peerReview            ProgramPeerReview?
  strategicNarrative    ProgramStrategicNarrative?
  aiReadinessAssessment ProgramAiReadinessAssessment?
  lifecycleSnapshot     ProgramLifecycleSnapshot?
  financialMetrics      FinancialMetric[]
  graduateOutcomes      GraduateOutcome[]
  employerFeedback      EmployerFeedback[]
  documents             ProgramDocument[]
  registryMappings      RegistryProgramMapping[]
  demandMatches         ProgramDemandMatch[]
  staffAssignments      StaffProgramAssignment[]
  mhesiAliases          ProgramMhesiAlias[]
  studentRecords        StudentProgramRecord[]
  riskAssessments       RiskAssessment[]
  riskIndicatorBreaches RiskIndicatorBreach[]

  @@index([facultyId])
  @@index([departmentId])
  @@index([status])
  @@index([level])
  @@map("programs")
}

model ProgramDocument {
  id               String              @id @default(cuid())
  programId        String              @map("program_id")
  pdfDocumentId    String              @map("pdf_document_id")
  role             ProgramDocumentRole
  curriculumYearBE Int?                @map("curriculum_year_be")
  isCurrent        Boolean             @default(false) @map("is_current")
  notes            String?
  attachedById     String?             @map("attached_by_id")
  attachedAt       DateTime            @default(now()) @map("attached_at")

  program     Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  pdfDocument PdfDocument @relation(fields: [pdfDocumentId], references: [id], onDelete: Cascade)
  attachedBy  User?       @relation("ProgramDocAttacher", fields: [attachedById], references: [id], onDelete: SetNull)

  @@unique([programId, pdfDocumentId])
  @@index([programId])
  @@index([pdfDocumentId])
  @@index([role])
  @@map("program_documents")
}

// ══════════════════════════════════════════════════════════════════════════
// Users, audit, AI logs
// ══════════════════════════════════════════════════════════════════════════

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  ssoSubject      String?         @unique @map("sso_subject")
  name            String?
  role            UserRole        @default(UNIVERSITY_USER)
  facultyId       String?         @map("faculty_id")
  departmentId    String?         @map("department_id")
  // Set when role = PROGRAM_USER. Academic staff default to their
  // primary program here so the deep-dive + recruitment surfaces can
  // scope-filter to "my program" without guessing.
  programId       String?         @map("program_id")
  // KKU HR cleartext employment number — captured from the SSONext
  // /auth.token employeeId claim on every login. Bridges User →
  // FacultyMember (which carries the same employeeId from kku-hr) so
  // the profile page can resolve the staffer's HR record + research
  // + curriculum without a fragile name match. Confirmed not PII
  // per KKU 2026-05-02 (distinct from ID_PEOPLE / Thai citizen ID).
  employeeId      String?         @map("employee_id")
  // Per-user dev-credentials password. NULL means the user falls back
  // to the shared DEV_AUTH_PASSWORD (default 'kku-dev'). Set during
  // pre-provisioning via /admin/users when SSO isn't yet wired and the
  // admin needs to hand a unique credential to a teammate. Format:
  // 'scrypt:<salt-hex>:<hash-hex>'. Field is dev-only; never read in
  // production code paths (KKU SSO is the only auth in prod).
  passwordHash    String?         @map("password_hash")
  // User-uploaded profile photo. `avatarStorageKey` is the MinIO
  // object key (e.g. "avatars/<userId>.jpg"); the actual bytes live
  // in the `avatars` bucket. `avatarUpdatedAt` is used for cache-
  // busting the served URL — clients append `?v=<ts>` so they pick
  // up the new image after upload without manual reload.
  avatarStorageKey String?        @map("avatar_storage_key")
  avatarUpdatedAt  DateTime?      @map("avatar_updated_at")
  themePreference ThemePreference @default(SYSTEM) @map("theme_preference")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  program    Program?    @relation("ProgramUserScope", fields: [programId], references: [id], onDelete: SetNull)

  auditLogs              AuditLog[]
  aiInferences           AiInference[]
  uploadedPdfs           PdfDocument[]         @relation("PdfUploader")
  reviewedExtractions    PdfExtraction[]       @relation("ExtractionReviewer")
  reviewedAiExtractions  AiExtraction[]        @relation("AiExtractionReviewer")
  reviewedSkillAliases   SkillAlias[]          @relation("SkillAliasReviewer")
  scenarios              Scenario[]
  councilDecisions       CouncilDecision[]
  annotations            Annotation[]
  pdfGenerations         PdfGeneration[]
  triggeredIngestionRuns IngestionRun[]        @relation("IngestionTriggeredBy")
  savedCockpitViews      SavedCockpitView[]
  notifications          Notification[]
  signalSubscriptions    SignalSubscription[]
  peerSets               PeerSet[]
  analystConversations   AnalystConversation[]
  analystFeedback        AnalystFeedback[]
  milestonesOwned        DecisionMilestone[]   @relation("MilestoneOwner")
  approvedDecisions      DecisionApprover[]    @relation("ApproverUser")
  attachedProgramDocs    ProgramDocument[]     @relation("ProgramDocAttacher")
  // Multi-scope assignments — additive to the (role, facultyId, programId)
  // single-primary columns above. A user can own multiple (role, scope)
  // tuples: e.g. FACULTY_USER for two faculties + PROGRAM_USER for three
  // programs across other faculties. Phase 1 (added 2026-05-07): admin UI
  // manages these; runtime can() still consults the primary fields above.
  // Phase 2 will rewrite can() + SessionUser to consume scopes[] directly.
  scopes                 UserScope[]
  expertiseNarratives    UserExpertiseNarrative[]
  publicationsCache      UserPublicationsCache?

  @@index([email])
  @@index([ssoSubject])
  @@index([role])
  @@index([employeeId], map: "users_employee_id_idx")
  @@map("users")
}

// AI-synthesised expertise summary for the user's profile page.
// Computed from education + publication titles via the
// `expertise-narrative.<v>` prompt; one row per (user × method
// version). Persisted so subsequent profile views serve from cache
// instead of re-running the LLM call.
//
// Methodology version is part of the unique key so a prompt-template
// upgrade (v2 → v3) writes a NEW row alongside the older one — old
// users keep seeing v2 until their page next refreshes, then the new
// row materialises and shadows the old.
model UserExpertiseNarrative {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  methodVersion       String   @map("method_version")
  narrativeTh         String   @map("narrative_th") @db.Text
  narrativeEn         String   @map("narrative_en") @db.Text
  expertiseKeywordsTh String[] @map("expertise_keywords_th")
  expertiseKeywordsEn String[] @map("expertise_keywords_en")
  confidence          Float
  // Loose link to the AiInference row that produced this narrative —
  // useful for the audit trail and for cost-rollup dashboards.
  aiInferenceId       String?  @map("ai_inference_id")
  generatedAt         DateTime @default(now()) @map("generated_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, methodVersion])
  @@index([userId])
  @@map("user_expertise_narratives")
}

// Local cache of kkuscholar publication lookups, keyed by user.
//
// The kku-publications mirror at 10.130.2.151 is on KKU's internal
// network and a profile-page query against `scopus_document_with_authors`
// + ISI/TCI/PubMed authors costs ~3-8s per page load. We cache the
// fetched payload here so subsequent loads serve from local Postgres
// in ~50ms.
//
// `payloadJson` carries the deserialised KkuScholarPublication[]
// returned by `fetchKkuScholarPublicationsByPerson()`. The shape
// includes paper metadata + full author lists.
//
// Refresh policy (stale-while-revalidate):
//   - If `fetchedAt` is older than CACHE_TTL_MS, the page renders
//     immediately from the stale cache AND fires a fire-and-forget
//     background refresh.
//   - First-ever load (no row) blocks on the live fetch, then writes
//     a row.
model UserPublicationsCache {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  payloadJson   Json     @map("payload_json")
  paperCount    Int      @map("paper_count")
  fetchedAt     DateTime @default(now()) @map("fetched_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_publications_cache")
}

// Multi-scope assignments per user. Each row = one (role, scope) tuple.
// Non-spatial roles (SUPER_ADMIN, SYSTEM_ADMIN, UNIVERSITY_USER) carry
// facultyId=null + programId=null (one row total per user). Spatial roles:
//   - FACULTY_USER: facultyId required, programId=null
//   - PROGRAM_USER: programId required (facultyId derivable from program)
// Unique on (userId, role, facultyId, programId) prevents duplicate
// assignments. ON DELETE CASCADE on user means scopes evaporate when a
// user is deleted; SET NULL on faculty/program preserves audit while a
// faculty/program row is being moved.
model UserScope {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  role      UserRole
  facultyId String?         @map("faculty_id")
  programId String?         @map("program_id")
  source    UserScopeSource @default(MANUAL)
  createdAt DateTime        @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([userId, role, facultyId, programId], map: "user_scopes_unique")
  @@index([userId], map: "user_scopes_user_idx")
  @@index([facultyId], map: "user_scopes_faculty_idx")
  @@index([programId], map: "user_scopes_program_idx")
  @@index([source], map: "user_scopes_source_idx")
  @@map("user_scopes")
}

// MANUAL — set by an admin via /admin/users. Survives SSO logins.
// ACADEMIC_STAFF — auto-synced from FacultyMember ↔ ProgramFaculty on
// every SSO login. Pruned when the staffer is removed from a program
// upstream. Never touched by manual admin edits.
enum UserScopeSource {
  MANUAL
  ACADEMIC_STAFF
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  payloadJson Json?    @map("payload_json")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  // Composite for the sign-in lockout hot path
  // (where: { userId, action: 'auth.signin.fail', createdAt: { gte } }).
  // Migration: 20260509120000_perf_composite_indexes.
  @@index([userId, action, createdAt])
  @@map("audit_logs")
}

model AiInference {
  id              String   @id @default(cuid())
  userId          String?  @map("user_id")
  module          String
  // Free-text call kind (e.g. 'course-skills.extract', 'policy-doc.summary',
  // 'embedding', 'translation'). Used for rollup dashboards.
  kind            String?
  prompt          String   @db.Text
  promptVersion   String?  @map("prompt_version")
  model           String
  response        String   @db.Text
  confidence      Float?
  sourcesJson     Json?    @map("sources_json")
  tokensInput     Int?     @map("tokens_input")
  tokensOutput    Int?     @map("tokens_output")
  latencyMs       Int?     @map("latency_ms")
  // Per-call cost estimate in USD. Computed by the provider from token
  // counts × per-model pricing. Admin dashboard rolls this up.
  costEstimateUsd Float?   @map("cost_estimate_usd")
  createdAt       DateTime @default(now()) @map("created_at")

  user                       User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  trendSignals               TrendSignal[]
  scenarioResults            ScenarioResult[]
  scenarioRuns               ScenarioRun[]
  aiExtractions              AiExtraction[]
  annotations                Annotation[]
  outcomeReviews             DecisionOutcomeReview[]     @relation("OutcomeReviewAi")
  skillAliases               SkillAlias[]
  externalCareerSkillDemands ExternalCareerSkillDemand[]
  programDemandMatches       ProgramDemandMatch[]

  @@index([userId])
  @@index([module])
  @@index([kind])
  @@index([createdAt])
  // Composite for the AiQuotaGuard hot path
  // (where: { userId, createdAt: { gte } }). Migration:
  // 20260509120000_perf_composite_indexes.
  @@index([userId, createdAt])
  @@map("ai_inferences")
}

// Structured output produced by an AiService extractStructured() call.
// Parallel to PdfExtraction — that table handles PDF-sourced extractions,
// this one handles everything else (course descriptions typed into admin
// forms, job-posting JSON from connectors, policy doc narrative tagging
// that chains off a PdfExtraction). The review UI at
// /admin/extraction-review reads from BOTH tables.
//
// Lifecycle:
//   1. AI job writes a row with reviewStatus = PENDING_REVIEW (or
//      AUTO_APPROVED when confidence clears the threshold).
//   2. If PENDING_REVIEW, an analyst approves/rejects/edits in the admin UI.
//   3. On APPROVED, a post-approval handler materialises the payload into
//      the real domain table (CourseSkill / JobPostingSkill / etc.).
model AiExtraction {
  id               String       @id @default(cuid())
  // Source anchor — one of 'course', 'job_posting', 'policy_document',
  // 'curriculum', … Keyed as text so new kinds land without enum churn.
  sourceEntityType String       @map("source_entity_type")
  sourceEntityId   String       @map("source_entity_id")
  // Which extraction this row represents — 'COURSE_SKILLS',
  // 'JOB_POSTING_SKILLS', 'POLICY_DOC_ANALYSIS', etc. Maps 1:1 to a
  // prompt template in @kku/shared/ai/prompts.
  extractionKind   String       @map("extraction_kind")
  payloadJson      Json         @map("payload_json")
  confidence       Float
  methodVersion    String       @map("method_version")
  aiInferenceId    String?      @map("ai_inference_id")
  reviewStatus     ReviewStatus @default(PENDING_REVIEW) @map("review_status")
  reviewedByUserId String?      @map("reviewed_by_user_id")
  reviewedAt       DateTime?    @map("reviewed_at")
  reviewNotes      String?      @map("review_notes") @db.Text
  reasoning        String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  aiInference AiInference? @relation(fields: [aiInferenceId], references: [id], onDelete: SetNull)
  reviewedBy  User?        @relation("AiExtractionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([sourceEntityType, sourceEntityId])
  @@index([extractionKind])
  @@index([reviewStatus])
  @@map("ai_extractions")
}

