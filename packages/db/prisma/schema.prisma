// ══════════════════════════════════════════════════════════════════════════
// Skills
// ══════════════════════════════════════════════════════════════════════════

model Skill {
  id             String                       @id @default(cuid())
  code           String                       @unique
  nameTh         String                       @map("name_th")
  nameEn         String                       @map("name_en")
  taxonomySource SkillTaxonomy                @map("taxonomy_source")
  category       String?
  parentSkillId  String?                      @map("parent_skill_id")
  embedding      Unsupported("vector(1536)")?
  // Automation risk tier for the Risk Management module's L2 driver
  // (AI-disruption likelihood). Heuristically seeded by name/category;
  // refined by the per-skill AI sweep in the risk pipeline.
  automationRisk AutomationRisk               @default(UNKNOWN) @map("automation_risk")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  parent                  Skill?                      @relation("SkillHierarchy", fields: [parentSkillId], references: [id], onDelete: SetNull)
  children                Skill[]                     @relation("SkillHierarchy")
  courseSkills            CourseSkill[]
  programSkills           ProgramSkill[]
  departmentSkills        DepartmentSkill[]
  facultySkills           FacultySkill[]
  jobPostingSkills        JobPostingSkill[]
  skillSectors            SkillSector[]
  peerProgramSkills       PeerProgramSkill[]
  kmitlCareerSkillDemands KmitlCareerSkillDemand[]
  kmitlSkillGrowths       KmitlSkillGrowth[]
  externalCareerDemands   ExternalCareerSkillDemand[]
  aliases                 SkillAlias[]
  programDemandMatches    ProgramDemandMatch[]

