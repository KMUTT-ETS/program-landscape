// ═════════════════════════════════════════════════════════════════════════════
// SkillAlias — caches every normalization decision for free-text skill names
// encountered by connectors and AI extractors.
//
// Why: external sources (LinkedIn via MHESI/KMITL, JobThai, program-digest
// AI extractor) emit skill names with arbitrary surface forms — "SEO" /
// "Search Engine Optimization", "ML" / "Machine Learning", "การตลาดดิจิทัล" /
// "Digital marketing". Naive case-insensitive exact match resolves <5% of
// LinkedIn rows. The AI normaliser maps each unique raw name to either an
// existing Skill, a NEW_PROPOSED Skill (queued for analyst review), or
// AMBIGUOUS (when the LLM can't decide). Decisions are cached here so
// subsequent syncs hit the cache instead of re-LLM-ing the same name.
//
// Lookup contract: `(rawNameLower, sourceContext)` is the natural key.
// Different sources may have different normalization conventions — an
// analyst override for `linkedin` shouldn't auto-affect `program_digest`.
// ═════════════════════════════════════════════════════════════════════════════

enum SkillAliasStatus {
  PENDING // queued for normalization, no decision yet
  RESOLVED // matched to existing Skill (skillId set)
  NEW_PROPOSED // AI suggests a new Skill should be created (newNameEn/Th set)
  AMBIGUOUS // AI couldn't decide; needs human review
  REJECTED // analyst rejected the AI's mapping
}

// ═════════════════════════════════════════════════════════════════════════════
// ExternalCareerSkillDemand — labour-market demand for a career label that
// KMITL's career taxonomy doesn't cover. Filled by Gemini grounded search
// (Google Search retrieval) so the deep-dive can show demanded skills for
// professions like "ผู้ประกอบการนวัตกรรม" or "อาจารย์มหาวิทยาลัย" that aren't
// in the KMITL taxonomy.
//
// Cached per (careerLabel, region) so subsequent program lookups hit the
// cache instead of re-running the grounded call. Refresh by deleting rows
// older than freshnessDate threshold (90 days default).
// ═════════════════════════════════════════════════════════════════════════════

model ExternalCareerSkillDemand {
  id               String   @id @default(cuid())
  /// Free-text career label (mostly Thai, e.g., "นักวิจัยหุ่นยนต์").
  /// Looked up case-insensitively against `careerLabelLower`.
  careerLabel      String   @map("career_label")
  careerLabelLower String   @map("career_label_lower")
  region           String   @default("Thailand")
  /// Resolved Skill.id when the surface name matched our taxonomy.
  /// NULL for unmatched names — surfaced as raw text in the UI with a
  /// "external — unmapped" tone.
  skillId          String?  @map("skill_id")
  skillNameRaw     String   @map("skill_name_raw")
  /// Rank from the AI; 1 = top demand. Lower-bounded at 1.
  rank             Int
  /// Web-source citations from grounded retrieval. Array of
  /// {uri, title} objects.
  webSourcesJson   Json?    @map("web_sources_json")
  /// AI's reasoning for picking this skill — short, surfaced in tooltip.
  reasoning        String?  @db.Text
  source           String   @default("gemini-grounded")
  methodVersion    String   @default("career-external-skills.v1") @map("method_version")
  aiInferenceId    String?  @map("ai_inference_id")
  freshnessDate    DateTime @default(now()) @map("freshness_date")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  skill       Skill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)
  aiInference AiInference? @relation(fields: [aiInferenceId], references: [id], onDelete: SetNull)

  @@unique([careerLabelLower, region, skillNameRaw])
  @@index([careerLabelLower, region])
  @@index([skillId])
  @@map("external_career_skill_demands")
}

// ═════════════════════════════════════════════════════════════════════════════
// ProgramDemandMatch — for each demanded skill (from labour-market data),
// records whether the curriculum actually teaches it (verbatim or
// semantically) per a one-shot AI pass over the program's PLOs +
// course descriptions.
//
// The taught-vs-demanded view is now demand-driven: instead of relying on
// our extracted ProgramSkill rows happening to share a skill_id with
// the demanded set (often false for synonym-different surface forms),
// we ask the AI directly: "is this demanded skill found in this program's
// PLOs or course descriptions?" If yes, we surface evidence.
// ═════════════════════════════════════════════════════════════════════════════

model ProgramDemandMatch {
  id                   String   @id @default(cuid())
  programId            String   @map("program_id")
  /// The demanded skill (resolved Skill row) being checked.
  skillId              String   @map("skill_id")
  /// True when the AI found verbatim or related text in the program's
  /// PLOs / course descriptions / extracted skills with evidence.
  matched              Boolean  @default(false)
  /// True when the demanded skill is plausibly relevant to a graduate
  /// of THIS discipline + their target careers, regardless of whether
  /// the curriculum currently teaches it. Drives the gap filter:
  /// gaps = matched=false AND relevant=true. Skills that are demanded
  /// in some career taxonomy but NOT relevant to this program's
  /// discipline (e.g., "Civil engineering" or "Digital marketing" for
  /// a Mech Eng program) are suppressed from the gap list.
  relevant             Boolean  @default(true)
  /// 0..1 — how strongly the demanded skill maps to the program content.
  /// 1.0 = explicit verbatim match in a PLO, 0.6 = covered by course
  /// descriptions, 0.3 = only weakly related (e.g., adjacent topic).
  relatedness          Float
  /// Where the match was found: 'plo' | 'course' | 'extracted-skill' | 'unmatched'.
  matchSource          String   @map("match_source")
  /// Verbatim Thai/English quote from the matched location.
  evidenceQuote        String?  @map("evidence_quote") @db.Text
  /// FK back to the closest existing ProgramSkill row (when match found
  /// via the extracted-skill route).
  matchedTaughtSkillId String?  @map("matched_taught_skill_id")
  methodVersion        String   @default("demand-match.v1") @map("method_version")
  aiInferenceId        String?  @map("ai_inference_id")
  computedAt           DateTime @default(now()) @map("computed_at")
  ingestionRunId       String?  @map("ingestion_run_id")

  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  skill        Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  aiInference  AiInference?  @relation(fields: [aiInferenceId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([programId, skillId])
  @@index([programId])
  @@index([skillId])
  @@index([ingestionRunId])
  @@map("program_demand_matches")
}

model SkillAlias {
  id               String           @id @default(cuid())
  rawName          String           @map("raw_name")
  rawNameLower     String           @map("raw_name_lower")
  // Free-text discriminator: 'linkedin' (KMITL/MHESI feed),
  // 'program_digest', 'job_posting', 'manual', 'course_skill'. Keyed as
  // text so new sources land without enum churn.
  sourceContext    String           @map("source_context")
  status           SkillAliasStatus @default(PENDING)
  resolvedSkillId  String?          @map("resolved_skill_id")
  // When status=NEW_PROPOSED, holds the AI-suggested canonical name for
  // the new Skill row. Nulled out once an analyst either approves (a new
  // Skill row is created and resolvedSkillId points at it) or rejects.
  newNameEn        String?          @map("new_name_en")
  newNameTh        String?          @map("new_name_th")
  newCategory      String?          @map("new_category")
  // 0..1 — AI's reported confidence in the decision.
  confidence       Float?
  // Resolution method: 'exact_match' (direct lookup pre-AI),
  // 'ai_normaliser', 'manual', 'embedding_cosine' (future).
  method           String           @default("ai_normaliser")
  // AI's one-line explanation. Surfaced in the analyst review UI.
  reasoning        String?          @db.Text
  // Methodology version of the AI prompt used. Bumps invalidate cache —
  // the backfill script re-processes rows whose method version is older.
  methodVersion    String           @default("skill-name-normaliser.v1") @map("method_version")
  // When the AI emitted this row.
  aiInferenceId    String?          @map("ai_inference_id")
  reviewedByUserId String?          @map("reviewed_by_user_id")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewNotes      String?          @map("review_notes") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  resolvedSkill Skill?       @relation(fields: [resolvedSkillId], references: [id], onDelete: SetNull)
  aiInference   AiInference? @relation(fields: [aiInferenceId], references: [id], onDelete: SetNull)
  reviewedBy    User?        @relation("SkillAliasReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([rawNameLower, sourceContext])
  @@index([resolvedSkillId])
  @@index([status])
  @@index([sourceContext, status])
  @@map("skill_aliases")
}

model CourseSkill {
  id         String      @id @default(cuid())
  courseId   String      @map("course_id")
  skillId    String      @map("skill_id")
  weight     Float       @default(1.0)
  source     SkillSource @default(MANUAL)
  confidence Float?
  createdAt  DateTime    @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
  @@index([courseId])
  @@index([skillId])
  @@map("course_skills")
}

// Denormalized rollups — regenerated by ingestion jobs (prompt 04) whenever
// the underlying CourseSkill weights or curriculum membership changes.
model ProgramSkill {
  id               String   @id @default(cuid())
  programId        String   @map("program_id")
  skillId          String   @map("skill_id")
  /// Composite weight: max(compulsoryWeight, electiveWeight*0.5).
  /// Kept for backwards compatibility — new code should read the
  /// separate compulsoryWeight/electiveWeight fields.
  weight           Float
  /// Contribution from compulsory courses + PLOs. 0 = none, 1 = backbone.
  /// Major contribution typically lives here.
  compulsoryWeight Float?   @map("compulsory_weight")
  /// Contribution from elective courses. Minor by definition — students
  /// may or may not take electives that build this skill.
  electiveWeight   Float?   @map("elective_weight")
  /// True when this skill explicitly appears in a Program Learning
  /// Outcome (PLO) — the strongest signal that the program intends to
  /// build it as an outcome, regardless of which course teaches it.
  pickedFromPlo    Boolean  @default(false) @map("picked_from_plo")
  /// Verbatim quote from PLOs / course description that justifies the
  /// mapping. Used in the deep-dive review UI.
  evidenceQuote    String?  @map("evidence_quote") @db.Text
  computedAt       DateTime @default(now()) @map("computed_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([programId, skillId])
  @@index([programId])
  @@index([skillId])
  @@map("program_skills")
}

model DepartmentSkill {
  id           String   @id @default(cuid())
  departmentId String   @map("department_id")
  skillId      String   @map("skill_id")
  weight       Float
  computedAt   DateTime @default(now()) @map("computed_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([departmentId, skillId])
  @@index([departmentId])
  @@index([skillId])
  @@map("department_skills")
}

model FacultySkill {
  id         String   @id @default(cuid())
  facultyId  String   @map("faculty_id")
  skillId    String   @map("skill_id")
  weight     Float
  computedAt DateTime @default(now()) @map("computed_at")

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([facultyId, skillId])
  @@index([facultyId])
  @@index([skillId])
  @@map("faculty_skills")
}

// ══════════════════════════════════════════════════════════════════════════
// People
// ══════════════════════════════════════════════════════════════════════════

model FacultyMember {
  id                    String      @id @default(cuid())
  facultyId             String      @map("faculty_id")
  departmentId          String?     @map("department_id")
  employeeCode          String      @unique @map("employee_code")
  // Un-hashed HR-internal employment number (HCMEmployee.EMPLOYEEID).
  // Confirmed not PII per KKU 2026-05-02 — distinct from ID_PEOPLE
  // (Thai citizen ID, which IS PII and stays hashed). Surfaced in the
  // admin raw-data viewer so analysts can cross-reference with HCM.
  employeeId            String?     @map("employee_id")
  nameTh                String      @map("name_th")
  nameEn                String      @map("name_en")
  rank                  FacultyRank
  academicQualification String?     @map("academic_qualification")
  specialization        String?
  dateOfBirth           DateTime?   @map("date_of_birth") @db.Date
  hireDate              DateTime?   @map("hire_date") @db.Date
  /// Scheduled mandatory retirement date. KKU civil-service rule:
  /// 1 Oct AFTER the staff member turns 60. Computed from dateOfBirth
  /// by the kku-hr connector (was previously sourced from RESIGNDATE
  /// which is only filled post-resignation → null for active staff).
  retirementDate        DateTime?   @map("retirement_date") @db.Date
  /// Actual employment end date (HCMEmployee.ENDWORKDATE). Blank for
  /// current staff. Non-null = pre-retirement separation (resignation,
  /// contract end, dismissal, death). Drives turnover-rate analytics
  /// on /staff/workforce.
  endEmploymentDate     DateTime?   @map("end_employment_date") @db.Date
  isActive              Boolean     @default(true) @map("is_active")
  // Cross-system author identifiers — populated by the kku-research
  // connector as papers land. ORCID is the gold standard; OpenAlex
  // and Scopus author IDs are source-specific stable keys.
  orcid                 String?     @unique
  openalexAuthorId      String?     @unique @map("openalex_author_id")
  scopusAuthorId        String?     @unique @map("scopus_author_id")
  // Cross-system identity key — SHA-256 of digit-stripped Thai citizen ID
  // (or alphanumeric-stripped passport for foreign staff). Computed via
  // hashCitizenId() in @kku/shared. Populated lazily as connectors
  // observe a matching person across DS2003 / DS2004 / processed-HR.
  citizenIdHash         String?     @unique @map("citizen_id_hash")
  /// KKU work email (HCMEmployee.EMAIL, lowercased). Populated by the
  /// kku-hr connector. The KKUMAIL field on the registrar's class-offering
  /// view (POWERBI.VIEW_CLASS_OPEN_GROUP_OFFICER) is a comma-separated
  /// list of these emails — that's how a class section is linked back to
  /// its teaching staff for the teaching-workload dashboard.
  kkuEmail              String?     @unique @map("kku_email")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  faculty               Faculty                     @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department            Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  programFaculties      ProgramFaculty[]
  researchOutputs       ResearchOutput[]
  classOfferingTeachers ClassOfferingTeacher[]
  evaluationResponses   EvaluationResponseSummary[]

  @@index([facultyId])
  @@index([departmentId])
  @@index([isActive])
  @@map("faculty_members")
}

model ProgramFaculty {
  id              String             @id @default(cuid())
  facultyMemberId String             @map("faculty_member_id")
  programId       String             @map("program_id")
  role            ProgramFacultyRole @default(CORE)
  createdAt       DateTime           @default(now()) @map("created_at")

  facultyMember FacultyMember @relation(fields: [facultyMemberId], references: [id], onDelete: Cascade)
  program       Program       @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([facultyMemberId, programId])
  @@index([facultyMemberId])
  @@index([programId])
  @@map("program_faculties")
}

