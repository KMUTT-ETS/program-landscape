/// TCAS admission statistics — published annually by mytcas.com (CUPT).
/// One row per (TCAS course code × entry year BE × round). National-wide
/// dataset; KKU rows resolve to `programId`, peer rows leave it null and
/// are kept for cross-institution benchmarking.
model TcasAdmissionStat {
  id                 String   @id @default(cuid())
  /// Optional FK to KKU's Program when the TCAS row matched on
  /// (faculty.nameTh, programme.nameTh) exact-string. Null for peer
  /// institutions and KKU rows we couldn't auto-match.
  programId          String?  @map("program_id")
  /// 15-character TCAS course identifier — stable across years.
  tcasCourseCode     String   @map("tcas_course_code")
  institutionName    String   @map("institution_name")
  campusName         String?  @map("campus_name")
  facultyName        String?  @map("faculty_name")
  programmeName      String   @map("programme_name")
  majorName          String?  @map("major_name")
  /// Entry year in Buddhist Era (TCAS68 = BE 2568 = CE 2025 cohort).
  entryYearBE        Int      @map("entry_year_be")
  /// TCAS3 sub-round: '3.1' (initial pass) / '3.2' (clearing) /
  /// '3' (older years that didn't split). Future rounds (1, 2, 4)
  /// land in the same table when those connectors flip real.
  round              String
  /// Per-row metrics from the published xlsx.
  quota              Int
  applicants         Int
  admittedPass1      Int      @map("admitted_pass1")
  admittedPass2      Int      @map("admitted_pass2")
  maxScorePass1      Float?   @map("max_score_pass1")
  minScorePass1      Float?   @map("min_score_pass1")
  maxScorePass2      Float?   @map("max_score_pass2")
  minScorePass2      Float?   @map("min_score_pass2")
  sourceUrl          String   @map("source_url")
  methodologyVersion String   @default("tcas-stat.v1") @map("methodology_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  ingestionRunId     String?  @map("ingestion_run_id")

  program      Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([tcasCourseCode, entryYearBE, round])
  @@index([programId])
  @@index([entryYearBE, round])
  @@index([institutionName])
  @@index([facultyName])
  @@index([ingestionRunId])
  @@map("tcas_admission_stats")
}

/// Bucketed status counts per (program × entry-year cohort) pulled from
/// the Oracle `VIEW_STUDENT_DETAIL_ALUMNI` view (308k+ rows, all KKU
/// students with terminal status). Rolls up the registrar's 30+ raw
/// `STUDENTSTATUS` values into 8 funnel-relevant buckets so the demand
/// funnel can show genuine attrition without 30 distinct columns.
///
/// Refreshed by `pnpm programs:link-alumni`. Does NOT contain currently-
/// enrolled students — those live in `student_cohort_distributions`.
/// Together the two tables cover every student of every cohort.
model AlumniCohortStatus {
  id             String   @id @default(cuid())
  programId      String   @map("program_id")
  /// Entry year in Buddhist Era (e.g., 2565) — first 2 digits of STUDENTCODE.
  entryYearBE    Int      @map("entry_year_be")
  /// 8-bucket roll-up of `STUDENTSTATUS`. See alumni-status-mapping.ts.
  statusBucket   String   @map("status_bucket")
  count          Int
  refreshedAt    DateTime @default(now()) @updatedAt @map("refreshed_at")
  ingestionRunId String?  @map("ingestion_run_id")

  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([programId, entryYearBE, statusBucket])
  @@index([programId])
  @@index([entryYearBE])
  @@index([ingestionRunId])
  @@map("alumni_cohort_statuses")
}

/// Distribution of CURRENTLY ENROLLED students by their entry-year cohort.
/// Entry year is parsed from the first 2 digits of STUDENTCODE in Buddhist
/// Era (e.g., "65" → BE 2565 → CE 2022). Refreshed by
/// `pnpm programs:link-cohorts`. One row per (program × entry year).
model StudentCohortDistribution {
  id             String   @id @default(cuid())
  programId      String   @map("program_id")
  /// First 2 digits of STUDENTCODE, expressed as BE year (e.g., 65 = BE 2565).
  entryYearBE    Int      @map("entry_year_be")
  /// Count of CURRENTLY ENROLLED students whose code starts with this prefix.
  /// "Currently enrolled" = STUDENTSTATUSCODE in the active set (1x..2x range
  /// in registrar's taxonomy — see status-mapping.ts).
  studentCount   Int      @map("student_count")
  refreshedAt    DateTime @default(now()) @updatedAt @map("refreshed_at")
  ingestionRunId String?  @map("ingestion_run_id")

  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([programId, entryYearBE])
  @@index([programId])
  @@index([ingestionRunId])
  @@map("student_cohort_distributions")
}

