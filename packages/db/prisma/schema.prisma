// ══════════════════════════════════════════════════════════════════════════
// Research
// ══════════════════════════════════════════════════════════════════════════

model ResearchOutput {
  id                  String             @id @default(cuid())
  // Nullable so KKU-affiliated papers whose author can't be resolved
  // to a FacultyMember row still land for analyst triage. The
  // (openalexId, facultyMemberId) unique pair allows the same paper
  // to be linked once per matched KKU author.
  facultyMemberId     String?            @map("faculty_member_id")
  year                Int
  type                ResearchOutputType
  title               String             @db.Text
  venue               String?
  citations           Int                @default(0)
  scopusId            String?            @map("scopus_id")
  openalexId          String?            @map("openalex_id")
  // PubMed ID — populated by the kku-research connector when sourcing
  // medical / life-science papers from the kku-publications mirror.
  pmid                String?            @map("pmid")
  doi                 String?
  // The connector that wrote / last updated this row.
  source              String?
  // Scopus journal quartile (1-4) for the paper's source in its
  // publication year — the BEST (lowest-number) quartile across the
  // journal's ASJC subject areas, from kku-publications
  // `scopus_citescores` (CiteScore-based: Q1 = 75-99th percentile).
  // The nearest available metric year ≤ publication year is used when
  // the exact year is absent. Null for PubMed-sourced rows and Scopus
  // papers whose journal carries no CiteScore record.
  quartile            Int?               @map("quartile")
  // CiteScore percentile (0-99) underlying the quartile — the MAX
  // across the journal's subject areas for the chosen year (the
  // journal's strongest standing, which is what the top-10% tier keys
  // off).
  citeScorePercentile Int?               @map("cite_score_percentile")
  // True when the journal is in the CiteScore Top-10% of titles in ANY
  // of its subject areas for the chosen year (≡ max percentile ≥ 90) —
  // the finer "Tier 1" band inside Q1. Null when unrated.
  top10Percent        Boolean?           @map("top_10_percent")
  // SCImago Journal Rank (SJR) for the chosen journal/year.
  sjr                 Float?             @map("sjr")
  // Raw author display name from the source — used for analyst
  // reconciliation when facultyMemberId is null. Multiple KKU authors
  // on one paper produce multiple rows, each carrying that author's
  // display name here.
  kkuAuthorName       String?            @map("kku_author_name")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  ingestionRunId      String?            @map("ingestion_run_id")

  facultyMember FacultyMember? @relation(fields: [facultyMemberId], references: [id], onDelete: Cascade)
  ingestionRun  IngestionRun?  @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([openalexId, facultyMemberId])
  @@index([facultyMemberId])
  @@index([year])
  @@index([scopusId])
  @@index([openalexId])
  @@index([pmid])
  @@index([doi])
  @@index([ingestionRunId])
  @@index([quartile])
  @@map("research_outputs")
}

// ══════════════════════════════════════════════════════════════════════════
// External signals: labor market, policy, trends, peers, projections
