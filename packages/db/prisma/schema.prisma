model PolicyDocument {
  id                 String                       @id @default(cuid())
  source             PolicySource
  title              String                       @db.Text
  publishedDate      DateTime                     @map("published_date") @db.Date
  url                String?
  contentRaw         String?                      @map("content_raw") @db.Text
  summaryTh          String?                      @map("summary_th") @db.Text
  summaryEn          String?                      @map("summary_en") @db.Text
  embedding          Unsupported("vector(1536)")?
  relevantProgramIds String[]                     @map("relevant_program_ids")
  relevantSkillIds   String[]                     @map("relevant_skill_ids")
  sourcePdfId        String?                      @map("source_pdf_id")
  freshnessDate      DateTime                     @map("freshness_date") @db.Date
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  sourcePdf PdfDocument? @relation(fields: [sourcePdfId], references: [id], onDelete: SetNull)

  @@index([source])
