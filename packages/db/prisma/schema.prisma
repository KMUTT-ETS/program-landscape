model ResearchOutput {
  id              String             @id @default(cuid())
  // Nullable so KKU-affiliated papers whose author can't be resolved
  // to a FacultyMember row still land for analyst triage. The
  // (openalexId, facultyMemberId) unique pair allows the same paper
  // to be linked once per matched KKU author.
  facultyMemberId String?            @map("faculty_member_id")
  year            Int
  type            ResearchOutputType
  title           String             @db.Text
  venue           String?
  citations       Int                @default(0)
  scopusId        String?            @map("scopus_id")
  openalexId      String?            @map("openalex_id")
  doi             String?
  // The connector that wrote / last updated this row.
  source          String?
  // Raw author display name from the source — used for analyst
  // reconciliation when facultyMemberId is null. Multiple KKU authors
  // on one paper produce multiple rows, each carrying that author's
  // display name here.
  kkuAuthorName   String?            @map("kku_author_name")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

