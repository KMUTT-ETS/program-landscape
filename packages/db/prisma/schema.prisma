// KKU SSO role taxonomy (legacy roles removed 2026-05-09 — see
// migration 20260509100000_remove_legacy_user_roles for the data
// migration mapping):
//   SUPER_ADMIN     — full access; can promote SYSTEM_ADMINs.
//   SYSTEM_ADMIN    — admin-grade. Can assign roles up to and
//                     including SYSTEM_ADMIN, but never SUPER_ADMIN.
//   UNIVERSITY_USER — read-all at university scope.
//   FACULTY_USER    — read access scoped to user's facultyId.
//   PROGRAM_USER    — read access scoped to user's programId.
//                     Academic staff land here by default with
//                     programId set to their primary program.
enum UserRole {
  SUPER_ADMIN
  SYSTEM_ADMIN
  UNIVERSITY_USER
  FACULTY_USER
  PROGRAM_USER
}

