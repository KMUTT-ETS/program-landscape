  updatedAt     DateTime @updatedAt @map("updated_at")

  financialMetrics FinancialMetric[]

  @@index([effectiveDate])
  @@map("cost_methodologies")
}

model FinancialMetric {
  id                    String   @id @default(cuid())
  programId             String   @map("program_id")
  /// MISNAMED — despite the column name, this holds an ACADEMIC year
  /// (Jun-May), not a fiscal year (Oct-Sep). Sourced from POWERBI's
  /// ACADYEAR column (kku-finance/connector.ts) via ingestion's
  /// COHORT_YEAR_BE. One academic year's tuition straddles TWO fiscal-year
  /// billing cycles — semester 1 bills in the fiscal year the academic
  /// year starts in, semester 2 (and any summer term) bills in the next
  /// one — so the currently-running academic year only ever has semester 1
  /// collected, regardless of the calendar date. See
  /// packages/db/src/financial-year.ts for the scoring rule this implies,
  /// and EnrollmentMetric.academicYear for the CORRECTLY-named field on
  /// the same calendar. FacultyBudget.fiscalYear below shares this exact
  /// column name but is a true Oct-Sep fiscal year — the two are NOT on
  /// the same axis despite the identical name.
  fiscalYear            Int      @map("fiscal_year")
  tuitionRevenue        Decimal  @map("tuition_revenue") @db.Decimal(14, 2)
  otherRevenue          Decimal  @default(0) @map("other_revenue") @db.Decimal(14, 2)
  directCost            Decimal  @map("direct_cost") @db.Decimal(14, 2)
  allocatedFacultyCost  Decimal  @map("allocated_faculty_cost") @db.Decimal(14, 2)
  allocatedFacilityCost Decimal  @map("allocated_facility_cost") @db.Decimal(14, 2)
  allocatedOverhead     Decimal  @map("allocated_overhead") @db.Decimal(14, 2)
  netContribution       Decimal  @map("net_contribution") @db.Decimal(14, 2)
  costPerStudent        Decimal? @map("cost_per_student") @db.Decimal(14, 2)
  freshnessDate         DateTime @map("freshness_date") @db.Date
  methodologyVersion    String   @default("v1") @map("methodology_version")
  costMethodologyId     String?  @map("cost_methodology_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  ingestionRunId        String?  @map("ingestion_run_id")

  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  costMethodology CostMethodology? @relation(fields: [costMethodologyId], references: [id], onDelete: SetNull)
  ingestionRun    IngestionRun?    @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([programId, fiscalYear])
  @@index([programId])
  @@index([fiscalYear])
  @@index([freshnessDate])
  @@index([ingestionRunId])
  @@map("financial_metrics")
}

