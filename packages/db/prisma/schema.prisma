// KKU Curriculum Intelligence Platform · Program Landscape — Prisma schema
//
// Conventions (see packages/db/README.md for the full narrative):
//   - Table names: snake_case via @@map; Prisma model names camelCase.
//   - Every row carries createdAt + updatedAt (except pure link tables
//     and append-only log rows, where only createdAt makes sense).
//   - Every metric table carries freshnessDate.
//   - Every calculated metric carries methodologyVersion.
//   - Embeddings are Unsupported("vector(1536)") — written/read via
//     $queryRaw, not through Prisma Client field access.
//   - Multi-level scope (university / faculty / department / program):
//     metric rows live at the program level; rollups to higher scopes
//     are served by materialized views (see migrations/*_materialized_views).

generator client {
  provider        = "prisma-client-js"
  // Targets — `linux-musl-openssl-3.0.x` is for the alpine-based
  // api + web images; `debian-openssl-3.0.x` is for the ingestion
  // image whose runner stage switched to the Playwright base
  // (Ubuntu/glibc) in May 2026 for headless-browser support;
  // `windows` is for dev machines.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "windows"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector, pg_trgm, btree_gin, uuidOssp(map: "uuid-ossp")]
}

